/// A graphics window, over SDL2.
///
/// The shape is Turbo Pascal's Graph unit; the machinery underneath is a real
/// windowing system, and where the two disagree the window wins. `InitGraph`
/// carries a size and a title rather than a driver and a mode, because there is
/// no video card to pick, and failure raises rather than setting a result code.
///
/// The unit carries state -- the window, and what size it turned out to be --
/// which is why it lives apart from `math` for the same reason `random` does.
///
/// Every SDL declaration names the library by its Homebrew path, because a
/// foreign declaration's `in` clause takes a string literal and cannot fall
/// back to a second spelling. An SDL installed elsewhere means substituting the
/// path throughout.
unit graph;

uses math;

// ------------------------------------------------------------------ SDL --
//
// Private. Each declaration copies the C signature exactly, which is the whole
// of what keeps a foreign call honest -- see DEFECTS.md H-1.

function SDL_Init (Flags : Integer) : Integer;
    external 'SDL_Init' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_GetError () : String;
    external 'SDL_GetError' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_CreateWindow (Title : String, X : Integer, Y : Integer,
                           W : Integer, H : Integer, Flags : Integer) : Pointer;
    external 'SDL_CreateWindow' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_DestroyWindow (Win : Pointer);
    external 'SDL_DestroyWindow' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_CreateRenderer (Win : Pointer, Index : Integer, Flags : Integer) : Pointer;
    external 'SDL_CreateRenderer' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_DestroyRenderer (Ren : Pointer);
    external 'SDL_DestroyRenderer' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_SetRenderDrawColor (Ren : Pointer, R : Integer, G : Integer,
                                 B : Integer, A : Integer) : Integer;
    external 'SDL_SetRenderDrawColor' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_RenderClear (Ren : Pointer) : Integer;
    external 'SDL_RenderClear' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_RenderPresent (Ren : Pointer);
    external 'SDL_RenderPresent' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_GetWindowSize (Win : Pointer, W : Pointer, H : Pointer);
    external 'SDL_GetWindowSize' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_GetWindowTitle (Win : Pointer) : String;
    external 'SDL_GetWindowTitle' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_GetDesktopDisplayMode (Index : Integer, Mode : Pointer) : Integer;
    external 'SDL_GetDesktopDisplayMode' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_PumpEvents ();
    external 'SDL_PumpEvents' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_CreateTexture (Ren : Pointer, Format : Integer, Access : Integer,
                            W : Integer, H : Integer) : Pointer;
    external 'SDL_CreateTexture' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_DestroyTexture (Tex : Pointer);
    external 'SDL_DestroyTexture' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_UpdateTexture (Tex : Pointer, Rect : Pointer, Pixels : Pointer,
                            Pitch : Integer) : Integer;
    external 'SDL_UpdateTexture' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_RenderCopy (Ren : Pointer, Tex : Pointer, Src : Pointer, Dst : Pointer) : Integer;
    external 'SDL_RenderCopy' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_SetTextureBlendMode (Tex : Pointer, Mode : Integer) : Integer;
    external 'SDL_SetTextureBlendMode' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_SetHint (Name : String, Value : String) : Integer;
    external 'SDL_SetHint' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_SetTextureAlphaMod (Tex : Pointer, Alpha : Integer) : Integer;
    external 'SDL_SetTextureAlphaMod' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_PollEvent (E : Pointer) : Integer;
    external 'SDL_PollEvent' in '/opt/homebrew/lib/libSDL2.dylib';
function SDL_PushEvent (E : Pointer) : Integer;
    external 'SDL_PushEvent' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_StartTextInput ();
    external 'SDL_StartTextInput' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_Delay (Ms : Integer);
    external 'SDL_Delay' in '/opt/homebrew/lib/libSDL2.dylib';

/// Aims the C cell-stamper at a framebuffer.
///
/// Private to this unit. Set once per window rather than passed per stamp,
/// because a foreign call takes at most eight arguments and the stamp needs
/// all eight for its own work.
procedure StampTarget (Pixels : Pointer, W : Integer, H : Integer);
    external 'alg_stamp_target' in 'libgraphffi.dylib';

/// Stamps one glyph's cell at pixel X, Y into the stamp target.
///
/// Private to this unit, and the hot path of text mode: a full 80 by 25
/// screen is two thousand cells, and the interpreted blend loop was measured
/// at ~18ms per glyph -- half a minute per screenful. The unit still says
/// which glyph, what mode, what ink and what background; the C only blends.
/// A nil Glyph stamps a blank cell, which is how clearing is spelled.
procedure StampCell (X : Integer, Y : Integer, Glyph : Pointer,
                     GW : Integer, GH : Integer,
                     Mode : Integer, Ink : Integer, Back : Integer);
    external 'alg_stamp_cell' in 'libgraphffi.dylib';

/// Sets the magnification and quarter turn the next stamps use.
///
/// Private to this unit. State rather than parameters because a foreign call
/// takes at most eight arguments and `StampCell` already uses all eight. The
/// grid never sets it, so cells stay 1:1 and upright; a viewport sets it
/// around its own drawing and puts it back.
procedure StampStyle (Scale : Integer, Rotation : Integer);
    external 'alg_stamp_style' in 'libgraphffi.dylib';

/// Scrolls the stamp target up by DY pixel rows, filling the vacated band.
///
/// Private to this unit.
procedure ScrollTarget (DY : Integer, Fill : Integer);
    external 'alg_scroll_up' in 'libgraphffi.dylib';

/// Decodes hex text in groups of Group digits, one four-byte word per group,
/// into Out. Answers how many words were written.
///
/// Private to this unit, and its one C primitive of its own: decoding is
/// transcoding rather than logic, and the interpreter doing it a digit at a
/// time cost eight seconds per font load. A junk digit counts as zero and a
/// trailing partial group is ignored, both matching the decoding this
/// replaced.
function UnhexWords (Hex : String, Group : Integer, Out : Pointer) : Integer;
    external 'alg_unhex_words' in 'libgraphffi.dylib';

const SDL_INIT_VIDEO             := 32;
const WINDOWPOS_CENTERED         := 805240832;
const WINDOW_SHOWN               := 4;
const WINDOW_FULLSCREEN_DESKTOP  := 4097;
const PIXELFORMAT_RGB            := 370546692;   // SDL_PIXELFORMAT_RGB888: 0xRRGGBB, always positive
const PIXELFORMAT_ARGB           := 372645892;   // SDL_PIXELFORMAT_ARGB8888 -- the text grid needs alpha
const TEXTURE_STREAMING          := 1;
const BLENDMODE_BLEND            := 1;

/// The background of a cell that has none: the grid shows what is beneath it.
///
/// A named value rather than a color, because 0 is a legitimate black. Only
/// `TextBackground` accepts it; as an ink it raises.
const Transparent := -1;

/// The blink flag, added onto a TextColor as Turbo Pascal had it.
///
/// `TextColor (LightRed + Blink)` makes the ink blink at the adapter's
/// cadence. Turbo Pascal's value was 128 -- the CGA attribute byte's bit 7,
/// the same bit BASIC's COLOR 16 and up wrote -- but 128 is a legitimate
/// navy in 24-bit color, so the flag rides bit 24 instead and the spelling
/// survives unchanged.
const Blink := 16777216;

/// The line styles `SetLineStyle` takes, and the two thicknesses.
///
/// A style is a sixteen-bit pattern walked along the line, one bit to the
/// pixel, repeating: a set bit paints and a clear one skips. The four named
/// patterns are this library's own -- Turbo Pascal's exact bits were a BGI
/// detail -- and `UserBitLn` says the pattern comes from the caller instead.
const SolidLn   := 0;
const DottedLn  := 1;
const CenterLn  := 2;
const DashedLn  := 3;
const UserBitLn := 4;

const NormWidth  := 1;
const ThickWidth := 3;

/// The keys that are not characters, each as one Char of its own.
///
/// Turbo Pascal's ReadKey answered an extended key as #0 and then a scan code
/// on the next call -- a BIOS artifact, two reads per arrow. Here every key
/// is one Char: the arrows, function keys and the rest live in Unicode's
/// private-use area, so `if ReadKey () = KeyUp` reads as it should. Enter,
/// Escape, Tab and Backspace arrive as their real characters, #13 #27 #9 #8,
/// as they always did. KeyClose is the window's close button, delivered
/// through the same stream because a window is part of this machine.
const KeyUp     := #57344;
const KeyDown   := #57345;
const KeyLeft   := #57346;
const KeyRight  := #57347;
const KeyHome   := #57348;
const KeyEnd    := #57349;
const KeyPgUp   := #57350;
const KeyPgDn   := #57351;
const KeyInsert := #57352;
const KeyDelete := #57353;
const KeyF1     := #57360;
const KeyF2     := #57361;
const KeyF3     := #57362;
const KeyF4     := #57363;
const KeyF5     := #57364;
const KeyF6     := #57365;
const KeyF7     := #57366;
const KeyF8     := #57367;
const KeyF9     := #57368;
const KeyF10    := #57369;
const KeyF11    := #57370;
const KeyF12    := #57371;
const KeyClose  := #57384;

/// The sixteen colors of a CGA text screen, by their Turbo Pascal names.
///
/// Named constants over 24-bit values, so `TextColor (Yellow)` reads like
/// 1989 while being RGB underneath. Any other RGB Integer is just as welcome
/// wherever these are.
const Black        := 0;
const Blue         := 170;
const Green        := 43520;
const Cyan         := 43690;
const Red          := 11141120;
const Magenta      := 11141290;
const Brown        := 11162880;
const LightGray    := 11184810;
const DarkGray     := 5592405;
const LightBlue    := 5592575;
const LightGreen   := 5635925;
const LightCyan    := 5636095;
const LightRed     := 16733525;
const LightMagenta := 16733695;
const Yellow       := 16777045;
const White        := 16777215;

// ---------------------------------------------------------------- state --
//
// Declared above every routine that reads them, which DEF-35 makes a rule
// rather than a taste: a module-level variable is invisible to a body written
// above it.

var VideoReady   := False;
var SdlWin       := nil;
var Renderer     := nil;
var Texture      := nil;
var Pixels       := nil;
var WindowWidth  := 0;
var WindowHeight := 0;

// The current position text advances through, in pixels. Turbo Pascal called
// it the CP: OutText draws there and moves it; OutTextXY touches neither.
var CurrentX := 0;
var CurrentY := 0;

// The text grid: its own framebuffer and texture, alpha over the background,
// per DESIGN.md. The grid is LOGICAL -- 80 by 25 cells by default whatever
// the window, scaled to it by the GPU at present time -- so the same program
// paints the same screen at every window size. TextMode chooses another
// grid. The buffer is allocated lazily, on the first verb that stamps, so a
// program that never touches the grid never needs a font.
//
// The cursor is in cells, 0-based like everything else in this language; the
// colors are the grid's current ink and cell background.
var BlinkPhaseMs := 267;

// The surface stack: every Window and ViewPort made since InitGraph, the
// root grid included, composed in Order at present time. The root is the
// screen-wide Window at Order 0, created lazily by the first text verb so a
// purely graphical program never needs a font; the global text verbs are
// its methods, by delegation.
var Surfaces   := [];
var Root       := nil;
var NextSerial := 1;
var DstRect    := nil;

// The key queue: what PumpKeys has read from SDL and ReadKey has not yet
// answered. A head index rather than a shifting list, cleared when drained.
var KeyQueue      := [];
var KeyHead       := 0;
var EventScratch  := nil;
var LastPresentMs := 0;

// Which SDL keysyms are keys of ours, and which Char each answers. The
// values past a billion carry SDL's bit 30, its spelling for keys with no
// character; 13, 27, 8, 9 and 127 are Enter, Escape, Backspace, Tab and
// Delete, and 1073741912 is the keypad's Enter, folded into #13.
var SpecialSyms := [1073741906 : KeyUp,     1073741905 : KeyDown,
                    1073741904 : KeyLeft,   1073741903 : KeyRight,
                    1073741898 : KeyHome,   1073741901 : KeyEnd,
                    1073741899 : KeyPgUp,   1073741902 : KeyPgDn,
                    1073741897 : KeyInsert, 127        : KeyDelete,
                    1073741882 : KeyF1,     1073741883 : KeyF2,
                    1073741884 : KeyF3,     1073741885 : KeyF4,
                    1073741886 : KeyF5,     1073741887 : KeyF6,
                    1073741888 : KeyF7,     1073741889 : KeyF8,
                    1073741890 : KeyF9,     1073741891 : KeyF10,
                    1073741892 : KeyF11,    1073741893 : KeyF12,
                    13 : #13, 27 : #27, 8 : #8, 9 : #9, 1073741912 : #13];
var GridCols    := 80;
var GridRows    := 25;

// The intensity pairs of the CGA palette, both ways. Brown's partner is
// Yellow rather than a brighter brown, because the original adapter's brown
// was a special circuit and the bright version of that slot came out yellow.
var BrightPartner := [Black : DarkGray,   Blue    : LightBlue,
                      Green : LightGreen, Cyan    : LightCyan,
                      Red   : LightRed,   Magenta : LightMagenta,
                      Brown : Yellow,     LightGray : White];
var DimPartner    := [DarkGray  : Black,  LightBlue    : Blue,
                      LightGreen : Green, LightCyan    : Cyan,
                      LightRed  : Red,    LightMagenta : Magenta,
                      Yellow    : Brown,  White        : LightGray];

// The installed font. One map from codepoint to a Buffer of four-byte words,
// one to widths, one marking the glyphs that are pictures (emoji) rather than
// ink. A grey or picture glyph holds one word per pixel, row-major; a 1-bit
// glyph holds one word per row, the row's pixels packed as bits.
var FontLoaded   := False;
var FontGrey     := False;
var FontHeight   := 16;
var FontGlyphs   := [:];
var FontWidths   := [:];
var FontPictures := [:];

/// Starts SDL's video subsystem once, on first need.
///
/// Private to this unit. Video stays up for the life of the process; only the
/// window comes and goes.
procedure EnsureVideo ();
begin
    if VideoReady then Exit;

    if SDL_Init (SDL_INIT_VIDEO) <> 0 then
        raise 'Graph could not start: ' + SDL_GetError ();

    // The text grid is a logical surface scaled to the window; nearest-
    // neighbour scaling would decimate its antialiasing, linear keeps it.
    SDL_SetHint ('SDL_RENDER_SCALE_QUALITY', 'linear');

    VideoReady := True;
end

/// Hands the framebuffer to the window.
///
/// Private to this unit, and the one place pixels become visible: everything
/// draws into `Pixels`, and this uploads the lot and presents it.
procedure Present ();
begin
    SDL_UpdateTexture (Texture, nil, Pixels.Address, WindowWidth * 4);
    SDL_RenderClear (Renderer);
    SDL_RenderCopy (Renderer, Texture, nil, nil);

    // The stack, in Order, ties by creation. The blink phase is one clock
    // for every surface: 267ms each way by default, the language's own
    // clock [RT-012] deciding, and whoever presents sees the right phase.
    var Visible := Trunc (Clock () * 1000.0) div BlinkPhaseMs mod 2 = 0;
    var LastO   := -1000000000;
    var LastS   := -1;

    for var I := 0; I < Surfaces.Length; I := I + 1 do
    begin
        var Pick := nil;

        for var S in Surfaces do
        begin
            if S.Order > LastO or (S.Order = LastO and S.Serial > LastS) then
              if Pick = nil then Pick := S;
              else if S.Order < Pick.Order
                   or (S.Order = Pick.Order and S.Serial < Pick.Serial) then
                  Pick := S;
        end

        if Pick <> nil then
        begin
            Pick.Blit (Visible);

            LastO := Pick.Order;
            LastS := Pick.Serial;
        end
    end

    SDL_RenderPresent (Renderer);
    SDL_PumpEvents ();

    LastPresentMs := Trunc (Clock () * 1000.0);
end

/// The bright partner of a palette color, or the color itself.
///
/// Private to this unit; a function rather than a bare map read because a
/// map answers Any, and a written-type field refuses Any [VAL-001] -- a
/// declared return type is the laundering the checker accepts.
function BrightOf (C : Integer) : Integer;
begin
    if C in BrightPartner then Exit BrightPartner[C];

    Exit C;
end

/// The dim partner of a palette color, or the color itself.
///
/// Private to this unit, on BrightOf's reasoning.
function DimOf (C : Integer) : Integer;
begin
    if C in DimPartner then Exit DimPartner[C];

    Exit C;
end

/// The width of Code's glyph, or a blank half-cell for one the font lacks.
///
/// Private to this unit, typed for the same reason as BrightOf.
function GlyphWidthOf (Code : Integer) : Integer;
begin
    if Code in FontWidths then Exit FontWidths[Code];

    Exit FontHeight div 2;
end

/// The value of one hex digit; anything else is zero.
///
/// Private to this unit.
function HexDigit (C : Char) : Integer;
begin
    if C >= '0' then if C <= '9' then Exit Ord (C) - Ord ('0');
    if C >= 'A' then if C <= 'F' then Exit Ord (C) - Ord ('A') + 10;
    if C >= 'a' then if C <= 'f' then Exit Ord (C) - Ord ('a') + 10;

    Exit 0;
end

/// Count hex digits of Text starting at At, as one number.
///
/// Private to this unit; only the font header's cell height is read this
/// way now, the glyph rows going through `UnhexWords`.
function HexAt (Text : String, At : Integer, Count : Integer) : Integer;
begin
    var Value := 0;

    for var I := 0; I < Count; I := I + 1 do
        Value := Value * 16 + HexDigit (Text[At + I]);

    Exit Value;
end

/// Installs the glyph file at Path as the font all text draws with.
///
/// The format is the example font's, one glyph per line as `codepoint`, a
/// separator, and hex rows. A `:` separator carries ink -- one bit per pixel,
/// or one byte of coverage when the file opens with a `# gray8` header -- and
/// a `+` separator carries a picture, RRGGBBAA per pixel, which is how emoji
/// arrive in their own colors. Width is the length of the row data, so a CJK
/// glyph is simply twice as wide as a Latin one.
///
/// The library ships two: `graphfont.hex`, antialiased with emoji, installed
/// by default the first time text draws; and `romfont.hex`, one bit per pixel,
/// which is what a 1980s character ROM held. Either resolves against the
/// working directory, as any data file does. A new font replaces the old one
/// entirely; a font that cannot be opened leaves the old one installed.
///
/// # Raises
/// `InstallUserFont: cannot open '...'.` when there is no file to read.
///
/// # Examples
/// `InstallUserFont Selects Another Glyph File`
procedure InstallUserFont (Path : String);
begin
    var F := TextFile ();

    F.Assign (Path);

    try
        F.Reset ();
    except
        raise 'InstallUserFont: cannot open ''' + Path + '''.';
    end

    FontGlyphs   := [:];
    FontWidths   := [:];
    FontPictures := [:];
    FontGrey     := False;
    FontHeight   := 16;

    while not F.Eof do
    begin
        var Line := F.ReadLn ();

        // The separator IS the format: ':' is ink, '+' is a picture.
        var Sep     := Pos (Line, ':');
        var Painted := False;

        if Sep < 0 then
        begin
            Sep := Pos (Line, '+');
            if Sep >= 0 then Painted := True;
        end

        // '# gray8 32' -- the header a grey font opens with, and the only
        // line in either format that is not a glyph.
        if Length (Line) > 0 then
          if Line[0] = '#' then
          begin
              FontGrey   := True;
              FontHeight := 0;

              var I := Pos (Line, '8') + 1;
              while I < Length (Line) do
              begin
                  if Line[I] >= '0' then
                    if Line[I] <= '9' then
                        FontHeight := FontHeight * 10 + Ord (Line[I]) - Ord ('0');
                  I := I + 1;
              end
          end

        if Sep >= 0 then
        begin
            var Code := HexAt (Line, 0, Sep);
            var Bits := Copy (Line, Sep + 1, Length (Line) - Sep - 1);

            // One decoder call per glyph. The group size is the format:
            // eight digits to a picture pixel, two to a grey one, and a whole
            // row at once for 1-bit ink.
            var Group := 2;

            if Painted then Group := 8;
            if not Painted then if not FontGrey then Group := Length (Bits) div FontHeight;

            var Words := Buffer ((Length (Bits) div Group) * 4);

            UnhexWords (Bits, Group, Words.Address);

            if Painted then
            begin
                FontWidths[Code]   := Length (Bits) div 8 div FontHeight;
                FontPictures[Code] := True;
            end
            else if FontGrey then
                FontWidths[Code] := Length (Bits) div 2 div FontHeight;
            else
                FontWidths[Code] := (Length (Bits) div FontHeight) * 4;

            FontGlyphs[Code] := Words;
        end
    end

    F.Close ();

    FontLoaded := True;

    // A new font means a new cell size, so every live Window rebuilds its
    // buffers -- empty, at the same columns and rows. ViewPorts are pixels
    // and unaffected.
    if SdlWin <> nil then
        for var S in Surfaces do
            if S is Window then S.Rebuild ();
end

/// Loads the default font the first time text draws.
///
/// Private to this unit.
procedure EnsureFont ();
begin
    if FontLoaded then Exit;

    try
        InstallUserFont ('graphfont.hex');
    except
        raise 'No font is installed: ''graphfont.hex'' is not in the working '
            + 'directory, and InstallUserFont has not named another.';
    end
end

/// Mixes Ink into the ground at a coverage of 0 .. 255, channel by channel.
///
/// Private to this unit, and the whole difference between text that looks
/// drawn and text that looks thresholded: a stem falling between two pixels
/// lands on both, each at the weight it actually covers.
function Mix (Ground : Integer, Ink : Integer, Cover : Integer) : Integer;
begin
    if Cover >= 255 then Exit Ink;
    if Cover <= 0   then Exit Ground;

    var GR := Ground div 65536;
    var GG := Ground div 256 mod 256;
    var GB := Ground mod 256;

    var IR := Ink div 65536;
    var IG := Ink div 256 mod 256;
    var IB := Ink mod 256;

    var R := GR + (IR - GR) * Cover div 255;
    var G := GG + (IG - GG) * Cover div 255;
    var B := GB + (IB - GB) * Cover div 255;

    Exit R * 65536 + G * 256 + B;
end

/// Blends one pixel into the background framebuffer, clipped at its edge.
///
/// Private to this unit; the surfaces have their own buffers and reach them
/// through `StampCell` and `PutPixel`.
procedure Wash (X : Integer, Y : Integer, Ink : Integer, Cover : Integer);
begin
    if X >= 1 then
      if Y >= 1 then
        if X <= WindowWidth then
          if Y <= WindowHeight then
          begin
              var At := ((Y - 1) * WindowWidth + (X - 1)) * 4;

              Pixels.PutInt (At, Mix (Pixels.GetInt (At), Ink, Cover));
          end
end

/// Draws one glyph and answers how far to advance.
///
/// Private to this unit. A codepoint the font does not carry advances half the
/// font's height -- a blank of about one narrow cell -- rather than raising,
/// so a text with one exotic character still lands.
function DrawGlyph (Code : Integer, X : Integer, Y : Integer, Ink : Integer) : Integer;
begin
    if not (Code in FontGlyphs) then Exit FontHeight div 2;

    var Words := FontGlyphs[Code];
    var Wide  := FontWidths[Code];

    for var R := 0; R < FontHeight; R := R + 1 do
    begin
        for var C := 0; C < Wide; C := C + 1 do
        begin
            if Code in FontPictures then
            begin
                // RRGGBBAA: the pixel brings its own color, and only the
                // alpha decides how much of it lands. GetInt reads the word
                // signed, so a pixel past the sign bit comes back negative
                // and its bit pattern is restored by adding 2^32.
                var Pixel := Words.GetInt ((R * Wide + C) * 4);

                if Pixel < 0 then Pixel := Pixel + 4294967296;

                var Alpha := Pixel mod 256;

                if Alpha > 0 then Wash (X + C, Y + R, Pixel div 256, Alpha);
            end
            else if FontGrey then
            begin
                var Cover := Words.GetInt ((R * Wide + C) * 4);

                if Cover > 0 then Wash (X + C, Y + R, Ink, Cover);
            end
            else
            begin
                // One word per row, the pixels packed as bits; the high bit
                // is the leftmost pixel. No shift operator, so the bit is
                // divided down to the ones place.
                var Row   := Words.GetInt (R * 4);
                var Place := 1;

                for var K := 0; K < Wide - 1 - C; K := K + 1 do
                    Place := Place * 2;

                if Row div Place mod 2 = 1 then Wash (X + C, Y + R, Ink, 255);
            end
        end
    end

    Exit Wide;
end

/// Lit pixels in a rectangle of the framebuffer.
///
/// Private to this unit; what the tests measure the drawing by.
function LitPixels (Left : Integer, Top : Integer, Wide : Integer, High : Integer) : Integer;
begin
    var Count := 0;

    for var Y := Top; Y < Top + High; Y := Y + 1 do
        for var X := Left; X < Left + Wide; X := X + 1 do
            if Pixels.GetInt (((Y - 1) * WindowWidth + (X - 1)) * 4) <> 0 then
                Count := Count + 1;

    Exit Count;
end

/// Opens the graphics window.
///
/// The window is Width by Height pixels, centred, with Title in its title bar.
/// With Fullscreen true it instead covers the whole desktop at the desktop's
/// own resolution -- the borderless kind of fullscreen, which changes no
/// display mode and cannot leave the screen in one if the program dies -- and
/// Width and Height are not used. On macOS the menu bar stays, so the
/// fullscreen window is the desktop's width but can be short of its height.
///
/// The size asked for and the size received can differ, fullscreen being the
/// obvious case, so `GetMaxX` and `GetMaxY` report what was actually opened
/// rather than echoing the request.
///
/// Turbo Pascal's driver, mode and path parameters are gone; they existed to
/// pick a video card. Failure raises, carrying SDL's own message, rather than
/// setting a result code to be fetched afterward.
///
/// # Raises
/// `Graph is already open.` for a second call before `CloseGraph`;
/// `InitGraph needs a positive size.` for a Width or Height of zero or less;
/// and the message SDL gives when the window or its renderer cannot be made.
///
/// # Examples
/// `InitGraph Opens A SdlWin Of The Size Asked For`
procedure InitGraph (Width : Integer, Height : Integer, Title : String, Fullscreen : Boolean);
begin
    if SdlWin <> nil then raise 'Graph is already open.';
    if Width <= 0 or Height <= 0 then raise 'InitGraph needs a positive size.';

    EnsureVideo ();

    var Flags := WINDOW_SHOWN;

    if Fullscreen then Flags := WINDOW_SHOWN + WINDOW_FULLSCREEN_DESKTOP;

    SdlWin := SDL_CreateWindow (Title, WINDOWPOS_CENTERED, WINDOWPOS_CENTERED,
                                Width, Height, Flags);

    if SdlWin = nil then raise 'InitGraph: ' + SDL_GetError ();

    Renderer := SDL_CreateRenderer (SdlWin, -1, 0);

    if Renderer = nil then
    begin
        var Message := SDL_GetError ();

        SDL_DestroyWindow (SdlWin);
        SdlWin := nil;

        raise 'InitGraph: ' + Message;
    end

    // What was actually opened, which under fullscreen is the desktop's size
    // and not the request. Two one-int buffers, because SDL answers through
    // two out-pointers and a Pointer here cannot be offset.
    var W := Buffer (4);
    var H := Buffer (4);

    SDL_GetWindowSize (SdlWin, W.Address, H.Address);

    WindowWidth  := W.GetInt (0);
    WindowHeight := H.GetInt (0);

    Texture := SDL_CreateTexture (Renderer, PIXELFORMAT_RGB, TEXTURE_STREAMING,
                                  WindowWidth, WindowHeight);

    if Texture = nil then
    begin
        var Reason := SDL_GetError ();

        CloseGraph ();

        raise 'InitGraph: ' + Reason;
    end

    // The framebuffer every routine draws into. A fresh Buffer is zeroed, and
    // zero is black, so the window opens clean.
    Pixels := Buffer (WindowWidth * WindowHeight * 4);

    CurrentX  := 1;
    CurrentY  := 1;
    GridCols  := 80;
    GridRows  := 25;
    BlinkPhaseMs := 267;
    KeyQueue   := [];
    KeyHead    := 0;
    Surfaces   := [];
    Root       := nil;
    NextSerial := 1;

    SDL_StartTextInput ();

    SDL_SetRenderDrawColor (Renderer, 0, 0, 0, 255);
    Present ();
end

/// Closes the graphics window.
///
/// Total: closing when nothing is open does nothing, so a handler may call it
/// unconditionally. The window may be reopened afterward with `InitGraph`.
/// SDL's video subsystem stays up for the life of the process; only the window
/// is released.
///
/// # Examples
/// `CloseGraph Does Nothing When The SdlWin Is Not Open`
procedure CloseGraph ();
begin
    if SdlWin = nil then Exit;

    if Texture <> nil then SDL_DestroyTexture (Texture);

    // Every surface dies with the window it was made in.
    for var S in Surfaces do
        S.Discard ();

    Surfaces := [];
    Root     := nil;

    SDL_DestroyRenderer (Renderer);
    SDL_DestroyWindow (SdlWin);

    Texture      := nil;
    Pixels       := nil;
    Renderer     := nil;
    SdlWin       := nil;
    WindowWidth  := 0;
    WindowHeight := 0;
    CurrentX     := 1;
    CurrentY     := 1;
end

/// The highest X a program can draw to, which is the window's width.
///
/// The screen counts from 1, pixels and cells alike, so the count is the last
/// index and `for var X := 1; X <= GetMaxX (); …` visits every column with no
/// minus one anywhere. The answer describes the window that actually opened,
/// so under fullscreen it is the desktop's width whatever `InitGraph` was
/// asked for.
///
/// For how big a window *could* be, before opening one, see `ScreenWidth`.
///
/// # Raises
/// `Graph is not open.` before `InitGraph` or after `CloseGraph`, when there is
/// no window to measure.
///
/// # Examples
/// `InitGraph Opens A SdlWin Of The Size Asked For`
function GetMaxX () : Integer;
begin
    if SdlWin = nil then raise 'Graph is not open.';

    Exit WindowWidth;
end

/// The highest Y a program can draw to, which is the window's height.
///
/// Everything said of `GetMaxX` holds here, for rows.
///
/// # Raises
/// `Graph is not open.` before `InitGraph` or after `CloseGraph`.
///
/// # Examples
/// `InitGraph Opens A SdlWin Of The Size Asked For`
function GetMaxY () : Integer;
begin
    if SdlWin = nil then raise 'Graph is not open.';

    Exit WindowHeight;
end

/// The desktop's width in pixels.
///
/// Usable before `InitGraph`, which is its purpose: it answers how much room
/// the desktop has, so a program can choose a window size to fit. After a
/// fullscreen `InitGraph` it is what `GetMaxX ()` will equal.
///
/// # Raises
/// The message SDL gives when the desktop cannot be asked.
///
/// # Examples
/// `ScreenWidth And ScreenHeight Answer Before A SdlWin Opens`
function ScreenWidth () : Integer;
begin
    EnsureVideo ();

    // SDL_DisplayMode: format, w, h, refresh rate, then a pointer.
    var Mode := Buffer (32);

    if SDL_GetDesktopDisplayMode (0, Mode.Address) <> 0 then
        raise 'ScreenWidth: ' + SDL_GetError ();

    Exit Mode.GetInt (4);
end

/// The desktop's height in pixels.
///
/// Everything said of `ScreenWidth` holds here, for rows.
///
/// # Raises
/// The message SDL gives when the desktop cannot be asked.
///
/// # Examples
/// `ScreenWidth And ScreenHeight Answer Before A SdlWin Opens`
function ScreenHeight () : Integer;
begin
    EnsureVideo ();

    var Mode := Buffer (32);

    if SDL_GetDesktopDisplayMode (0, Mode.Address) <> 0 then
        raise 'ScreenHeight: ' + SDL_GetError ();

    Exit Mode.GetInt (8);
end

/// Draws Text at the current position and advances it by the text's width.
///
/// Successive calls therefore continue one line, which is what the current
/// position exists for. Nothing wraps: text past the window's edge is clipped,
/// not folded. The ink is white until the unit grows a way to choose a color.
///
/// Any codepoint the installed font carries will draw -- the shipped default
/// covers ASCII, several scripts and a handful of emoji, which arrive in
/// their own colors. One the font lacks advances a blank half-cell.
///
/// # Raises
/// `Graph is not open.` without a window, and `EnsureFont`'s message when no
/// font can be found.
///
/// # Examples
/// `OutText Advances The Current Position By The Text's Width`
procedure OutText (Text : String);
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureFont ();

    for var I := 0; I < Length (Text); I := I + 1 do
        CurrentX := CurrentX + DrawGlyph (Ord (Text[I]), CurrentX, CurrentY, 16777215);

    Present ();
end

/// Draws Text with its top-left corner at X, Y.
///
/// The current position is not consulted and not moved, which is Turbo
/// Pascal's rule and the useful one: placed text is placed, and a following
/// `OutText` carries on from wherever it was. Everything else said of
/// `OutText` holds here.
///
/// # Raises
/// `Graph is not open.` without a window, and `EnsureFont`'s message when no
/// font can be found.
///
/// # Examples
/// `OutTextXY Draws Where It Is Told And Leaves The Position Alone`
procedure OutTextXY (X : Integer, Y : Integer, Text : String);
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureFont ();

    var At := X;

    for var I := 0; I < Length (Text); I := I + 1 do
        At := At + DrawGlyph (Ord (Text[I]), At, Y, 16777215);

    Present ();
end


// ------------------------------------------------------------------ input --

/// Adds one key to the queue.
///
/// Private to this unit.
procedure EnqueueKey (K : Char);
begin
    KeyQueue.Add (K);
end

/// Takes the UTF-8 text out of a TEXTINPUT event, one Char per codepoint.
///
/// Private to this unit, and a function of the event's bytes alone so the
/// tests can feed it crafted ones: synthesizing a real TEXTINPUT through
/// SDL_PushEvent crashes the sdl2-compat layer this machine's SDL2 is, so
/// the decode is exercised directly and only KEYDOWN and QUIT go through
/// SDL's queue in tests. Typing reaches it the ordinary way.
procedure TakeTextEvent (E);
begin
    var I := 12;

    while I < 44 do
    begin
        var B := E[I];

        if B = 0 then Exit;

        if B < 128 then
        begin
            EnqueueKey (Char (B));
            I := I + 1;
        end
        else if B < 224 then
        begin
            EnqueueKey (Char ((B mod 32) * 64 + E[I + 1] mod 64));
            I := I + 2;
        end
        else if B < 240 then
        begin
            EnqueueKey (Char ((B mod 16) * 4096 + (E[I + 1] mod 64) * 64
                              + E[I + 2] mod 64));
            I := I + 3;
        end
        else
        begin
            EnqueueKey (Char ((B mod 8) * 262144 + (E[I + 1] mod 64) * 4096
                              + (E[I + 2] mod 64) * 64 + E[I + 3] mod 64));
            I := I + 4;
        end
    end
end

/// Takes the key out of a KEYDOWN event, when it is one of ours.
///
/// Private to this unit. A control letter arrives as its low character --
/// Ctrl-A is #1 -- as it did on the machines this vocabulary comes from. A
/// plain letter is ignored here, because the text channel delivers it with
/// the layout and shift applied, which a keysym does not carry.
procedure TakeKeyEvent (E);
begin
    var Sym := E.GetInt (20);

    if E[24] div 64 > 0 then
      if Sym >= 97 then
        if Sym <= 122 then
        begin
            EnqueueKey (Char (Sym - 96));

            Exit;
        end

    if Sym in SpecialSyms then EnqueueKey (SpecialSyms[Sym]);
end

/// Drains SDL's event queue into the key queue.
///
/// Private to this unit.
procedure PumpKeys ();
begin
    if EventScratch = nil then EventScratch := Buffer (64);

    while SDL_PollEvent (EventScratch.Address) <> 0 do
    begin
        var Kind := EventScratch.GetInt (0);

        if Kind = 256 then EnqueueKey (KeyClose);
        if Kind = 768 then TakeKeyEvent (EventScratch);
        if Kind = 771 then TakeTextEvent (EventScratch);
    end
end

/// Presents when at least a frame has passed since the last one.
///
/// Private to this unit: the heartbeat that keeps Blink beating while a
/// program waits on input, without a tight loop presenting thousands of
/// frames a second.
procedure PresentIfDue ();
begin
    if Trunc (Clock () * 1000.0) - LastPresentMs >= 16 then Present ();
end

/// Whether a key is waiting.
///
/// Neither consumes the key nor blocks; `ReadKey` answers it. Polling this in
/// a loop keeps the blink phase beating, because the poll presents when a
/// frame is due.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `KeyPressed Sees A Key Without Consuming It`
function KeyPressed () : Boolean;
begin
    if SdlWin = nil then raise 'Graph is not open.';

    PumpKeys ();
    PresentIfDue ();

    Exit KeyHead < KeyQueue.Length;
end

/// The next key, waiting for one if none is ready.
///
/// One Char per key, always: a typed character arrives as itself with the
/// layout and shift applied -- Unicode included, so é and 你 are single
/// answers -- a special key as its constant (`KeyUp`, `KeyF1`, ...), Enter
/// Escape Tab and Backspace as #13 #27 #9 #8, a control letter as its low
/// character, and the window's close button as `KeyClose`. Nothing echoes.
///
/// Turbo Pascal answered a special key as #0 and a scan code on the next
/// call; that was the BIOS showing through, and it is not kept.
///
/// While waiting, the blink phase keeps beating -- the wait presents once a
/// frame -- so `ReadKey` is also the idle loop a finished screen wants.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `ReadKey Answers Keys In The Order They Arrived`
function ReadKey () : Char;
begin
    if SdlWin = nil then raise 'Graph is not open.';

    while True do
    begin
        PumpKeys ();

        if KeyHead < KeyQueue.Length then
        begin
            var K := KeyQueue[KeyHead];

            KeyHead := KeyHead + 1;

            if KeyHead = KeyQueue.Length then
            begin
                KeyQueue := [];
                KeyHead  := 0;
            end

            Exit K;
        end

        PresentIfDue ();
        SDL_Delay (10);
    end
end

// ------------------------------------------------------------- text mode --

/// The width of one text cell, in the logical space surfaces live in.
///
/// Half the font's height, which is the cell shape the shipped fonts are
/// drawn for. A program needs this and `CellHeight` to place a viewport
/// against a window's cells: cell `Col, Row` begins at
/// `(Col - 1) * CellWidth (), (Row - 1) * CellHeight ()`.
///
/// # Examples
/// `The Cell Metrics Place A Viewport Against A Window`
function CellWidth () : Integer;
begin
    EnsureFont ();

    Exit FontHeight div 2;
end

/// The height of one text cell, in the logical space surfaces live in.
///
/// The font's own cell height -- 32 for the shipped default.
///
/// # Examples
/// `The Cell Metrics Place A Viewport Against A Window`
function CellHeight () : Integer;
begin
    EnsureFont ();

    Exit FontHeight;
end

// --------------------------------------------------------------- surfaces --

/// A rectangle of text cells with a place in the stack: Turbo Pascal's
/// `Window (X1, Y1, X2, Y2)` grown into a class.
///
/// A Window carries the whole text vocabulary as methods, with its own
/// cursor, its own colors, its own blink ink and its own scrolling -- its
/// `WriteLn` at its own bottom row scrolls its cells and nothing else's. It
/// is placed in the root grid's cell space, inclusive and one-based, and
/// stacks by `Order`: negative under the root grid, positive over it, ties
/// by creation. `Order` and `Alpha` may be assigned after creation;
/// `MoveTo` drags it. `CloseGraph` invalidates it.
class Window;
var
    X1     : Integer;
    Y1     : Integer;
    X2     : Integer;
    Y2     : Integer;
    Cols   : Integer;
    Rows   : Integer;
    PxW    : Integer;
    PxH    : Integer;
    Buf    : Any;
    Tex    : Any;
    BBuf   : Any;
    BTex   : Any;
    CurCol : Integer;
    CurRow : Integer;
    Pending : Boolean;
    Ink    : Integer;
    Back   : Integer;
    Blinking : Boolean;
    Order  : Integer;
    Alpha  : Integer;
    Serial : Integer;
    Dead   : Boolean;

begin
    constructor Init (X1 : Integer, Y1 : Integer, X2 : Integer, Y2 : Integer,
                      Order : Integer);
    begin
        if SdlWin = nil then raise 'Graph is not open.';
        if Order = 0 then raise 'Order 0 is the screen''s.';
        if X1 < 1 or Y1 < 1 or X2 < X1 or Y2 < Y1 then
            raise 'Window wants 1 <= X1 <= X2 and 1 <= Y1 <= Y2.';

        EnsureFont ();

        // A parameter shadows the field of the same name, so the fields are
        // reached through `this` -- which lets the parameters be named for
        // what they are, and lets a caller write `Window (X1: 1, ...)`.
        this.X1 := X1;
        this.Y1 := Y1;
        this.X2 := X2;
        this.Y2 := Y2;
        Cols := X2 - X1 + 1;
        Rows := Y2 - Y1 + 1;

        this.Order := Order;
        Alpha    := 255;
        Ink      := LightGray;
        Back     := Transparent;
        Blinking := False;
        CurCol   := 1;
        CurRow   := 1;
        Pending  := False;
        Dead     := False;
        Serial   := NextSerial;

        NextSerial := NextSerial + 1;

        Rebuild ();
        Surfaces.Add (this);
    end

    /// Raises when CloseGraph has taken the surface's window away.
    procedure Check ();
    begin
        if Dead then raise 'CloseGraph has closed this surface.';
    end

    /// Allocates the pixel buffers and textures from the current font.
    ///
    /// Called at birth and by a font change, which changes the cell size; the
    /// cells come back empty and the cursor homes.
    procedure Rebuild ();
    begin
        if Tex <> nil then SDL_DestroyTexture (Tex);
        if BTex <> nil then SDL_DestroyTexture (BTex);

        PxW := Cols * CellWidth ();
        PxH := Rows * FontHeight;

        Tex := SDL_CreateTexture (Renderer, PIXELFORMAT_ARGB, TEXTURE_STREAMING,
                                  PxW, PxH);
        BTex := SDL_CreateTexture (Renderer, PIXELFORMAT_ARGB, TEXTURE_STREAMING,
                                   PxW, PxH);

        if Tex = nil then raise 'Graph: ' + SDL_GetError ();
        if BTex = nil then raise 'Graph: ' + SDL_GetError ();

        SDL_SetTextureBlendMode (Tex, BLENDMODE_BLEND);
        SDL_SetTextureBlendMode (BTex, BLENDMODE_BLEND);

        Buf  := Buffer (PxW * PxH * 4);
        BBuf := Buffer (PxW * PxH * 4);

        CurCol  := 1;
        CurRow  := 1;
        Pending := False;
    end

    /// Releases the textures; the surface is dead thereafter.
    procedure Discard ();
    begin
        if Tex <> nil then SDL_DestroyTexture (Tex);
        if BTex <> nil then SDL_DestroyTexture (BTex);

        Tex  := nil;
        BTex := nil;
        Dead := True;
    end

    /// Moves the window so its top-left cell is Col, Row, size kept.
    ///
    /// Any position is allowed, off the grid included -- a window may be
    /// dragged partly or wholly out of view, and what falls outside is
    /// clipped at present time.
    procedure MoveTo (Col : Integer, Row : Integer);
    begin
        Check ();

        X2 := Col + Cols - 1;
        Y2 := Row + Rows - 1;
        X1 := Col;
        Y1 := Row;
    end

    /// This window's left edge in logical pixels, for placing a viewport.
    ///
    /// A viewport at `PixelLeft () + CellWidth (), PixelTop () + CellHeight ()`
    /// begins inside a one-cell frame, and scales with the window because
    /// both live in the same space.
    function PixelLeft () : Integer;
    begin
        Check ();

        Exit (X1 - 1) * CellWidth ();
    end

    /// This window's top edge in logical pixels.
    function PixelTop () : Integer;
    begin
        Check ();

        Exit (Y1 - 1) * CellHeight ();
    end

    /// Moves this window's cursor, one-based within its own cells.
    procedure GotoXY (Col : Integer, Row : Integer);
    begin
        Check ();

        if Col < 1 or Row < 1 or Col > Cols or Row > Rows then
            raise 'GotoXY is off the grid.';

        CurCol  := Col;
        CurRow  := Row;
        Pending := False;
    end

    /// This window's cursor column, counting from 1.
    function WhereX () : Integer;
    begin
        Check ();

        Exit CurCol;
    end

    /// This window's cursor row, counting from 1.
    function WhereY () : Integer;
    begin
        Check ();

        Exit CurRow;
    end

    /// Sets this window's ink; `+ Blink` makes it blink.
    procedure TextColor (Color : Integer);
    begin
        Check ();

        if Color < 0 then raise 'TextColor cannot be transparent.';

        Blinking := Color >= Blink;

        if Blinking then Color := Color - Blink;

        if Color > 16777215 then raise 'TextColor wants an RGB color, plus Blink at most.';

        Ink := Color;
    end

    /// Sets this window's cell background; Transparent shows what is below.
    procedure TextBackground (Color : Integer);
    begin
        Check ();

        if Color < Transparent then raise 'TextBackground wants a color or Transparent.';

        Back := Color;
    end

    /// Brightens this window's ink, as the intensity bit did.
    procedure HighVideo ();
    begin
        Check ();

        if Ink in BrightPartner then Ink := BrightOf (Ink);
        else if Ink in DimPartner then Exit;
        else Ink := (Ink div 65536 + (255 - Ink div 65536) div 2) * 65536
                  + (Ink div 256 mod 256 + (255 - Ink div 256 mod 256) div 2) * 256
                  + (Ink mod 256 + (255 - Ink mod 256) div 2);
    end

    /// Dims this window's ink, the mirror of HighVideo.
    procedure LowVideo ();
    begin
        Check ();

        if Ink in DimPartner then Ink := DimOf (Ink);
        else if Ink in BrightPartner then Exit;
        else Ink := (Ink div 65536 div 2) * 65536
                  + (Ink div 256 mod 256 div 2) * 256
                  + (Ink mod 256 div 2);
    end

    /// Restores this window's startup colors: LightGray on Transparent.
    procedure NormVideo ();
    begin
        Check ();

        Ink      := LightGray;
        Back     := Transparent;
        Blinking := False;
    end

    /// The newline both WriteLn and a #10 spell: column 1, next row,
    /// scrolling THIS window's cells at its bottom.
    procedure NewLine ();
    begin
        CurCol  := 1;
        Pending := False;

        if CurRow < Rows then
        begin
            CurRow := CurRow + 1;

            Exit;
        end

        var Fill := 0;

        if Back >= 0 then Fill := Back - 16777216;

        StampTarget (Buf.Address, PxW, PxH);
        ScrollTarget (FontHeight, Fill);
        StampTarget (BBuf.Address, PxW, PxH);
        ScrollTarget (FontHeight, 0);
    end

    /// Stamps one codepoint at this window's cursor and advances it.
    procedure StampAt (Code : Integer);
    begin
        // A wrap left pending by the previous character happens now, rather
        // than when that character filled the last cell. Text mode always
        // deferred it, and the difference is not cosmetic: a line that
        // exactly fills the bottom row -- a window's lower border, say --
        // would otherwise scroll the window the instant it was drawn.
        if Pending then
        begin
            NewLine ();

            Pending := False;
        end

        var Wide  := CellWidth ();
        var Mode  := 1;
        var Words := nil;

        if Code in FontGlyphs then
        begin
            Words := FontGlyphs[Code];
            Wide  := FontWidths[Code];

            if Code in FontPictures then Mode := 2;
            if not FontGrey then if not (Code in FontPictures) then Mode := 0;
        end

        var Cells := Wide div CellWidth ();

        if Cells < 1 then Cells := 1;
        if CurCol + Cells - 1 > Cols then NewLine ();

        var CellX := (CurCol - 1) * CellWidth ();
        var CellY := (CurRow - 1) * FontHeight;

        // Blinking ink goes to the blink buffer, its background to the text
        // buffer; a steady stamp clears the blink beneath it.
        if Blinking then
        begin
            StampTarget (Buf.Address, PxW, PxH);
            StampCell (CellX, CellY, nil, Wide, FontHeight, 1, Ink, Back);
            StampTarget (BBuf.Address, PxW, PxH);

            if Words = nil then StampCell (CellX, CellY, nil, Wide, FontHeight, 1, Ink, Transparent);
            else StampCell (CellX, CellY, Words.Address, Wide, FontHeight, Mode, Ink, Transparent);
        end
        else
        begin
            StampTarget (Buf.Address, PxW, PxH);

            if Words = nil then
                StampCell (CellX, CellY, nil, Wide, FontHeight, 1, Ink, Back);
            else
                StampCell (CellX, CellY, Words.Address, Wide, FontHeight, Mode, Ink, Back);

            StampTarget (BBuf.Address, PxW, PxH);
            StampCell (CellX, CellY, nil, Wide, FontHeight, 1, Ink, Transparent);
        end

        CurCol := CurCol + Cells;

        // Past the last column the cursor rests ON the last column with the
        // wrap owed, so WhereX never answers a cell that does not exist.
        if CurCol > Cols then
        begin
            CurCol  := Cols;
            Pending := True;
        end
    end

    /// Stamps one string at the cursor, without presenting.
    ///
    /// Private to this unit; `Write` and `WriteLn` are the verbs.
    procedure Emit (Text : String);
    begin
        for var I := 0; I < Length (Text); I := I + 1 do
        begin
            if Text[I] = #10 then NewLine ();
            else StampAt (Ord (Text[I]));
        end
    end

    /// Writes its arguments at this window's cursor, advancing it.
    ///
    /// Variadic, and each value rendered as `Str` would render it, which is
    /// the built-in `Write`'s own contract [RT-015] kept within these walls.
    /// Wraps at the window's own last column and scrolls its own cells at
    /// its bottom row; a #10 starts a new row.
    procedure Write (Values : List of Any);
    begin
        Check ();

        for var V in Values do
            Emit (Str (V));

        Present ();
    end

    /// Writes its arguments and moves to the start of the next row.
    ///
    /// `W.WriteLn ()` is a bare newline.
    procedure WriteLn (Values : List of Any);
    begin
        Check ();

        for var V in Values do
            Emit (Str (V));

        NewLine ();
        Present ();
    end

    /// Clears this window from its cursor to the end of its row.
    procedure ClrEol ();
    begin
        Check ();

        StampTarget (Buf.Address, PxW, PxH);

        for var Col := CurCol; Col <= Cols; Col := Col + 1 do
            StampCell ((Col - 1) * CellWidth (), (CurRow - 1) * FontHeight, nil,
                       CellWidth (), FontHeight, 1, Ink, Back);

        StampTarget (BBuf.Address, PxW, PxH);

        for var Col := CurCol; Col <= Cols; Col := Col + 1 do
            StampCell ((Col - 1) * CellWidth (), (CurRow - 1) * FontHeight, nil,
                       CellWidth (), FontHeight, 1, Ink, Transparent);

        Present ();
    end

    /// Clears all this window's cells to its background and homes its cursor.
    procedure ClrScr ();
    begin
        Check ();

        StampTarget (Buf.Address, PxW, PxH);

        for var Row := 0; Row < Rows; Row := Row + 1 do
            for var Col := 0; Col < Cols; Col := Col + 1 do
                StampCell (Col * CellWidth (), Row * FontHeight, nil,
                           CellWidth (), FontHeight, 1, Ink, Back);

        StampTarget (BBuf.Address, PxW, PxH);

        for var Row := 0; Row < Rows; Row := Row + 1 do
            for var Col := 0; Col < Cols; Col := Col + 1 do
                StampCell (Col * CellWidth (), Row * FontHeight, nil,
                           CellWidth (), FontHeight, 1, Ink, Transparent);

        CurCol  := 1;
        CurRow  := 1;
        Pending := False;

        Present ();
    end

    /// Draws this window into the frame: present-time only.
    ///
    /// The window lives in the root grid's cell space, so its place on
    /// screen is that space scaled to the physical window.
    procedure Blit (BlinkVisible : Boolean);
    begin
        if Dead then Exit;

        var LogW := GridCols * CellWidth ();
        var LogH := GridRows * CellHeight ();

        if DstRect = nil then DstRect := Buffer (16);

        DstRect.PutInt (0,  (X1 - 1) * CellWidth () * WindowWidth div LogW);
        DstRect.PutInt (4,  (Y1 - 1) * CellHeight () * WindowHeight div LogH);
        DstRect.PutInt (8,  PxW * WindowWidth div LogW);
        DstRect.PutInt (12, PxH * WindowHeight div LogH);

        SDL_UpdateTexture (Tex, nil, Buf.Address, PxW * 4);
        SDL_SetTextureAlphaMod (Tex, Alpha);
        SDL_RenderCopy (Renderer, Tex, nil, DstRect.Address);

        if BlinkVisible then
        begin
            SDL_UpdateTexture (BTex, nil, BBuf.Address, PxW * 4);
            SDL_SetTextureAlphaMod (BTex, Alpha);
            SDL_RenderCopy (Renderer, BTex, nil, DstRect.Address);
        end
    end
end

/// A positioned, sized pixel surface with a place in the stack.
///
/// What DESIGN.md first called Canvas, under the Turbo Pascal name for a
/// clipped drawing region. Local coordinates count from 1 and are the clip;
/// unpainted pixels are transparent; `Order` stacks it under or over the
/// text, `Alpha` ghosts the whole surface, and both may be assigned after
/// creation. `MoveTo` drags it. `CloseGraph` invalidates it.
class ViewPort;
var
    X      : Integer;
    Y      : Integer;
    W      : Integer;
    H      : Integer;
    Buf    : Any;
    Tex    : Any;
    CurX   : Integer;
    CurY   : Integer;
    Dir    : Integer;
    Size   : Integer;
    PenX   : Integer;
    PenY   : Integer;
    Pen    : Integer;
    Style  : Integer;
    Bits   : Integer;
    Thick  : Integer;
    Order  : Integer;
    Alpha  : Integer;
    Serial : Integer;
    Dead   : Boolean;

begin
    constructor Init (X : Integer, Y : Integer, W : Integer, H : Integer,
                      Order : Integer);
    begin
        if SdlWin = nil then raise 'Graph is not open.';
        if Order = 0 then raise 'Order 0 is the screen''s.';
        if W < 1 or H < 1 then raise 'ViewPort needs a positive size.';

        // The parameters are named for the fields they fill, so the fields
        // are reached through `this` and a caller may write
        // `ViewPort (X: 10, Y: 10, ...)`.
        this.X := X;
        this.Y := Y;
        this.W := W;
        this.H := H;

        this.Order := Order;
        Alpha  := 255;
        CurX   := 1;
        CurY   := 1;
        Dir    := 0;
        Size   := 1;
        PenX   := 1;
        PenY   := 1;
        Pen    := 16777215;      // White, as a fresh screen's ink
        Style  := SolidLn;
        Bits   := 65535;
        Thick  := NormWidth;
        Serial := NextSerial;
        Dead   := False;

        NextSerial := NextSerial + 1;

        Tex := SDL_CreateTexture (Renderer, PIXELFORMAT_ARGB, TEXTURE_STREAMING, W, H);

        if Tex = nil then raise 'Graph: ' + SDL_GetError ();

        SDL_SetTextureBlendMode (Tex, BLENDMODE_BLEND);

        Buf := Buffer (W * H * 4);

        Surfaces.Add (this);
    end

    /// Raises when CloseGraph has taken the surface's window away.
    procedure Check ();
    begin
        if Dead then raise 'CloseGraph has closed this surface.';
    end

    /// Releases the texture; the surface is dead thereafter.
    procedure Discard ();
    begin
        if Tex <> nil then SDL_DestroyTexture (Tex);

        Tex  := nil;
        Dead := True;
    end

    /// Moves the viewport so its top-left pixel is at PX, PY.
    ///
    /// The viewport, not the pen: `PenTo` moves that.
    procedure MoveTo (PX : Integer, PY : Integer);
    begin
        Check ();

        X := PX;
        Y := PY;
    end

    /// Paints one pixel of this viewport, in local coordinates from 1.
    ///
    /// A position off the viewport is clipped silently -- the edge is the
    /// clip, as a canvas's edge always is here.
    procedure PutPixel (PX : Integer, PY : Integer, Color : Integer);
    begin
        Check ();

        if PX >= 1 then
          if PY >= 1 then
            if PX <= W then
              if PY <= H then
                  Buf.PutInt (((PY - 1) * W + (PX - 1)) * 4, Color - 16777216);
    end


    /// Sets the color the pen draws and free text is written in.
    ///
    /// Turbo Pascal's `SetColor`, and it governs `Line`, `LineTo`, `LineRel`
    /// and the `OutText` pair alike -- one pen for everything this surface
    /// draws. A fresh viewport draws in White.
    ///
    /// # Raises
    /// `SetColor wants an RGB color.` for a negative, there being no
    /// transparent ink.
    procedure SetColor (Color : Integer);
    begin
        Check ();

        if Color < 0 then raise 'SetColor wants an RGB color.';

        Pen := Color;
    end

    /// The color the pen is drawing in.
    function GetColor () : Integer;
    begin
        Check ();

        Exit Pen;
    end

    /// Sets the pattern and thickness lines are drawn with.
    ///
    /// Style is one of `SolidLn`, `DottedLn`, `CenterLn`, `DashedLn` or
    /// `UserBitLn`; with `UserBitLn` the sixteen bits of Pattern are walked
    /// along the line instead, one bit to the pixel, and any other style
    /// ignores Pattern. Thickness is `NormWidth` or `ThickWidth`, or any
    /// positive count of pixels -- Turbo Pascal allowed only the two, and
    /// there is no reason here to refuse a fourth.
    ///
    /// # Raises
    /// `SetLineStyle wants a known style.` and `SetLineStyle needs a
    /// thickness of 1 or more.`
    procedure SetLineStyle (Style : Integer, Pattern : Integer, Thickness : Integer);
    begin
        Check ();

        if Style < SolidLn or Style > UserBitLn then
            raise 'SetLineStyle wants a known style.';

        if Thickness < 1 then raise 'SetLineStyle needs a thickness of 1 or more.';

        this.Style := Style;
        Thick := Thickness;

        if Style = SolidLn then Bits := 65535;
        else if Style = DottedLn then Bits := 52428;      // 1100110011001100
        else if Style = CenterLn then Bits := 64632;      // 1111110001111000
        else if Style = DashedLn then Bits := 61680;      // 1111000011110000
        else Bits := Pattern;
    end

    /// Moves the pen to PX, PY without drawing.
    ///
    /// Turbo Pascal called this `MoveTo`, which here places the viewport
    /// itself. `PenTo` and `PenRel` pair with `LineTo` and `LineRel` -- the
    /// same two destinations, one drawing and one not.
    procedure PenTo (PX : Integer, PY : Integer);
    begin
        Check ();

        PenX := PX;
        PenY := PY;
    end

    /// Moves the pen by DX, DY without drawing.
    procedure PenRel (DX : Integer, DY : Integer);
    begin
        Check ();

        PenX := PenX + DX;
        PenY := PenY + DY;
    end

    /// The pen's X.
    function GetX () : Integer;
    begin
        Check ();

        Exit PenX;
    end

    /// The pen's Y.
    function GetY () : Integer;
    begin
        Check ();

        Exit PenY;
    end

    /// Paints one pixel of the pen's thickness around PX, PY.
    ///
    /// Private to this unit. A thickness above one spreads across the axis
    /// the line runs least along, which is what keeps a thick diagonal from
    /// looking like a staircase of blobs.
    procedure Nib (PX : Integer, PY : Integer, Steep : Boolean);
    begin
        if Thick <= 1 then
        begin
            this.PutPixel (PX, PY, Pen);

            Exit;
        end

        var Half := Thick div 2;

        for var K := 0 - Half; K <= Thick - 1 - Half; K := K + 1 do
            if Steep then this.PutPixel (PX + K, PY, Pen);
            else this.PutPixel (PX, PY + K, Pen);
    end

    /// Draws a line from AX1, AY1 to AX2, AY2, leaving the pen at the end.
    ///
    /// Bresenham, in the viewport's own coordinates, clipped at its edges.
    /// The current style patterns it and the current thickness widens it.
    procedure Line (X1 : Integer, Y1 : Integer, X2 : Integer, Y2 : Integer);
    begin
        Check ();

        var X0 := X1;
        var Y0 := Y1;
        var DX := X2 - X1;
        var DY := Y2 - Y1;

        if DX < 0 then DX := 0 - DX;
        if DY < 0 then DY := 0 - DY;

        var SX := -1;
        var SY := -1;

        if X1 < X2 then SX := 1;
        if Y1 < Y2 then SY := 1;

        // A steep line steps in Y and spreads its thickness in X.
        var Steep := DY > DX;
        var Err   := DX - DY;
        var Tick  := 0;

        while True do
        begin
            // The pattern repeats every sixteen pixels; bit 15 leads.
            var Place := 1;

            for var K := 0; K < 15 - Tick mod 16; K := K + 1 do
                Place := Place * 2;

            if Bits div Place mod 2 = 1 then Nib (X0, Y0, Steep);

            Tick := Tick + 1;

            if X0 = X2 then if Y0 = Y2 then
            begin
                PenX := X2;
                PenY := Y2;

                Present ();

                Exit;
            end

            var E2 := 2 * Err;

            if E2 > 0 - DY then
            begin
                Err := Err - DY;
                X0  := X0 + SX;
            end

            if E2 < DX then
            begin
                Err := Err + DX;
                Y0  := Y0 + SY;
            end
        end
    end

    /// Draws from the pen to PX, PY, leaving the pen there.
    procedure LineTo (PX : Integer, PY : Integer);
    begin
        Check ();

        this.Line (PenX, PenY, PX, PY);
    end

    /// Draws from the pen by DX, DY, leaving the pen at the far end.
    procedure LineRel (DX : Integer, DY : Integer);
    begin
        Check ();

        this.Line (PenX, PenY, PenX + DX, PenY + DY);
    end

    /// Draws the outline of a rectangle with opposite corners at the points.
    ///
    /// Four lines in the current style and thickness; the pen ends where it
    /// began, which is what makes the four sides one figure.
    procedure Rectangle (X1 : Integer, Y1 : Integer, X2 : Integer, Y2 : Integer);
    begin
        Check ();

        this.Line (X1, Y1, X2, Y1);
        this.Line (X2, Y1, X2, Y2);
        this.Line (X2, Y2, X1, Y2);
        this.Line (X1, Y2, X1, Y1);
    end

    /// Sets the direction and size free text on this viewport is drawn in.
    ///
    /// Direction is a quarter turn counterclockwise in degrees -- 0, 90, 180
    /// or 270 -- and CharSize magnifies the glyphs by a whole number, 1
    /// being the font's own size. Turbo Pascal's `SetTextStyle` took a font
    /// as well; here the glyph file installed by `InstallUserFont` is the
    /// font, so selecting one is installing one and the parameter has
    /// nothing to choose.
    ///
    /// Celled text has neither setting and cannot: a rotated glyph does not
    /// fit a half-width cell, and a magnified one does not fit at all. That
    /// is why these live on the viewport.
    procedure SetTextStyle (Direction : Integer, CharSize : Integer);
    begin
        Check ();

        if Direction <> 0 and Direction <> 90 and Direction <> 180
           and Direction <> 270 then
            raise 'SetTextStyle wants 0, 90, 180 or 270 degrees.';

        if CharSize < 1 then raise 'SetTextStyle needs a CharSize of 1 or more.';

        Dir  := Direction;
        Size := CharSize;
    end

    /// Draws free text with its top-left at local PX, PY, in the pen's color.
    ///
    /// This is a graphic that happens to be letters: no cursor, no wrap, no
    /// text verb will ever erase it. `SetTextStyle` turns and magnifies it.
    /// Present it with `Show`.
    procedure OutTextXY (PX : Integer, PY : Integer, Text : String);
    begin
        Check ();
        EnsureFont ();
        StampTarget (Buf.Address, W, H);
        StampStyle (Size, Dir);

        var AtX := PX - 1;
        var AtY := PY - 1;

        for var I := 0; I < Length (Text); I := I + 1 do
        begin
            var Code  := Ord (Text[I]);
            var Wide  := FontHeight div 2;
            var Mode  := 1;
            var Words := nil;

            if Code in FontGlyphs then
            begin
                Words := FontGlyphs[Code];
                Wide  := FontWidths[Code];

                if Code in FontPictures then Mode := 2;
                if not FontGrey then if not (Code in FontPictures) then Mode := 0;
            end

            if Words <> nil then
                StampCell (AtX, AtY, Words.Address, Wide, FontHeight, Mode,
                           Pen, Transparent);

            // The advance follows the turn: right, up, left or down.
            var Step := Wide * Size;

            if Dir = 0 then AtX := AtX + Step;
            else if Dir = 90 then AtY := AtY - Step;
            else if Dir = 180 then AtX := AtX - Step;
            else AtY := AtY + Step;
        end

        // The grid stamps 1:1 and upright, and never sets the style itself.
        StampStyle (1, 0);

        Present ();
    end

    /// Draws free text at this viewport's current position, advancing it.
    procedure OutText (Text : String);
    begin
        Check ();

        // `this`, because the unqualified name would find the global
        // OutTextXY -- which draws on the background, not on this surface.
        this.OutTextXY (CurX, CurY, Text);

        var Step := 0;

        for var I := 0; I < Length (Text); I := I + 1 do
            Step := Step + GlyphWidthOf (Ord (Text[I])) * Size;

        if Dir = 0 then CurX := CurX + Step;
        else if Dir = 90 then CurY := CurY - Step;
        else if Dir = 180 then CurX := CurX - Step;
        else CurY := CurY + Step;
    end

    /// Pushes the pixels to the screen.
    procedure Show ();
    begin
        Check ();
        Present ();
    end

    /// Draws this viewport into the frame: present-time only.
    procedure Blit (BlinkVisible : Boolean);
    begin
        if Dead then Exit;

        // A viewport lives in the same logical space the grid does, so it
        // scales with the window exactly as a Window does -- which is what
        // lets one be placed against the other's cells and stay there at
        // every window size.
        var LogW := GridCols * CellWidth ();
        var LogH := GridRows * CellHeight ();

        if DstRect = nil then DstRect := Buffer (16);

        DstRect.PutInt (0,  (X - 1) * WindowWidth div LogW);
        DstRect.PutInt (4,  (Y - 1) * WindowHeight div LogH);
        DstRect.PutInt (8,  W * WindowWidth div LogW);
        DstRect.PutInt (12, H * WindowHeight div LogH);

        SDL_UpdateTexture (Tex, nil, Buf.Address, W * 4);
        SDL_SetTextureAlphaMod (Tex, Alpha);
        SDL_RenderCopy (Renderer, Tex, nil, DstRect.Address);
    end
end

/// Builds the root Window -- the screen-wide grid at Order 0 -- on the
/// first text verb, so a purely graphical program never loads a font.
///
/// Private to this unit.
procedure EnsureRoot ();
begin
    if Root <> nil then Exit;

    Root := Window (1, 1, GridCols, GridRows, 1);
    Root.Order := 0;
end

// -------------------------------------------------- the global text verbs --
//
// The words programs already use, kept as the root Window's methods: the
// screen-wide grid is the bottom surface, and writing to "the screen" is
// writing to it.

/// The grid's width in cells: 80 until `TextMode` says otherwise.
///
/// The grid is logical, not a division of the window -- an 80 by 25 screen
/// is 80 by 25 in every window, scaled to fit. A wide (CJK) glyph occupies
/// two of its cells.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `The Grid Is Eighty By Twenty Five Whatever The Window`
function TextCols () : Integer;
begin
    if SdlWin = nil then raise 'Graph is not open.';

    Exit GridCols;
end

/// The grid's height in cells: 25 until `TextMode` says otherwise.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `The Grid Is Eighty By Twenty Five Whatever The Window`
function TextRows () : Integer;
begin
    if SdlWin = nil then raise 'Graph is not open.';

    Exit GridRows;
end

/// Chooses the grid: Cols by Rows cells, whatever the window's size.
///
/// The screen clears, the cursor homes, and the colors return to their
/// defaults, which is what Turbo Pascal's `TextMode` did. Its argument was a
/// video-card mode -- CO80, CO40, Font8x8 -- because the grid was a register
/// setting; here the grid is logical and any pair will do. Other surfaces
/// survive a mode change; they live in the cell space it defines and scale
/// with it.
///
/// # Raises
/// `Graph is not open.` without a window, and `TextMode needs a positive
/// grid.` for a Cols or Rows of zero or less.
///
/// # Examples
/// `TextMode Chooses The Grid`
procedure TextMode (Cols : Integer, Rows : Integer);
begin
    if SdlWin = nil then raise 'Graph is not open.';
    if Cols <= 0 or Rows <= 0 then raise 'TextMode needs a positive grid.';

    GridCols := Cols;
    GridRows := Rows;

    if Root <> nil then
    begin
        Root.Discard ();

        var Kept := [];

        for var S in Surfaces do
            if S.Serial <> Root.Serial then Kept.Add (S);

        Surfaces := Kept;
        Root     := nil;
    end

    Present ();
end

/// Moves the screen's cursor to column Col, row Row.
///
/// One-based, as Turbo Pascal and every terminal since have had it: the
/// top-left cell is 1, 1 and the bottom-right is `TextCols (), TextRows ()`
/// -- the count is the last index, and no cell coordinate ever carries a
/// minus one. The one seam with the language's 0-based strings is
/// `Text[Col - 1]`.
///
/// # Raises
/// `Graph is not open.` without a window, and `GotoXY is off the grid.` for
/// a position outside it -- the cursor is always somewhere real.
///
/// # Examples
/// `GotoXY Places The Cursor And WhereX Reads It Back`
procedure GotoXY (Col : Integer, Row : Integer);
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();
    Root.GotoXY (Col, Row);
end

/// The screen cursor's column, counting from 1.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `GotoXY Places The Cursor And WhereX Reads It Back`
function WhereX () : Integer;
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();

    Exit Root.WhereX ();
end

/// The screen cursor's row, counting from 1.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `GotoXY Places The Cursor And WhereX Reads It Back`
function WhereY () : Integer;
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();

    Exit Root.WhereY ();
end

/// Sets the screen's ink; `+ Blink` makes it blink.
///
/// # Raises
/// `Graph is not open.`; `TextColor cannot be transparent.`; and `TextColor
/// wants an RGB color, plus Blink at most.` past the flag.
///
/// # Examples
/// `TextColor And TextBackground Color The Cell`
procedure TextColor (Color : Integer);
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();
    Root.TextColor (Color);
end

/// Sets the screen's cell background; Transparent shows what is beneath.
///
/// # Raises
/// `Graph is not open.` and `TextBackground wants a color or Transparent.`
///
/// # Examples
/// `TextColor And TextBackground Color The Cell`
procedure TextBackground (Color : Integer);
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();
    Root.TextBackground (Color);
end

/// Sets how long each blink phase lasts, in milliseconds.
///
/// One clock for every surface: blinking ink is visible for Ms milliseconds
/// and hidden for the same. The default is 267 -- the adapter's cadence --
/// and 533 gives the caret's slower blink. A fresh `InitGraph` restores 267;
/// `TextMode` and the videos never touch it.
///
/// # Raises
/// `SetBlinkRate needs a positive time.` for an Ms of zero or less.
///
/// # Examples
/// `SetBlinkRate Chooses The Cadence`
procedure SetBlinkRate (Ms : Integer);
begin
    if Ms <= 0 then raise 'SetBlinkRate needs a positive time.';

    BlinkPhaseMs := Ms;
end

/// Brightens the screen's ink, as the intensity bit did.
///
/// # Examples
/// `HighVideo Brightens The Ink And LowVideo Dims It`
procedure HighVideo ();
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();
    Root.HighVideo ();
end

/// Dims the screen's ink, the mirror of HighVideo.
///
/// # Examples
/// `HighVideo Brightens The Ink And LowVideo Dims It`
procedure LowVideo ();
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();
    Root.LowVideo ();
end

/// Restores the screen's startup colors: LightGray on Transparent.
///
/// # Examples
/// `NormVideo Restores The Startup Colors`
procedure NormVideo ();
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();
    Root.NormVideo ();
end

/// Writes its arguments at the screen's cursor, advancing it.
///
/// The screen is the root Window, and this is its `Write`: celled text that
/// wraps at the last column, scrolls the grid -- and only the grid -- at the
/// bottom, and is what `ClrEol` and `ClrScr` erase. Variadic, and each value
/// rendered as `Str` would render it, which is the built-in's own contract
/// [RT-015].
///
/// This name shadows that built-in for any program that says `uses graph`,
/// which is the intent: in a graphics program `Write` should reach the
/// window. The console is still there under its own unit's name --
/// `System.Write` and `System.WriteLn` -- and the library's own examples use
/// it to report while a window is open.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `Write Stamps Cells And Advances The Cursor`
procedure Write (Values : List of Any);
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();

    for var V in Values do
        Root.Emit (Str (V));

    Present ();
end

/// Writes its arguments and moves to the start of the screen's next row.
///
/// `WriteLn ()` is a bare newline. Everything said of `Write` holds here,
/// `System.WriteLn` included.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `WriteLn Moves To The Start Of The Next Row`
procedure WriteLn (Values : List of Any);
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();

    for var V in Values do
        Root.Emit (Str (V));

    Root.NewLine ();
    Present ();
end

/// Clears the screen from its cursor to the end of the row.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `ClrEol Erases The Prose And Never The Chart`
procedure ClrEol ();
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();
    Root.ClrEol ();
end

/// Clears the whole screen grid and homes its cursor.
///
/// # Raises
/// `Graph is not open.` without a window.
///
/// # Examples
/// `ClrScr Fills The Grid With The Background And Homes The Cursor`
procedure ClrScr ();
begin
    if SdlWin = nil then raise 'Graph is not open.';

    EnsureRoot ();
    Root.ClrScr ();
end

// ---------------------------------------------------------------- tests --
//
// Run under SDL's dummy video driver by ./test.sh, so no window reaches the
// desktop. Run directly -- `algc --test graph.a24` -- they open real windows
// for a moment, which is harmless and occasionally worth seeing. Nothing
// asserted depends on which driver answered.

test 'InitGraph Opens A SdlWin Of The Size Asked For';
begin
    CloseGraph ();

    InitGraph (320, 200, 'sized', False);

    AssertEqual (320, GetMaxX ());
    AssertEqual (200, GetMaxY ());

    CloseGraph ();
end

test 'InitGraph Carries The Title Through, Unicode Included';
begin
    CloseGraph ();

    InitGraph (100, 100, 'Algol-24 ✓', False);

    AssertEqual ('Algol-24 ✓', SDL_GetWindowTitle (SdlWin));

    CloseGraph ();
end

test 'InitGraph Raises When The SdlWin Is Already Open';
begin
    CloseGraph ();

    InitGraph (100, 100, 'first', False);

    var Message := '';

    try InitGraph (100, 100, 'second', False); except on e : String do Message := e; end
    AssertEqual ('Graph is already open.', Message);

    // And the first window survived the refusal.
    AssertEqual (100, GetMaxX ());

    CloseGraph ();
end

test 'InitGraph Raises For A Size That Is Not Positive';
begin
    CloseGraph ();

    var Message := '';

    try InitGraph (0, 100, 'x', False); except on e : String do Message := e; end
    AssertEqual ('InitGraph needs a positive size.', Message);

    Message := '';
    try InitGraph (100, -1, 'x', False); except on e : String do Message := e; end
    AssertEqual ('InitGraph needs a positive size.', Message);

    // A refused init opened nothing.
    Message := '';
    try GetMaxX (); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);
end

/// Borderless fullscreen takes the desktop's size, not the request's. The
/// height is asserted as a range rather than an equality because macOS keeps
/// its menu bar: there the fullscreen window is the desktop's width but
/// slightly less than its height, and both facts are the windowing system's
/// truth rather than anyone's bug.
test 'InitGraph Fullscreen Fills The Desktop';
begin
    CloseGraph ();

    InitGraph (100, 100, 'full', True);

    AssertEqual (ScreenWidth (), GetMaxX ());
    AssertTrue (GetMaxY () > 100);
    AssertTrue (GetMaxY () <= ScreenHeight ());

    CloseGraph ();
end

test 'CloseGraph Does Nothing When The SdlWin Is Not Open';
begin
    CloseGraph ();
    CloseGraph ();

    AssertTrue (True);
end

test 'CloseGraph Releases The SdlWin So Another May Open';
begin
    CloseGraph ();

    InitGraph (320, 200, 'first', False);
    CloseGraph ();

    InitGraph (640, 480, 'second', False);

    AssertEqual (640, GetMaxX ());
    AssertEqual (480, GetMaxY ());

    CloseGraph ();
end

test 'GetMaxX And GetMaxY Raise When The SdlWin Is Not Open';
begin
    CloseGraph ();

    var Message := '';

    try GetMaxX (); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);

    Message := '';
    try GetMaxY (); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);
end

test 'GetMaxX And GetMaxY Raise Again After The SdlWin Closes';
begin
    CloseGraph ();

    InitGraph (100, 100, 'brief', False);
    CloseGraph ();

    var Message := '';

    try GetMaxX (); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);
end

/// The values are the machine's, so only their soundness can be asserted.
test 'ScreenWidth And ScreenHeight Answer Before A SdlWin Opens';
begin
    AssertTrue (ScreenWidth () > 0);
    AssertTrue (ScreenHeight () > 0);
end

test 'ScreenWidth Is Unchanged By A SdlWin Opening And Closing';
begin
    CloseGraph ();

    var Before := ScreenWidth ();

    InitGraph (100, 100, 'x', False);
    AssertEqual (Before, ScreenWidth ());

    CloseGraph ();
    AssertEqual (Before, ScreenWidth ());
end

// ------------------------------------------------------- OutText and fonts --

test 'OutTextXY Draws Where It Is Told And Leaves The Position Alone';
begin
    CloseGraph ();
    InitGraph (200, 100, 'text', False);

    AssertEqual (0, LitPixels (10, 10, 40, 40));

    OutTextXY (10, 10, 'A');

    AssertTrue (LitPixels (10, 10, 40, 40) > 0);
    AssertEqual (1, CurrentX);
    AssertEqual (1, CurrentY);

    CloseGraph ();
end

test 'OutText Advances The Current Position By The Text''s Width';
begin
    CloseGraph ();
    InitGraph (400, 100, 'advance', False);

    OutText ('AB');

    AssertEqual (1 + FontWidths[Ord ('A')] + FontWidths[Ord ('B')], CurrentX);
    AssertEqual (1, CurrentY);

    // And the next call carries on from there rather than overprinting.
    var Before := CurrentX;

    OutText ('C');

    AssertEqual (Before + FontWidths[Ord ('C')], CurrentX);

    CloseGraph ();
end

test 'OutText And OutTextXY Raise When The SdlWin Is Not Open';
begin
    CloseGraph ();

    var Message := '';

    try OutText ('x'); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);

    Message := '';
    try OutTextXY (0, 0, 'x'); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);
end

/// The shipped default is a cell font: a CJK glyph takes two cells, which is
/// what makes columns line up, and the reason width lives per glyph at all.
test 'A Wide Glyph Advances Twice A Narrow One';
begin
    CloseGraph ();
    InitGraph (200, 100, 'wide', False);

    OutText ('你');
    var Wide := CurrentX - 1;

    CurrentX := 1;
    OutText ('A');

    AssertEqual (2 * (CurrentX - 1), Wide);

    CloseGraph ();
end

/// A picture glyph brings its own colors, so at least one of its pixels must
/// have unequal channels -- ink from the grey font never does.
test 'An Emoji Glyph Arrives In Its Own Colors';
begin
    CloseGraph ();
    InitGraph (100, 100, 'emoji', False);

    OutTextXY (1, 1, '🙂');

    var Colored := False;

    for var Y := 0; Y < 40; Y := Y + 1 do
        for var X := 0; X < 40; X := X + 1 do
        begin
            var P := Pixels.GetInt ((Y * WindowWidth + X) * 4);

            if P div 65536 mod 256 <> P mod 256 then Colored := True;
        end

    AssertTrue (Colored);

    CloseGraph ();
end

/// Rather than raising over one exotic character, a codepoint the font lacks
/// advances a blank half-cell and the rest of the text lands.
test 'A Glyph The Font Lacks Advances A Blank Half Cell';
begin
    CloseGraph ();
    InitGraph (200, 100, 'gap', False);

    OutText ('ʣ');

    AssertEqual (1 + FontHeight div 2, CurrentX);

    CloseGraph ();
end

test 'Text Past The SdlWin''s Edge Is Clipped Rather Than Raising';
begin
    CloseGraph ();
    InitGraph (64, 64, 'clip', False);

    OutTextXY (60, 60, 'well beyond the edge');
    OutTextXY (-10, -10, 'and before it');

    AssertTrue (True);

    CloseGraph ();
end

test 'InstallUserFont Selects Another Glyph File';
begin
    CloseGraph ();
    InitGraph (200, 100, 'rom', False);

    InstallUserFont ('romfont.hex');

    // The character-ROM font is one bit per pixel: 16 tall, 8 to a narrow cell.
    AssertEqual (16, FontHeight);
    AssertEqual (8, FontWidths[Ord ('A')]);

    OutTextXY (10, 10, 'A');
    AssertTrue (LitPixels (10, 10, 20, 20) > 0);

    // Put the default back so no later test inherits the ROM look.
    InstallUserFont ('graphfont.hex');
    AssertEqual (32, FontHeight);

    CloseGraph ();
end

test 'InstallUserFont Raises For A File That Is Not There';
begin
    var Message := '';

    try InstallUserFont ('no-such-font.hex'); except on e : String do Message := e; end
    AssertEqual ('InstallUserFont: cannot open ''no-such-font.hex''.', Message);
end

/// A font that cannot be opened must leave the installed one untouched --
/// clearing first would trade a good font for an error message.
test 'A Failed InstallUserFont Leaves The Old Font Installed';
begin
    CloseGraph ();
    InitGraph (200, 100, 'keep', False);

    OutText ('A');
    var Before := CurrentX;

    try InstallUserFont ('no-such-font.hex'); except end

    CurrentX := 1;
    OutText ('A');

    AssertEqual (Before, CurrentX);

    CloseGraph ();
end

/// The decoder is the unit's one C primitive, so its exact values are pinned:
/// grey pairs, a whole 1-bit row, a picture pixel past the sign bit, junk
/// digits, and the ignored trailing partial group.
test 'The Hex Decoder Answers Known Values';
begin
    var Out := Buffer (64);

    AssertEqual (3, UnhexWords ('FF1000', 2, Out.Address));
    AssertEqual (255, Out.GetInt (0));
    AssertEqual (16, Out.GetInt (4));
    AssertEqual (0, Out.GetInt (8));

    AssertEqual (1, UnhexWords ('0180', 4, Out.Address));
    AssertEqual (384, Out.GetInt (0));

    // FFFFFFFF is stored as its bit pattern and reads back signed.
    AssertEqual (1, UnhexWords ('FFFFFFFF', 8, Out.Address));
    AssertEqual (-1, Out.GetInt (0));
    AssertEqual (4294967295, Out.GetInt (0) + 4294967296);

    // A junk digit counts as zero, as the old decoding had it.
    AssertEqual (1, UnhexWords ('ZF', 2, Out.Address));
    AssertEqual (15, Out.GetInt (0));

    // A trailing partial group is ignored, not half-decoded.
    AssertEqual (1, UnhexWords ('ABC', 2, Out.Address));
    AssertEqual (171, Out.GetInt (0));
end

/// The default font must carry the machinery of a text UI -- frames, shades,
/// scrollbar arrows -- and its frame glyphs are synthesized to touch their
/// cell edges, which is what lets adjacent cells connect without seams.
test 'The Default Font Carries The Frame Glyphs Edge To Edge';
begin
    CloseGraph ();
    InitGraph (200, 100, 'frame', False);

    OutTextXY (1, 1, '╔═╗');

    AssertEqual (16, FontWidths[Ord ('═')]);
    AssertEqual (16, FontWidths[Ord ('║')]);
    AssertEqual (16, FontWidths[Ord ('░')]);
    AssertEqual (16, FontWidths[Ord ('►')]);

    // A vertical double line reaches its cell's first and last rows, at the
    // same columns -- the property a frame stands on. The rails sit one
    // line-thickness apart, the same absolute gap the horizontal pair keeps,
    // so corners join square instead of reading as vertically stretched.
    var Words := FontGlyphs[Ord ('║')];

    AssertTrue (Words.GetInt ((0 * 16 + 5) * 4) > 0);
    AssertTrue (Words.GetInt ((31 * 16 + 5) * 4) > 0);
    AssertTrue (Words.GetInt ((0 * 16 + 9) * 4) > 0);
    AssertTrue (Words.GetInt ((31 * 16 + 9) * 4) > 0);
    AssertEqual (0, Words.GetInt ((0 * 16 + 2) * 4));
    AssertEqual (0, Words.GetInt ((0 * 16 + 13) * 4));

    CloseGraph ();
end

// -------------------------------------------------------- text mode tests --

/// The grid is logical: the classic screen in every window, scaled to fit.
test 'The Grid Is Eighty By Twenty Five Whatever The SdlWin';
begin
    CloseGraph ();
    InitGraph (1280, 800, 'grid', False);

    AssertEqual (80, TextCols ());
    AssertEqual (25, TextRows ());

    CloseGraph ();
    InitGraph (320, 200, 'small', False);

    AssertEqual (80, TextCols ());
    AssertEqual (25, TextRows ());

    CloseGraph ();
end

test 'TextMode Chooses The Grid';
begin
    CloseGraph ();
    InitGraph (320, 200, 'mode', False);

    TextMode (40, 25);

    AssertEqual (40, TextCols ());
    AssertEqual (25, TextRows ());

    // And the new grid stamps at its own size.
    Write ('A');
    AssertEqual (2, WhereX ());

    CloseGraph ();
end

/// What Turbo Pascal's TextMode did on a mode change, kept: a fresh screen.
test 'TextMode Clears Homes And Resets The Colors';
begin
    CloseGraph ();
    InitGraph (320, 200, 'reset', False);

    TextBackground (Blue);
    TextColor (Yellow);
    Write ('old');
    GotoXY (5, 3);

    TextMode (40, 25);

    AssertEqual (1, WhereX ());
    AssertEqual (1, WhereY ());

    // A stamped space shows the defaults are back: transparent background.
    Write (' ');
    AssertEqual (0, Root.Buf.GetInt (0));

    CloseGraph ();
end

test 'TextMode Refuses Nonsense And A Closed SdlWin';
begin
    CloseGraph ();

    var Message := '';

    try TextMode (80, 25); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);

    InitGraph (320, 200, 'bad', False);

    Message := '';
    try TextMode (0, 25); except on e : String do Message := e; end
    AssertEqual ('TextMode needs a positive grid.', Message);

    CloseGraph ();
end

test 'The Grid Metrics Raise When The SdlWin Is Not Open';
begin
    CloseGraph ();

    var Message := '';

    try TextCols (); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);

    Message := '';
    try Write ('x'); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);
end

test 'GotoXY Places The Cursor And WhereX Reads It Back';
begin
    CloseGraph ();
    InitGraph (320, 200, 'cursor', False);

    AssertEqual (1, WhereX ());
    AssertEqual (1, WhereY ());

    GotoXY (10, 5);

    AssertEqual (10, WhereX ());
    AssertEqual (5, WhereY ());

    CloseGraph ();
end

test 'GotoXY Refuses A Position Off The Grid';
begin
    CloseGraph ();
    InitGraph (320, 200, 'edge', False);

    var Message := '';

    try GotoXY (TextCols () + 1, 1); except on e : String do Message := e; end
    AssertEqual ('GotoXY is off the grid.', Message);

    Message := '';
    try GotoXY (0, 1); except on e : String do Message := e; end
    AssertEqual ('GotoXY is off the grid.', Message);

    // The storybook corner is valid: the count is the last index.
    GotoXY (TextCols (), TextRows ());
    AssertEqual (TextCols (), WhereX ());

    CloseGraph ();
end

test 'Write Stamps Cells And Advances The Cursor';
begin
    CloseGraph ();
    InitGraph (320, 200, 'print', False);

    Write ('AB');

    AssertEqual (3, WhereX ());
    AssertEqual (1, WhereY ());

    // Something landed in the first cell of the text layer.
    var Lit := 0;

    for var Y := 0; Y < 32; Y := Y + 1 do
        for var X := 0; X < 16; X := X + 1 do
            if Root.Buf.GetInt ((Y * Root.PxW + X) * 4) <> 0 then Lit := Lit + 1;

    AssertTrue (Lit > 0);

    CloseGraph ();
end

/// TextMode makes the wrap reachable in one short string.
test 'Write Wraps At The Last Column';
begin
    CloseGraph ();
    InitGraph (320, 200, 'wrap', False);

    TextMode (4, 2);
    Write ('ABCDE');

    AssertEqual (2, WhereX ());
    AssertEqual (2, WhereY ());

    CloseGraph ();
end

test 'WriteLn Moves To The Start Of The Next Row';
begin
    CloseGraph ();
    InitGraph (320, 200, 'line', False);

    WriteLn ('AB');

    AssertEqual (1, WhereX ());
    AssertEqual (2, WhereY ());

    WriteLn ('');

    AssertEqual (3, WhereY ());

    CloseGraph ();
end

test 'A Wide Glyph Takes Two Cells On The Grid';
begin
    CloseGraph ();
    InitGraph (320, 200, 'wide', False);

    Write ('你');

    AssertEqual (3, WhereX ());

    CloseGraph ();
end

/// Opaque white over blue: the block's core is pure ink, a spaced cell is
/// pure background, and both exact values are pinned. GetInt reads signed,
/// so an opaque pixel is its RGB minus 2^24... minus nothing else: alpha FF
/// shifts the word past the sign bit, and RGB - 16777216 is what comes back.
test 'TextColor And TextBackground Color The Cell';
begin
    CloseGraph ();
    InitGraph (320, 200, 'color', False);

    TextColor (White);
    TextBackground (Blue);
    Write ('█ ');

    // The block's centre pixel is opaque white.
    AssertEqual (-1, Root.Buf.GetInt ((16 * Root.PxW + 8) * 4));

    // The space's centre pixel is opaque blue: 0xFF0000AA.
    AssertEqual (Blue - 16777216, Root.Buf.GetInt ((16 * Root.PxW + 24) * 4));

    CloseGraph ();
end

test 'A Transparent Background Leaves The Cell Unpainted Around The Ink';
begin
    CloseGraph ();
    InitGraph (320, 200, 'clear', False);

    Write (' ');

    var Painted := 0;

    for var Y := 0; Y < 32; Y := Y + 1 do
        for var X := 0; X < 16; X := X + 1 do
            if Root.Buf.GetInt ((Y * Root.PxW + X) * 4) <> 0 then
                Painted := Painted + 1;

    AssertEqual (0, Painted);

    CloseGraph ();
end

test 'TextColor Refuses Transparent And TextBackground Refuses Nonsense';
begin
    CloseGraph ();
    InitGraph (320, 200, 'w', False);

    var Message := '';

    try TextColor (Transparent); except on e : String do Message := e; end
    AssertEqual ('TextColor cannot be transparent.', Message);

    Message := '';
    try TextBackground (-2); except on e : String do Message := e; end
    AssertEqual ('TextBackground wants a color or Transparent.', Message);
end

/// The design's one rule, as a test: text verbs touch the grid and never the
/// graphics beneath it.
test 'ClrEol Erases The Prose And Never The Chart';
begin
    CloseGraph ();
    InitGraph (320, 200, 'rule', False);

    // A graphic on the background, and prose on the grid above it.
    OutTextXY (1, 1, '████');
    var Chart := LitPixels (1, 1, 64, 32);

    AssertTrue (Chart > 0);

    Write ('ABCD');
    GotoXY (1, 1);
    ClrEol ();

    // The prose is gone from the grid...
    var Prose := 0;

    for var Y := 0; Y < 32; Y := Y + 1 do
        for var X := 0; X < 64; X := X + 1 do
            if Root.Buf.GetInt ((Y * Root.PxW + X) * 4) <> 0 then
                Prose := Prose + 1;

    AssertEqual (0, Prose);

    // ... and the chart beneath is untouched.
    AssertEqual (Chart, LitPixels (1, 1, 64, 32));

    CloseGraph ();
end

test 'ClrScr Fills The Grid With The Background And Homes The Cursor';
begin
    CloseGraph ();
    InitGraph (128, 96, 'fill', False);

    GotoXY (3, 2);
    TextBackground (Blue);
    ClrScr ();

    AssertEqual (1, WhereX ());
    AssertEqual (1, WhereY ());
    AssertEqual (Blue - 16777216, Root.Buf.GetInt ((50 * Root.PxW + 50) * 4));

    CloseGraph ();
end

/// The grid scrolls and the graphics stay put. B is printed on the last row;
/// its newline scrolls the grid, so B's pixels move up a cell while the
/// background keeps every one of its own.
test 'The Grid Scrolls And The Graphics Stay Put';
begin
    CloseGraph ();
    InitGraph (64, 64, 'scroll', False);

    OutTextXY (1, 1, '██');
    var Chart := LitPixels (1, 1, 64, 64);

    TextMode (4, 2);
    WriteLn ('A');
    WriteLn ('B');

    var TopHalf := 0;
    var LowHalf := 0;

    for var Y := 0; Y < Root.PxH div 2; Y := Y + 1 do
        for var X := 0; X < Root.PxW; X := X + 1 do
        begin
            if Root.Buf.GetInt ((Y * Root.PxW + X) * 4) <> 0 then TopHalf := TopHalf + 1;
            if Root.Buf.GetInt (((Y + Root.PxH div 2) * Root.PxW + X) * 4) <> 0 then LowHalf := LowHalf + 1;
        end

    AssertTrue (TopHalf > 0);
    AssertEqual (0, LowHalf);
    AssertEqual (Chart, LitPixels (1, 1, 64, 64));

    CloseGraph ();
end

/// The stamper is an external, so its exact values are pinned: full cover is
/// opaque ink, half cover keeps its coverage as alpha, a background paints
/// even where cover is none, and a nil glyph is a blank cell.
test 'The Cell Stamper Answers Known Values';
begin
    CloseGraph ();

    var T := Buffer (16);
    var G := Buffer (4);

    StampTarget (T.Address, 2, 2);

    G.PutInt (0, 255);
    StampCell (0, 0, G.Address, 1, 1, 1, Red, -1);
    AssertEqual (Red - 16777216, T.GetInt (0));

    G.PutInt (0, 128);
    StampCell (1, 0, G.Address, 1, 1, 1, Red, -1);
    AssertEqual (128 * 16777216 + Red - 4294967296, T.GetInt (4));

    G.PutInt (0, 0);
    StampCell (0, 1, G.Address, 1, 1, 1, Red, Blue);
    AssertEqual (Blue - 16777216, T.GetInt (8));

    StampCell (1, 1, nil, 1, 1, 1, Red, -1);
    AssertEqual (0, T.GetInt (12));
end

test 'The Scroller Answers Known Values';
begin
    CloseGraph ();

    var T := Buffer (16);

    StampTarget (T.Address, 1, 4);

    T.PutInt (0, 1);
    T.PutInt (4, 2);
    T.PutInt (8, 3);
    T.PutInt (12, 4);

    ScrollTarget (1, 9);

    AssertEqual (2, T.GetInt (0));
    AssertEqual (3, T.GetInt (4));
    AssertEqual (4, T.GetInt (8));
    AssertEqual (9, T.GetInt (12));
end

test 'HighVideo Brightens The Ink And LowVideo Dims It';
begin
    CloseGraph ();
    InitGraph (320, 200, 'w', False);

    TextColor (Blue);
    HighVideo ();
    AssertEqual (LightBlue, Root.Ink);

    // Idempotent on the palette, as the intensity bit was.
    HighVideo ();
    AssertEqual (LightBlue, Root.Ink);

    LowVideo ();
    AssertEqual (Blue, Root.Ink);

    LowVideo ();
    AssertEqual (Blue, Root.Ink);
end

/// The adapter's odd couple: brown's bright partner is yellow, not a
/// brighter brown.
test 'HighVideo Sends Brown To Yellow And Back';
begin
    CloseGraph ();
    InitGraph (320, 200, 'w', False);

    TextColor (Brown);
    HighVideo ();
    AssertEqual (Yellow, Root.Ink);

    LowVideo ();
    AssertEqual (Brown, Root.Ink);
end

/// Off the palette there is no intensity bit, so the 24-bit reading is
/// halfway toward white or black -- exact values pinned.
test 'Off The Palette The Videos Move Halfway';
begin
    CloseGraph ();
    InitGraph (320, 200, 'w', False);

    TextColor (8405024);          // 0x804020
    HighVideo ();
    AssertEqual (12558223, Root.Ink);   // 0xBF9F8F

    TextColor (8405024);
    LowVideo ();
    AssertEqual (4202512, Root.Ink);    // 0x402010
end

test 'NormVideo Restores The Startup Colors';
begin
    CloseGraph ();
    InitGraph (320, 200, 'w', False);

    TextColor (Yellow);
    TextBackground (Blue);

    NormVideo ();

    AssertEqual (LightGray, Root.Ink);
    AssertEqual (Transparent, Root.Back);
end

// ------------------------------------------------------------ blink tests --

test 'Blink Rides Bit Twenty Four Of TextColor';
begin
    CloseGraph ();
    InitGraph (320, 200, 'w', False);

    AssertEqual (16777216, Blink);

    TextColor (LightRed + Blink);
    AssertEqual (LightRed, Root.Ink);
    AssertTrue (Root.Blinking);

    // Without the flag, blinking ends -- the bit is per-color, as TP's was.
    TextColor (LightRed);
    AssertTrue (not Root.Blinking);

    NormVideo ();
end

test 'TextColor Refuses A Color Past Blink';
begin
    CloseGraph ();
    InitGraph (320, 200, 'w', False);

    var Message := '';

    try TextColor (Blink + Blink); except on e : String do Message := e; end
    AssertEqual ('TextColor wants an RGB color, plus Blink at most.', Message);

    NormVideo ();
end

/// The letters vanish and the cell stays: ink on the blink layer, background
/// on the text layer.
test 'A Blinking Glyph Keeps Its Ink On The Blink Layer';
begin
    CloseGraph ();
    InitGraph (320, 200, 'blink', False);

    TextBackground (Blue);
    TextColor (White + Blink);
    Write ('█');

    // The text layer's cell is pure background -- the white went elsewhere.
    AssertEqual (Blue - 16777216, Root.Buf.GetInt ((16 * Root.PxW + 8) * 4));

    // The blink layer holds the ink, opaque white.
    AssertEqual (-1, Root.BBuf.GetInt ((16 * Root.PxW + 8) * 4));

    CloseGraph ();
end

test 'A Steady Stamp Clears The Blink Beneath It';
begin
    CloseGraph ();
    InitGraph (320, 200, 'steady', False);

    TextColor (White + Blink);
    Write ('█');

    GotoXY (1, 1);
    TextColor (White);
    Write (' ');

    AssertEqual (0, Root.BBuf.GetInt ((16 * Root.PxW + 8) * 4));

    CloseGraph ();
end

test 'ClrScr Clears The Blink Layer Too';
begin
    CloseGraph ();
    InitGraph (320, 200, 'clear', False);

    TextColor (White + Blink);
    Write ('██');
    ClrScr ();

    var Lit := 0;

    for var Y := 0; Y < 32; Y := Y + 1 do
        for var X := 0; X < 32; X := X + 1 do
            if Root.BBuf.GetInt ((Y * Root.PxW + X) * 4) <> 0 then Lit := Lit + 1;

    AssertEqual (0, Lit);

    CloseGraph ();
end

test 'Scrolling Carries The Blink Layer Along';
begin
    CloseGraph ();
    InitGraph (320, 200, 'bscroll', False);

    TextMode (4, 2);
    TextColor (White + Blink);
    WriteLn ('');
    WriteLn ('█');           // stamped on the last row, then scrolled up

    // The ink now sits in the top half of the blink layer.
    var Top := 0;

    for var Y := 0; Y < Root.PxH div 2; Y := Y + 1 do
        for var X := 0; X < 16; X := X + 1 do
            if Root.BBuf.GetInt ((Y * Root.PxW + X) * 4) <> 0 then Top := Top + 1;

    AssertTrue (Top > 0);

    CloseGraph ();
end

test 'NormVideo And TextMode End Blinking';
begin
    CloseGraph ();
    InitGraph (320, 200, 'end', False);

    TextColor (White + Blink);
    NormVideo ();
    AssertTrue (not Root.Blinking);

    TextColor (White + Blink);
    TextMode (40, 25);
    Write ('');                        // TextMode rebuilt the root lazily
    AssertTrue (not Root.Blinking);

    CloseGraph ();
end

test 'SetBlinkRate Chooses The Cadence';
begin
    CloseGraph ();
    InitGraph (320, 200, 'cadence', False);

    AssertEqual (267, BlinkPhaseMs);

    SetBlinkRate (533);
    AssertEqual (533, BlinkPhaseMs);

    // Mode and attribute resets leave the cadence alone...
    TextMode (80, 25);
    NormVideo ();
    AssertEqual (533, BlinkPhaseMs);

    // ... and a fresh window restores the adapter's own.
    CloseGraph ();
    InitGraph (320, 200, 'rate', False);
    AssertEqual (267, BlinkPhaseMs);

    CloseGraph ();
end

test 'SetBlinkRate Refuses A Time That Is Not Positive';
begin
    var Message := '';

    try SetBlinkRate (0); except on e : String do Message := e; end
    AssertEqual ('SetBlinkRate needs a positive time.', Message);

    Message := '';
    try SetBlinkRate (-100); except on e : String do Message := e; end
    AssertEqual ('SetBlinkRate needs a positive time.', Message);
end

// ------------------------------------------------------------ input tests --

/// KEYDOWN and QUIT go through SDL's real queue; only TEXTINPUT is fed to
/// the decoder directly, because pushing one crashes the sdl2-compat layer.
test 'A Pushed Arrow Comes Back As Its Constant';
begin
    CloseGraph ();
    InitGraph (320, 200, 'keys', False);

    var E := Buffer (64);

    E.PutInt (0, 768);
    E.PutInt (20, 1073741906);
    SDL_PushEvent (E.Address);

    AssertEqual (KeyUp, ReadKey ());

    CloseGraph ();
end

test 'KeyPressed Sees A Key Without Consuming It';
begin
    CloseGraph ();
    InitGraph (320, 200, 'peek', False);

    AssertTrue (not KeyPressed ());

    var E := Buffer (64);

    E.PutInt (0, 768);
    E.PutInt (20, 1073741882);
    SDL_PushEvent (E.Address);

    AssertTrue (KeyPressed ());
    AssertTrue (KeyPressed ());
    AssertEqual (KeyF1, ReadKey ());
    AssertTrue (not KeyPressed ());

    CloseGraph ();
end

test 'ReadKey Answers Keys In The Order They Arrived';
begin
    CloseGraph ();
    InitGraph (320, 200, 'order', False);

    var E := Buffer (64);

    E.PutInt (0, 768);
    E.PutInt (20, 1073741882);        // F1
    SDL_PushEvent (E.Address);
    E.PutInt (20, 13);                // Enter
    SDL_PushEvent (E.Address);
    E.PutInt (20, 127);               // Delete
    SDL_PushEvent (E.Address);

    AssertEqual (KeyF1, ReadKey ());
    AssertEqual (#13, ReadKey ());
    AssertEqual (KeyDelete, ReadKey ());

    CloseGraph ();
end

test 'A Control Letter Arrives As Its Low Character';
begin
    CloseGraph ();
    InitGraph (320, 200, 'ctrl', False);

    var E := Buffer (64);

    E.PutInt (0, 768);
    E.PutInt (20, 97);
    E.PutInt (24, 64);                // left Ctrl held
    SDL_PushEvent (E.Address);

    AssertEqual (Char (1), ReadKey ());

    CloseGraph ();
end

/// A plain letter keydown carries no layout or shift; the text channel owns
/// letters, so the keydown is ignored and nothing arrives twice.
test 'A Plain Letter Keydown Is Ignored';
begin
    CloseGraph ();
    InitGraph (320, 200, 'plain', False);

    var E := Buffer (64);

    E.PutInt (0, 768);
    E.PutInt (20, 97);
    SDL_PushEvent (E.Address);

    AssertTrue (not KeyPressed ());

    CloseGraph ();
end

test 'The Close Button Arrives As KeyClose';
begin
    CloseGraph ();
    InitGraph (320, 200, 'close', False);

    var E := Buffer (64);

    E.PutInt (0, 256);
    SDL_PushEvent (E.Address);

    AssertEqual (KeyClose, ReadKey ());

    CloseGraph ();
end

/// The decoder, fed crafted bytes: one ASCII, one two-byte, one three-byte
/// and one four-byte codepoint, each a single Char.
test 'Text Arrives Decoded From UTF Eight';
begin
    CloseGraph ();
    InitGraph (320, 200, 'text', False);

    var E := Buffer (64);

    // One contiguous UTF-8 run -- a zero byte is the decoder's terminator,
    // so the codepoints must pack with no gaps between the words.
    E.PutInt (12, -458636447);
    E.PutInt (16, -1611620163);
    E.PutInt (20, 33433);

    TakeTextEvent (E);

    AssertEqual (97, Ord (ReadKey ()));
    AssertEqual (233, Ord (ReadKey ()));
    AssertEqual (20320, Ord (ReadKey ()));
    AssertEqual (128578, Ord (ReadKey ()));

    CloseGraph ();
end

test 'A Fresh SdlWin Starts With An Empty Queue';
begin
    CloseGraph ();
    InitGraph (320, 200, 'stale', False);

    var E := Buffer (64);

    E.PutInt (0, 768);
    E.PutInt (20, 1073741882);
    SDL_PushEvent (E.Address);
    PumpKeys ();

    CloseGraph ();
    InitGraph (320, 200, 'fresh', False);

    AssertTrue (not KeyPressed ());

    CloseGraph ();
end

test 'Input Raises When The SdlWin Is Not Open';
begin
    CloseGraph ();

    var Message := '';

    try KeyPressed (); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);

    Message := '';
    try ReadKey (); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);
end

// ---------------------------------------------------------- surface tests --

test 'A Window Validates Its Rectangle Its Order And The Screen';
begin
    CloseGraph ();

    var Message := '';

    try Window (1, 1, 10, 5, 1); except on e : String do Message := e; end
    AssertEqual ('Graph is not open.', Message);

    InitGraph (320, 200, 'make', False);

    Message := '';
    try Window (1, 1, 10, 5, 0); except on e : String do Message := e; end
    AssertEqual ('Order 0 is the screen''s.', Message);

    Message := '';
    try Window (5, 1, 4, 5, 1); except on e : String do Message := e; end
    AssertEqual ('Window wants 1 <= X1 <= X2 and 1 <= Y1 <= Y2.', Message);

    CloseGraph ();
end

test 'Each Window Has Its Own Cursor And Colors';
begin
    CloseGraph ();
    InitGraph (320, 200, 'own', False);

    var A := Window (1, 1, 10, 5, 1);
    var B := Window (11, 1, 20, 5, 2);

    A.GotoXY (3, 2);
    A.TextColor (Yellow);
    B.TextColor (Cyan);

    AssertEqual (3, A.WhereX ());
    AssertEqual (1, B.WhereX ());
    AssertEqual (Yellow, A.Ink);
    AssertEqual (Cyan, B.Ink);

    // And the screen's own cursor is a third, untouched party.
    AssertEqual (1, WhereX ());

    CloseGraph ();
end

test 'A Window Writes Into Its Own Cells And Not The Screen''s';
begin
    CloseGraph ();
    InitGraph (320, 200, 'cells', False);

    var A := Window (2, 2, 11, 4, 1);

    A.Write ('X');

    var Own := 0;

    for var Y := 0; Y < 32; Y := Y + 1 do
        for var X := 0; X < 16; X := X + 1 do
            if A.Buf.GetInt ((Y * A.PxW + X) * 4) <> 0 then Own := Own + 1;

    AssertTrue (Own > 0);
    AssertEqual (2, A.WhereX ());

    // The root grid never woke: no screen text verb has run.
    AssertTrue (Root = nil);

    CloseGraph ();
end

/// A window is a terminal of its own: it wraps at ITS last column and
/// scrolls ITS cells at its bottom row.
test 'A Window Wraps And Scrolls Within Its Own Walls';
begin
    CloseGraph ();
    InitGraph (320, 200, 'walls', False);

    var A := Window (3, 3, 6, 4, 1);        // 4 cols, 2 rows

    A.Write ('ABCDE');

    AssertEqual (2, A.WhereX ());
    AssertEqual (2, A.WhereY ());

    A.WriteLn ('');
    A.Write ('F');

    // The scroll happened in A's buffer: its lower half is now background.
    var Low := 0;

    for var Y := A.PxH div 2; Y < A.PxH; Y := Y + 1 do
        for var X := 0; X < A.PxW; X := X + 1 do
            if A.Buf.GetInt ((Y * A.PxW + X) * 4) <> 0 then Low := Low + 1;

    AssertTrue (Low > 0);                    // the F just stamped there

    CloseGraph ();
end

test 'MoveTo Drags A Window Preserving Its Size';
begin
    CloseGraph ();
    InitGraph (320, 200, 'drag', False);

    var A := Window (5, 5, 14, 9, 1);

    A.MoveTo (30, 2);

    AssertEqual (30, A.X1);
    AssertEqual (2, A.Y1);
    AssertEqual (39, A.X2);
    AssertEqual (6, A.Y2);

    // Off the grid is allowed: a window may be dragged out of view.
    A.MoveTo (-3, -1);

    AssertEqual (-3, A.X1);
    AssertEqual (10, A.Cols);

    CloseGraph ();
end

test 'A Window''s Blink Ink Lives In Its Own Blink Buffer';
begin
    CloseGraph ();
    InitGraph (320, 200, 'wblink', False);

    var A := Window (1, 1, 10, 3, 1);

    A.TextColor (White + Blink);
    A.Write ('█');

    AssertEqual (-1, A.BBuf.GetInt ((16 * A.PxW + 8) * 4));

    CloseGraph ();
end

/// The rule, across surfaces: a window's text verbs cannot reach a chart on
/// another surface, however they overlap on screen.
test 'ClrScr On A Window Leaves A ViewPort''s Pixels Alone';
begin
    CloseGraph ();
    InitGraph (320, 200, 'rule2', False);

    var V := ViewPort (1, 1, 40, 40, 2);

    V.PutPixel (5, 5, Red);

    var A := Window (1, 1, 10, 3, 3);

    A.TextBackground (Blue);
    A.ClrScr ();

    AssertEqual (Red - 16777216, V.Buf.GetInt ((4 * 40 + 4) * 4));

    CloseGraph ();
end

test 'InstallUserFont Rebuilds Live Windows At The New Cell Size';
begin
    CloseGraph ();
    InitGraph (320, 200, 'rebuild', False);

    var A := Window (1, 1, 10, 3, 1);

    AssertEqual (3 * 32, A.PxH);

    InstallUserFont ('romfont.hex');

    AssertEqual (3 * 16, A.PxH);
    AssertEqual (10 * 8, A.PxW);

    InstallUserFont ('graphfont.hex');

    AssertEqual (3 * 32, A.PxH);

    CloseGraph ();
end

test 'CloseGraph Invalidates Every Surface';
begin
    CloseGraph ();
    InitGraph (320, 200, 'die', False);

    var A := Window (1, 1, 10, 3, 1);
    var V := ViewPort (1, 1, 20, 20, 2);

    CloseGraph ();

    var Message := '';

    try A.Write ('x'); except on e : String do Message := e; end
    AssertEqual ('CloseGraph has closed this surface.', Message);

    Message := '';
    try V.PutPixel (1, 1, Red); except on e : String do Message := e; end
    AssertEqual ('CloseGraph has closed this surface.', Message);
end

test 'A ViewPort Validates And Paints Exact Pixels';
begin
    CloseGraph ();
    InitGraph (320, 200, 'port', False);

    var Message := '';

    try ViewPort (1, 1, 0, 5, 1); except on e : String do Message := e; end
    AssertEqual ('ViewPort needs a positive size.', Message);

    var V := ViewPort (10, 10, 8, 8, 1);

    V.PutPixel (1, 1, White);
    V.PutPixel (8, 8, Blue);
    V.PutPixel (9, 9, Red);              // off the edge: clipped, silent

    AssertEqual (-1, V.Buf.GetInt (0));
    AssertEqual (Blue - 16777216, V.Buf.GetInt ((7 * 8 + 7) * 4));

    CloseGraph ();
end

test 'A ViewPort Draws Free Text And Advances Its Position';
begin
    CloseGraph ();
    InitGraph (320, 200, 'vtext', False);

    var V := ViewPort (1, 1, 100, 40, 1);

    V.OutText ('AB');

    AssertEqual (1 + GlyphWidthOf (Ord ('A')) + GlyphWidthOf (Ord ('B')), V.CurX);

    var Lit := 0;

    for var Y := 0; Y < 32; Y := Y + 1 do
        for var X := 0; X < 32; X := X + 1 do
            if V.Buf.GetInt ((Y * 100 + X) * 4) <> 0 then Lit := Lit + 1;

    AssertTrue (Lit > 0);

    CloseGraph ();
end

test 'Order And Alpha Are Assignable And Ties Stack By Creation';
begin
    CloseGraph ();
    InitGraph (320, 200, 'stack', False);

    var A := ViewPort (1, 1, 8, 8, 5);
    var B := ViewPort (1, 1, 8, 8, 5);

    AssertTrue (B.Serial > A.Serial);

    A.Order := -2;
    A.Alpha := 128;

    AssertEqual (-2, A.Order);
    AssertEqual (128, A.Alpha);

    CloseGraph ();
end

test 'TextMode Keeps The Other Surfaces';
begin
    CloseGraph ();
    InitGraph (320, 200, 'keepers', False);

    Write ('wake the root');

    var V := ViewPort (1, 1, 8, 8, 1);

    V.PutPixel (2, 2, Green);
    TextMode (40, 25);

    AssertEqual (Green - 16777216, V.Buf.GetInt ((1 * 8 + 1) * 4));
    AssertEqual (1, Surfaces.Length);       // the root went, the port stayed

    Write ('');
    AssertEqual (2, Surfaces.Length);       // and the root came back lazily

    CloseGraph ();
end

/// The bug a window's own border found: a line that exactly fills the bottom
/// row must not scroll the window the instant it is drawn. Text mode always
/// deferred the wrap to the next character, and so does this.
test 'Filling The Last Row Does Not Scroll Until Something Else Is Written';
begin
    CloseGraph ();
    InitGraph (320, 200, 'lazy', False);

    var A := Window (1, 1, 4, 3, 1);

    A.GotoXY (1, 1);
    A.Write ('TTTT');                  // the top border, exactly four wide

    A.GotoXY (1, 3);
    A.Write ('BBBB');                  // the bottom border, filling the row

    // Nothing scrolled: the top row still holds what was put there.
    var Top := 0;

    for var Y := 0; Y < 32; Y := Y + 1 do
        for var X := 0; X < A.PxW; X := X + 1 do
            if A.Buf.GetInt ((Y * A.PxW + X) * 4) <> 0 then Top := Top + 1;

    AssertTrue (Top > 0);

    // The cursor rests on the last column with the wrap owed.
    AssertEqual (4, A.WhereX ());
    AssertEqual (3, A.WhereY ());
    AssertTrue (A.Pending);

    CloseGraph ();
end

test 'The Deferred Wrap Happens On The Next Character';
begin
    CloseGraph ();
    InitGraph (320, 200, 'defer', False);

    var A := Window (1, 1, 4, 3, 1);

    A.Write ('ABCD');

    AssertEqual (4, A.WhereX ());
    AssertEqual (1, A.WhereY ());

    A.Write ('E');

    AssertEqual (2, A.WhereX ());
    AssertEqual (2, A.WhereY ());

    CloseGraph ();
end

/// Moving the cursor deliberately cancels a wrap that was owed.
test 'GotoXY And ClrScr Cancel A Pending Wrap';
begin
    CloseGraph ();
    InitGraph (320, 200, 'cancel', False);

    var A := Window (1, 1, 4, 3, 1);

    A.Write ('ABCD');
    AssertTrue (A.Pending);

    A.GotoXY (2, 2);
    AssertTrue (not A.Pending);

    A.Write ('ABC');
    A.ClrScr ();
    AssertTrue (not A.Pending);
    AssertEqual (1, A.WhereX ());

    CloseGraph ();
end

/// And the screen's own grid has the same manners, through the same code.
test 'The Screen Grid Defers Its Wrap Too';
begin
    CloseGraph ();
    InitGraph (320, 200, 'screen', False);

    TextMode (4, 2);
    Write ('ABCD');

    AssertEqual (4, WhereX ());
    AssertEqual (1, WhereY ());

    Write ('E');

    AssertEqual (2, WhereX ());
    AssertEqual (2, WhereY ());

    CloseGraph ();
end

// ------------------------------------------------------ text style tests --

test 'SetTextStyle Refuses A Turn That Is Not A Quarter';
begin
    CloseGraph ();
    InitGraph (320, 200, 'style', False);

    var V := ViewPort (1, 1, 100, 100, 1);
    var Message := '';

    try V.SetTextStyle (45, 1); except on e : String do Message := e; end
    AssertEqual ('SetTextStyle wants 0, 90, 180 or 270 degrees.', Message);

    Message := '';
    try V.SetTextStyle (0, 0); except on e : String do Message := e; end
    AssertEqual ('SetTextStyle needs a CharSize of 1 or more.', Message);

    // The four turns are all accepted.
    for var D in [0, 90, 180, 270] do
    begin
        V.SetTextStyle (D, 2);

        AssertEqual (D, V.Dir);
    end

    AssertEqual (2, V.Size);

    CloseGraph ();
end

/// A doubled glyph covers four times the pixels of a single one, which is
/// the whole of what CharSize means.
test 'CharSize Magnifies A Glyph By Whole Numbers';
begin
    CloseGraph ();
    InitGraph (320, 200, 'size', False);

    var One := ViewPort (1, 1, 200, 100, 1);
    var Two := ViewPort (1, 1, 200, 100, 2);

    One.OutTextXY (1, 1, 'A');

    Two.SetTextStyle (0, 2);
    Two.OutTextXY (1, 1, 'A');

    var LitOne := 0;
    var LitTwo := 0;

    for var Y := 0; Y < 100; Y := Y + 1 do
        for var X := 0; X < 200; X := X + 1 do
        begin
            if One.Buf.GetInt ((Y * 200 + X) * 4) <> 0 then LitOne := LitOne + 1;
            if Two.Buf.GetInt ((Y * 200 + X) * 4) <> 0 then LitTwo := LitTwo + 1;
        end

    AssertEqual (4 * LitOne, LitTwo);

    CloseGraph ();
end

/// A quarter turn counterclockwise sends the glyph's top edge to the left:
/// the pixel at the source's top-right lands at the destination's top-left.
test 'A Quarter Turn Puts The Glyph On Its Side';
begin
    CloseGraph ();
    InitGraph (320, 200, 'turn', False);

    var Flat := ViewPort (1, 1, 100, 100, 1);
    var Side := ViewPort (1, 1, 100, 100, 2);

    // A full block fills its cell, so its footprint shows the turn plainly:
    // 16 wide by 32 tall upright, 32 by 16 on its side.
    Flat.OutTextXY (1, 1, '█');

    Side.SetTextStyle (90, 1);
    Side.OutTextXY (1, 1, '█');           // the turned box is anchored here too

    var FlatW := 0;
    var SideW := 0;

    for var X := 0; X < 100; X := X + 1 do
    begin
        if Flat.Buf.GetInt ((0 * 100 + X) * 4) <> 0 then FlatW := FlatW + 1;
        if Side.Buf.GetInt ((0 * 100 + X) * 4) <> 0 then SideW := SideW + 1;
    end

    AssertEqual (16, FlatW);
    AssertEqual (32, SideW);

    CloseGraph ();
end

/// Each turn advances along its own axis: right, up, left, down.
test 'The Advance Follows The Turn';
begin
    CloseGraph ();
    InitGraph (320, 200, 'advance', False);

    var V := ViewPort (1, 1, 200, 200, 1);
    var Wide := GlyphWidthOf (Ord ('A'));

    V.CurX := 100;
    V.CurY := 100;
    V.SetTextStyle (0, 1);
    V.OutText ('A');
    AssertEqual (100 + Wide, V.CurX);
    AssertEqual (100, V.CurY);

    V.CurX := 100;
    V.CurY := 100;
    V.SetTextStyle (90, 1);
    V.OutText ('A');
    AssertEqual (100, V.CurX);
    AssertEqual (100 - Wide, V.CurY);

    V.CurX := 100;
    V.CurY := 100;
    V.SetTextStyle (180, 1);
    V.OutText ('A');
    AssertEqual (100 - Wide, V.CurX);

    V.CurX := 100;
    V.CurY := 100;
    V.SetTextStyle (270, 2);
    V.OutText ('A');
    AssertEqual (100 + 2 * Wide, V.CurY);

    CloseGraph ();
end

/// The style is the viewport's own, and the grid never inherits it: a
/// magnified viewport must not leave the screen's cells double-sized.
test 'A Viewport''s Style Does Not Leak To The Grid';
begin
    CloseGraph ();
    InitGraph (320, 200, 'leak', False);

    var V := ViewPort (1, 1, 100, 100, 1);

    V.SetTextStyle (90, 3);
    V.OutTextXY (1, 90, 'X');

    // The grid stamps its cell 1:1 and upright afterward: one cell wide.
    Write ('A');

    AssertEqual (2, WhereX ());

    var Row := 0;

    for var X := 0; X < Root.PxW; X := X + 1 do
        if Root.Buf.GetInt ((10 * Root.PxW + X) * 4) <> 0 then Row := Row + 1;

    AssertTrue (Row > 0);
    AssertTrue (Row <= 16);

    CloseGraph ();
end

// ------------------------------------------------------------- line tests --

/// A solid horizontal line paints exactly the pixels between its ends --
/// no more, which a fencepost error would betray at once.
test 'A Line Paints Exactly The Pixels Between Its Ends';
begin
    CloseGraph ();
    InitGraph (320, 200, 'line', False);

    var V := ViewPort (1, 1, 200, 200, 1);

    V.SetColor (Red);
    V.Line (10, 10, 109, 10);

    var Lit := 0;

    for var X := 0; X < 200; X := X + 1 do
        if V.Buf.GetInt ((9 * 200 + X) * 4) <> 0 then Lit := Lit + 1;

    AssertEqual (100, Lit);
    AssertEqual (Red - 16777216, V.Buf.GetInt ((9 * 200 + 9) * 4));

    CloseGraph ();
end

test 'A Line Leaves The Pen At Its Far End';
begin
    CloseGraph ();
    InitGraph (320, 200, 'pen', False);

    var V := ViewPort (1, 1, 200, 200, 1);

    V.Line (10, 10, 60, 40);

    AssertEqual (60, V.GetX ());
    AssertEqual (40, V.GetY ());

    CloseGraph ();
end

test 'PenTo And LineTo Draw From Where The Pen Was';
begin
    CloseGraph ();
    InitGraph (320, 200, 'moveto', False);

    var V := ViewPort (1, 1, 200, 200, 1);

    V.PenTo (20, 20);

    AssertEqual (20, V.GetX ());
    AssertEqual (0, V.Buf.GetInt ((19 * 200 + 19) * 4));   // PenTo draws nothing

    V.LineTo (40, 20);

    AssertTrue (V.Buf.GetInt ((19 * 200 + 19) * 4) <> 0);
    AssertEqual (40, V.GetX ());

    V.PenRel (0, 10);
    AssertEqual (40, V.GetX ());
    AssertEqual (30, V.GetY ());

    V.LineRel (-20, 0);
    AssertEqual (20, V.GetX ());
    AssertEqual (30, V.GetY ());

    CloseGraph ();
end

/// The pattern is walked one bit to the pixel, so a dotted line of a
/// hundred paints the half its pattern sets.
test 'A Styled Line Paints Fewer Pixels Than A Solid One';
begin
    CloseGraph ();
    InitGraph (320, 200, 'style2', False);

    var V := ViewPort (1, 1, 200, 200, 1);

    V.SetLineStyle (DottedLn, 0, NormWidth);
    V.Line (10, 10, 109, 10);

    var Dots := 0;

    for var X := 0; X < 200; X := X + 1 do
        if V.Buf.GetInt ((9 * 200 + X) * 4) <> 0 then Dots := Dots + 1;

    AssertEqual (50, Dots);

    // A user pattern of all ones is a solid line by another road.
    var W := ViewPort (1, 1, 200, 200, 2);

    W.SetLineStyle (UserBitLn, 65535, NormWidth);
    W.Line (10, 10, 109, 10);

    var Full := 0;

    for var X := 0; X < 200; X := X + 1 do
        if W.Buf.GetInt ((9 * 200 + X) * 4) <> 0 then Full := Full + 1;

    AssertEqual (100, Full);

    CloseGraph ();
end

/// Thickness spreads across the axis the line runs LEAST along, so a
/// horizontal line thickens downward and a vertical one sideways.
test 'Thickness Spreads Across The Line''s Minor Axis';
begin
    CloseGraph ();
    InitGraph (320, 200, 'thick', False);

    var V := ViewPort (1, 1, 200, 200, 1);

    V.SetLineStyle (SolidLn, 0, ThickWidth);
    V.Line (10, 50, 109, 50);

    var Rows := 0;

    for var Y := 0; Y < 200; Y := Y + 1 do
        if V.Buf.GetInt ((Y * 200 + 50) * 4) <> 0 then Rows := Rows + 1;

    AssertEqual (3, Rows);

    V.Line (150, 10, 150, 109);

    // A row the vertical line crosses and the horizontal one does not --
    // row 50 would count both and answer 103.
    var Cols := 0;

    for var X := 0; X < 200; X := X + 1 do
        if V.Buf.GetInt ((15 * 200 + X) * 4) <> 0 then Cols := Cols + 1;

    AssertEqual (3, Cols);

    CloseGraph ();
end

test 'A Line Is Clipped At The Viewport''s Edges';
begin
    CloseGraph ();
    InitGraph (320, 200, 'clipline', False);

    var V := ViewPort (1, 1, 50, 50, 1);

    // Well outside in both directions: clipped, not fatal.
    V.Line (-100, -100, 200, 200);
    V.Line (-50, 25, 300, 25);

    var Row := 0;

    for var X := 0; X < 50; X := X + 1 do
        if V.Buf.GetInt ((24 * 50 + X) * 4) <> 0 then Row := Row + 1;

    AssertEqual (50, Row);

    CloseGraph ();
end

test 'Rectangle Draws Four Sides And Returns The Pen';
begin
    CloseGraph ();
    InitGraph (320, 200, 'rect', False);

    var V := ViewPort (1, 1, 100, 100, 1);

    V.Rectangle (10, 10, 60, 40);

    // The four corners are painted...
    AssertTrue (V.Buf.GetInt ((9 * 100 + 9) * 4) <> 0);
    AssertTrue (V.Buf.GetInt ((9 * 100 + 59) * 4) <> 0);
    AssertTrue (V.Buf.GetInt ((39 * 100 + 9) * 4) <> 0);
    AssertTrue (V.Buf.GetInt ((39 * 100 + 59) * 4) <> 0);

    // ... the middle is not ...
    AssertEqual (0, V.Buf.GetInt ((25 * 100 + 30) * 4));

    // ... and the pen ended where it began.
    AssertEqual (10, V.GetX ());
    AssertEqual (10, V.GetY ());

    CloseGraph ();
end

test 'SetColor Governs Free Text As Well As Lines';
begin
    CloseGraph ();
    InitGraph (320, 200, 'ink', False);

    var V := ViewPort (1, 1, 200, 100, 1);

    V.SetColor (Green);
    V.OutTextXY (1, 1, '█');

    AssertEqual (Green - 16777216, V.Buf.GetInt ((16 * 200 + 8) * 4));

    CloseGraph ();
end

test 'The Pen Verbs Refuse What They Should';
begin
    CloseGraph ();
    InitGraph (320, 200, 'refuse2', False);

    var V := ViewPort (1, 1, 100, 100, 1);
    var Message := '';

    try V.SetColor (-1); except on e : String do Message := e; end
    AssertEqual ('SetColor wants an RGB color.', Message);

    Message := '';
    try V.SetLineStyle (9, 0, 1); except on e : String do Message := e; end
    AssertEqual ('SetLineStyle wants a known style.', Message);

    Message := '';
    try V.SetLineStyle (SolidLn, 0, 0); except on e : String do Message := e; end
    AssertEqual ('SetLineStyle needs a thickness of 1 or more.', Message);

    CloseGraph ();
end

/// The two complaints a chart inside a window found: a viewport placed in
/// raw screen pixels neither lined up with the window's cells nor stayed
/// inside them. Both surfaces live in one logical space now, so a viewport
/// placed against a window's cells holds that place at any window size.
test 'The Cell Metrics Place A Viewport Against A Window';
begin
    CloseGraph ();
    InitGraph (640, 480, 'align', False);

    AssertEqual (16, CellWidth ());
    AssertEqual (32, CellHeight ());

    var W := Window (4, 5, 38, 20, 1);

    // The window's own top-left, in the space a viewport is placed in.
    AssertEqual (3 * 16, W.PixelLeft ());
    AssertEqual (4 * 32, W.PixelTop ());

    // A viewport one cell inside it, sized to the frame's interior.
    var V := ViewPort (W.PixelLeft () + CellWidth (), W.PixelTop () + CellHeight (),
                       (W.Cols - 2) * CellWidth (), (W.Rows - 2) * CellHeight (), 2);

    AssertEqual (64, V.X);
    AssertEqual (160, V.Y);
    AssertEqual (33 * 16, V.W);
    AssertEqual (14 * 32, V.H);

    CloseGraph ();
end

/// The alignment must survive the window it is shown in changing size,
/// which is what putting both surfaces in the logical space buys.
test 'A Viewport Holds Its Place Against A Window At Any Window Size';
begin
    for var Size in [[640, 480], [1280, 800], [320, 200]] do
    begin
        CloseGraph ();
        InitGraph (Size[0], Size[1], 'sizes', False);

        var W := Window (10, 4, 30, 12, 1);
        var V := ViewPort (W.PixelLeft (), W.PixelTop (),
                           W.Cols * CellWidth (), W.Rows * CellHeight (), 2);

        // Same logical rectangle, whatever the physical window.
        AssertEqual (9 * 16, V.X);
        AssertEqual (3 * 32, V.Y);
        AssertEqual (21 * 16, V.W);
        AssertEqual (9 * 32, V.H);
    end

    CloseGraph ();
end

/// And what a viewport draws stays inside it, however far the line reaches.
test 'A Viewport Clips What Reaches Past Its Edges';
begin
    CloseGraph ();
    InitGraph (640, 480, 'clips', False);

    var V := ViewPort (100, 100, 60, 40, 1);

    V.SetColor (White);
    V.SetLineStyle (SolidLn, 0, ThickWidth);

    // A fan far past every edge, as the demo's does.
    for var A := 0; A < 12; A := A + 1 do
    begin
        V.PenTo (30, 20);
        V.LineTo (30 + Trunc (400.0 * Cos (A / 6.0 * Pi)),
                  20 - Trunc (400.0 * Sin (A / 6.0 * Pi)));
    end

    // Every painted pixel is inside the buffer, and the buffer is exactly
    // the viewport: nothing can have reached the surface beneath it.
    var Painted := 0;

    for var I := 0; I < 60 * 40; I := I + 1 do
        if V.Buf.GetInt (I * 4) <> 0 then Painted := Painted + 1;

    AssertTrue (Painted > 0);
    AssertTrue (Painted <= 60 * 40);

    CloseGraph ();
end

/// The reference documents these parameter names, and Algol-24 has named
/// arguments -- so a caller may write them, and they must be real.
test 'The Documented Parameter Names Are The Real Ones';
begin
    CloseGraph ();
    InitGraph (640, 480, 'named', False);

    var W := Window (X1: 4, Y1: 5, X2: 38, Y2: 20, Order: 1);

    AssertEqual (4, W.X1);
    AssertEqual (35, W.Cols);
    AssertEqual (1, W.Order);

    var V := ViewPort (X: 10, Y: 20, W: 100, H: 50, Order: 2);

    AssertEqual (10, V.X);
    AssertEqual (100, V.W);
    AssertEqual (2, V.Order);

    V.SetLineStyle (Style: DashedLn, Pattern: 0, Thickness: ThickWidth);

    AssertEqual (DashedLn, V.Style);
    AssertEqual (3, V.Thick);

    V.Line (X1: 1, Y1: 1, X2: 20, Y2: 1);

    AssertEqual (20, V.GetX ());

    V.Rectangle (X1: 2, Y1: 2, X2: 8, Y2: 8);

    AssertEqual (2, V.GetX ());

    CloseGraph ();
end

/// The screen's Write shadows the built-in for any program that says
/// `uses graph`, which is the intent -- and the console is still reachable
/// under its own unit's name, which is what makes that safe.
test 'System Write Reaches The Console While A Window Is Open';
begin
    CloseGraph ();
    InitGraph (320, 200, 'system', False);

    // Ours writes cells...
    Write ('to the grid');

    AssertEqual (12, WhereX ());

    // ... and System's writes nothing to them.
    var Before := WhereX ();

    System.Write ('');
    System.WriteLn ('');

    AssertEqual (Before, WhereX ());

    CloseGraph ();
end

/// Variadic, as the built-in is: every argument rendered as Str renders it,
/// and a bare call is a newline.
test 'Write Takes Any Number Of Arguments Of Any Type';
begin
    CloseGraph ();
    InitGraph (320, 200, 'variadic', False);

    Write ('a', 42, ' ', 3.5);

    // 'a42 3.5' is seven cells, so the cursor rests on the eighth.
    AssertEqual (8, WhereX ());

    WriteLn ();

    AssertEqual (1, WhereX ());
    AssertEqual (2, WhereY ());

    var W := Window (1, 1, 20, 5, 1);

    W.Write ('x', 1, True);         // 'x1true'

    AssertEqual (7, W.WhereX ());

    CloseGraph ();
end
