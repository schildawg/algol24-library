/// Reading and writing files.
///
/// The language's own `TextFile` exists for the compiler, which has its own
/// reasons for what it holds. This unit owns its primitive instead -- a
/// hundred lines of plain C99 -- so that it can grow without ever asking the
/// language for anything, which is the same bargain `math` and `sound` strike.
///
/// It is also the library's first foreign code that builds anywhere.
/// `soundffi.c` and `graphffi.c` want SDL2; `crtffi.c` and `dosffi.c` are
/// POSIX and rule out Windows. Nothing here is worse than `fopen`.
///
/// Whole files, and that is a scope decision rather than a principle -- which
/// is worth stating here, because the reasoning used to live only in a commit
/// message and so read as an assumption to anyone editing this file.
///
/// `ReadAll` and `ReadLines` bring a file into memory and `WriteAll` sends one
/// out; there is no open handle for a CALLER to hold, no cursor to keep and
/// nothing to remember to close. That covers everything this library does with
/// files, and it is a convenience layer rather than a foundation -- which is
/// the opposite of how it was first described.
///
/// Two things changed the picture. The original reason for having no handle
/// was that streaming "needs a way to hand back a line without handing back a
/// borrowed pointer", and that pattern has since been solved three times over
/// in this library: `ReadAll` itself, `dos.GetEnv` and `graph`'s SDL error
/// reader all ask C for a length, size a Buffer and read it back. The obstacle
/// is gone.
///
/// And a whole-file read cannot be built on `stat` the way this unit tried to
/// build it: `stat` answers the bytes currently buffered for a pipe and zero
/// for most character devices, so a megabyte piped in came back as 65536 and
/// reported success. `ReadAll` therefore holds a handle INTERNALLY and reads
/// to end of file, growing as it goes. A caller still sees none of that.
///
/// Where streaming should sit is a design question rather than a gap:
/// every modern runtime makes the stream the primitive and the whole-file
/// read the sugar on top, and this unit has it the other way round. See
/// `SKETCH-STREAMING.md`.
///
/// Paths resolve against the working directory, as every data file here does.
unit file;

/// Whether a path exists at all, directory or not.
///
/// Private to this unit; `Exists` is what a caller asks.
function RawExists (Path : String) : Integer;
    external 'alg_libfile_exists' in 'libfileffi.so';

/// Whether a path is a directory.
///
/// Private to this unit.
function RawIsDir (Path : String) : Integer;
    external 'alg_libfile_isdir' in 'libfileffi.so';

/// How many bytes a file holds, or -1 if it is not a readable file.
///
/// Private to this unit, and called before every read so the buffer can be
/// sized exactly -- a Buffer with trailing zeros has no Text.
function RawSize (Path : String) : Integer;
    external 'alg_libfile_size' in 'libfileffi.so';

/// Opens a file for reading and answers a handle, or -1.
///
/// Private to this unit. A handle exists because reading to end of file needs
/// the stream held open: a pipe can be neither re-opened nor seeked, its bytes
/// being gone once read. The unit's own surface stays whole-file.
private function RawOpen (Path : String, Mode : Integer) : Integer;
    external 'alg_libfile_open' in 'libfileffi.so';

/// Reads up to Max bytes into a buffer at Offset, answering the count and 0
/// at end of file.
///
/// Private to this unit. The offset is a parameter because a Pointer cannot be
/// offset in this language -- the buffer and the position within it are passed
/// separately rather than added.
private function RawReadInto (Handle : Integer, Into : Pointer,
                              Offset : Integer, Max : Integer) : Integer;
    external 'alg_libfile_read_into' in 'libfileffi.so';

/// Closes a handle, and does nothing for one already closed.
///
/// Private to this unit.
private procedure RawClose (Handle : Integer);
    external 'alg_libfile_close' in 'libfileffi.so';

/// Writes a String's bytes, answering how many went out or -1.
///
/// Private to this unit. Passing a String into C is the safe direction: the
/// bytes are read during the call and not kept.
private function RawWriteText (Handle : Integer, Text : String) : Integer;
    external 'alg_libfile_write_text' in 'libfileffi.so';

/// Writes Count bytes from a buffer at Offset, answering how many went out.
///
/// Private to this unit.
private function RawWriteBytes (Handle : Integer, From : Pointer,
                                Offset : Integer, Count : Integer) : Integer;
    external 'alg_libfile_write_bytes' in 'libfileffi.so';

/// Pushes buffered bytes at the operating system.
///
/// Private to this unit.
private function RawFlush (Handle : Integer) : Integer;
    external 'alg_libfile_flush' in 'libfileffi.so';

/// The index of a byte within a buffer's range, or -1.
///
/// Private to this unit, and there for speed rather than for any decision:
/// the unit could walk the bytes with `B[I]` and this project has measured
/// that as far too slow, `graphffi.c` carrying a hex decoder for the same
/// reason. What a line is remains the unit's business.
private function RawScan (Bytes : Pointer, From : Integer, Len : Integer,
                          Byte : Integer) : Integer;
    external 'alg_libfile_scan' in 'libfileffi.so';

/// Copies a run of bytes between two buffers, answering the count.
///
/// Private to this unit, and on the same grounds as `RawScan`. The two
/// buffers are always different ones here, so there is no overlap to worry
/// about.
private function RawCopyBytes (Dst : Pointer, DstOffset : Integer,
                               Src : Pointer, SrcOffset : Integer,
                               Len : Integer) : Integer;
    external 'alg_libfile_copy_bytes' in 'libfileffi.so';

/// How a file is opened: reading, writing from empty, or writing at the end.
///
/// Private to this unit. The three the core's own `TextFile` offers as
/// `Reset`, `Rewrite` and `Append` [RT-024].
private const ModeRead   := 0;
private const ModeWrite  := 1;
private const ModeAppend := 2;

/// How many bytes a reader holds at a time.
///
/// Private to this unit. A reader fills this much from the operating system
/// and then answers lines out of it, so the cost of a line is a scan rather
/// than a system call.
private const WindowSize := 65536;

/// Reads a file into a buffer this unit owns, answering the byte count.
///
/// Private to this unit. Nothing in the C answers a pointer, deliberately: a
/// String made from a C pointer BORROWS those bytes rather than copying them,
/// so a function reusing one buffer would corrupt a String still in hand.
function RawRead (Path : String, Into : Pointer, Max : Integer) : Integer;
    external 'alg_libfile_read' in 'libfileffi.so';

/// Writes text to a file, replacing it or adding to the end.
///
/// Private to this unit. Going this way there is no lifetime question: the
/// String's bytes are used during the call and not kept.
function RawWrite (Path : String, Text : String, Append : Integer) : Integer;
    external 'alg_libfile_write' in 'libfileffi.so';

/// Removes a file.
///
/// Private to this unit.
function RawErase (Path : String) : Integer;
    external 'alg_libfile_erase' in 'libfileffi.so';

/// Renames or moves a file.
///
/// Private to this unit.
function RawRename (From : String, To : String) : Integer;
    external 'alg_libfile_rename' in 'libfileffi.so';

/// Copies a file a block at a time.
///
/// Private to this unit, and in C rather than read-then-write here, because
/// that would hold a whole file in memory to move it -- which matters exactly
/// when the file is large.
function RawCopy (From : String, To : String) : Integer;
    external 'alg_libfile_copy' in 'libfileffi.so';


/// Whether a path exists, whether it is a file or a directory.
///
/// Never raises: asking about a path that is not there is the question, not a
/// fault.
///
/// # Examples
/// `A File Written Can Be Read Back`
function Exists (Path : String) : Boolean;
begin
    Exit RawExists (Path) <> 0;
end

/// Whether a path is a directory.
///
/// Worth asking separately from `Exists`: opening a directory as a file
/// succeeds on some systems and then reads nothing, which looks like an empty
/// file rather than a mistake.
///
/// # Examples
/// `A Directory Is Not A File`
function IsDirectory (Path : String) : Boolean;
begin
    Exit RawIsDir (Path) <> 0;
end

/// How many bytes a file holds.
///
/// # Raises
/// `FileSize: cannot read '<path>'.` for a path that is missing, is a
/// directory, or cannot be opened.
///
/// # Examples
/// `A File Written Can Be Read Back`
function FileSize (Path : String) : Integer;
begin
    var N := RawSize (Path);

    if N < 0 then raise 'FileSize: cannot read ''' + Path + '''.';

    Exit N;
end

/// The whole of a text file, as a String.
///
/// The file is read in one go: there is no handle to hold and nothing to
/// close. Newlines arrive as they are in the file, so a file written on
/// Windows keeps its carriage returns -- `ReadLines` is what strips them.
///
/// An empty file answers an empty String rather than raising.
///
/// # Raises
/// `ReadAll: cannot read '<path>'.` for a path that is missing, is a
/// directory, or cannot be opened, and `ReadAll: '<path>' is not text.` for a
/// file holding a zero byte, which a text file does not.
///
/// # Examples
/// `A File Written Can Be Read Back`
function ReadAll (Path : String) : String;
begin
    // Built on InFile, which is the point of having it: the streaming
    // primitive is what makes this correct, so this is the convenience layer
    // and not the foundation. A pipe can be neither re-opened nor seeked, so
    // reading one fully means holding the stream open -- which is what
    // trusting `stat` and reading once could not do, and what cost a megabyte
    // piped in coming back as 65536 bytes reported as success.
    var Reader := nil;

    try
        Reader := InFile (Path);
    except
        raise 'ReadAll: cannot read ''' + Path + '''.';
    end

    // The size only chooses a starting capacity. It is a HINT: `stat` answers
    // the bytes currently BUFFERED for a pipe, zero for most character
    // devices, and a stale figure for a file that grows while being read.
    var Cap := RawSize (Path);

    if Cap < 65536 then Cap := 65536;

    var B   := Buffer (Cap);
    var Got := 0;

    while True do
    begin
        if Got = Cap then
        begin
            Cap := Cap * 2;

            B.Resize (Cap);
        end

        var N := Reader.ReadBytes (B, Got, Cap - Got);

        if N <= 0 then break;

        Got := Got + N;
    end

    Reader.Close ();

    // Sized exactly, because a Buffer holding a zero byte has no Text and a
    // buffer larger than its contents would refuse on its own trailing zeros.
    B.Resize (Got);

    try
        Exit B.Text;
    except
        raise 'ReadAll: ''' + Path + ''' is not text.';
    end
end

/// The lines of a text file, without their newlines.
///
/// A trailing newline does not make an empty last line -- a file of three
/// lines answers three, however it ends. A carriage return before a newline
/// is dropped, so a file written on Windows reads the same as one written
/// here.
///
/// # Raises
/// `ReadAll`'s messages.
///
/// # Examples
/// `Lines Come Back Without Their Newlines`
function ReadLines (Path : String) : List;
begin
    Exit SplitLines (ReadAll (Path));
end

/// Splits text into lines, on either newline convention.
///
/// Private to this unit, and separate from `ReadLines` so the splitting can be
/// tested without a file to read.
function SplitLines (Text : String) : List;
begin
    var Lines := [];
    var Line  := Buffer ();
    var Any   := False;

    for var I := 0; I < Length (Text); I := I + 1 do
    begin
        var C := Text[I];

        if C = #10 then
        begin
            Lines.Add (Line.Text);

            Line := Buffer ();
            Any  := False;

            continue;
        end

        // A carriage return immediately before a newline belongs to the
        // newline, not to the line.
        if C = #13 then
          if I + 1 < Length (Text) then
            if Text[I + 1] = #10 then continue;

        Line.Append (C);

        Any := True;
    end

    // Whatever is left after the last newline is a line only if there is
    // something there -- so a trailing newline does not invent an empty one.
    if Any then Lines.Add (Line.Text);

    Exit Lines;
end

/// Writes text to a file, replacing whatever was there.
///
/// # Raises
/// `WriteAll: cannot write '<path>'.`
///
/// # Examples
/// `A File Written Can Be Read Back`
procedure WriteAll (Path : String, Text : String);
begin
    if RawWrite (Path, Text, 0) = 0 then
        raise 'WriteAll: cannot write ''' + Path + '''.';
end

/// Adds text to the end of a file, making it if it is not there.
///
/// # Raises
/// `AppendAll: cannot write '<path>'.`
///
/// # Examples
/// `Appending Adds To The End`
procedure AppendAll (Path : String, Text : String);
begin
    if RawWrite (Path, Text, 1) = 0 then
        raise 'AppendAll: cannot write ''' + Path + '''.';
end

/// Writes lines to a file, each followed by a newline.
///
/// The last line gets one too, which is what makes a file that `ReadLines`
/// reads back unchanged.
///
/// # Raises
/// `WriteAll`'s message.
///
/// # Examples
/// `Lines Come Back Without Their Newlines`
procedure WriteLines (Path : String, Lines : List);
begin
    var B := Buffer ();

    for var L in Lines do
    begin
        B.Append (Str (L));
        B.Append (#10);
    end

    if Lines.Length = 0 then WriteAll (Path, '');
    else WriteAll (Path, B.Text);
end

/// Removes a file.
///
/// Turbo Pascal's name for it.
///
/// # Raises
/// `Erase: cannot remove '<path>'.` for a file that is not there or cannot
/// be removed.
///
/// # Examples
/// `A File Erased Is Gone`
procedure Erase (Path : String);
begin
    if RawErase (Path) = 0 then
        raise 'Erase: cannot remove ''' + Path + '''.';
end

/// Renames or moves a file.
///
/// # Raises
/// `Rename: cannot rename '<from>'.`
///
/// # Examples
/// `A File Renamed Keeps Its Contents`
procedure Rename (From : String, To : String);
begin
    if RawRename (From, To) = 0 then
        raise 'Rename: cannot rename ''' + From + '''.';
end

/// Copies a file.
///
/// Copied a block at a time in the C rather than read-then-written here, so a
/// large file is not held in memory to be moved.
///
/// # Raises
/// `CopyFile: cannot copy '<from>'.`
///
/// # Examples
/// `A File Copied Matches Its Original`
procedure CopyFile (From : String, To : String);
begin
    if RawCopy (From, To) = 0 then
        raise 'CopyFile: cannot copy ''' + From + '''.';
end


// The tests write to the working directory and clean up after themselves.
// A dotted name, so a stray one after a failed run is out of the way.
const Scratch := '.file-unit-test';

test 'A File Written Can Be Read Back';
begin
    WriteAll (Scratch, 'alpha' + #10 + 'beta' + #10);

    AssertTrue (Exists (Scratch));
    AssertTrue (not IsDirectory (Scratch));
    AssertEqual (11, FileSize (Scratch));
    AssertEqual ('alpha' + #10 + 'beta' + #10, ReadAll (Scratch));

    // Writing again replaces rather than adds.
    WriteAll (Scratch, 'x');

    AssertEqual (Str ('x'), ReadAll (Scratch));
    AssertEqual (1, FileSize (Scratch));

    // An empty file is a file, and answers an empty String rather than
    // raising.
    WriteAll (Scratch, '');

    AssertEqual (0, FileSize (Scratch));
    AssertEqual ('', ReadAll (Scratch));

    Erase (Scratch);
end

test 'Reading What Is Not There Says So';
begin
    if Exists (Scratch) then Erase (Scratch);

    AssertTrue (not Exists (Scratch));

    var Message := '';

    try ReadAll (Scratch); except on e : String do Message := e; end
    AssertEqual ('ReadAll: cannot read ''' + Scratch + '''.', Message);

    Message := '';
    try FileSize (Scratch); except on e : String do Message := e; end
    AssertEqual ('FileSize: cannot read ''' + Scratch + '''.', Message);

    Message := '';
    try ReadLines (Scratch); except on e : String do Message := e; end
    AssertEqual ('ReadAll: cannot read ''' + Scratch + '''.', Message);

    Message := '';
    try Erase (Scratch); except on e : String do Message := e; end
    AssertEqual ('Erase: cannot remove ''' + Scratch + '''.', Message);

    Message := '';
    try Rename (Scratch, Scratch + '2'); except on e : String do Message := e; end
    AssertEqual ('Rename: cannot rename ''' + Scratch + '''.', Message);

    Message := '';
    try CopyFile (Scratch, Scratch + '2'); except on e : String do Message := e; end
    AssertEqual ('CopyFile: cannot copy ''' + Scratch + '''.', Message);
end

test 'A Directory Is Not A File';
begin
    // The working directory is one, and is always there.
    AssertTrue (Exists ('.'));
    AssertTrue (IsDirectory ('.'));

    // Opening a directory as a file succeeds on some systems and reads
    // nothing, which would look like an empty file rather than a mistake --
    // so this refuses it outright.
    var Message := '';

    try ReadAll ('.'); except on e : String do Message := e; end
    AssertEqual ('ReadAll: cannot read ''.''.', Message);
end

test 'Lines Come Back Without Their Newlines';
begin
    WriteAll (Scratch, 'one' + #10 + 'two' + #10 + 'three' + #10);

    var L := ReadLines (Scratch);

    AssertEqual (3, L.Length);
    AssertEqual ('one', L[0]);
    AssertEqual ('two', L[1]);
    AssertEqual ('three', L[2]);

    // A trailing newline does not invent an empty last line, and a file
    // without one still ends in a line.
    WriteAll (Scratch, 'a' + #10 + 'b');

    AssertEqual (2, ReadLines (Scratch).Length);
    AssertEqual (Str ('b'), ReadLines (Scratch)[1]);

    // WriteLines and ReadLines are inverses.
    WriteLines (Scratch, ['x', 'y', 'z']);

    var Back := ReadLines (Scratch);

    AssertEqual (3, Back.Length);
    AssertEqual (Str ('x'), Back[0]);
    AssertEqual (Str ('z'), Back[2]);

    // An empty list writes an empty file and reads back as no lines.
    WriteLines (Scratch, []);

    AssertEqual (0, FileSize (Scratch));
    AssertEqual (0, ReadLines (Scratch).Length);

    Erase (Scratch);
end

test 'Either Newline Convention Reads The Same';
begin
    // Split without a file, which is why the splitting is its own function.
    var Unix := SplitLines ('a' + #10 + 'b' + #10);
    var Dos  := SplitLines ('a' + #13 + #10 + 'b' + #13 + #10);

    AssertEqual (2, Unix.Length);
    AssertEqual (2, Dos.Length);
    AssertEqual (Str ('a'), Dos[0]);
    AssertEqual (Str ('b'), Dos[1]);

    // A carriage return that is not before a newline is just a character.
    var Lone := SplitLines ('a' + #13 + 'b');

    AssertEqual (1, Lone.Length);
    AssertEqual (3, Length (Lone[0]));

    // Nothing at all is no lines.
    AssertEqual (0, SplitLines ('').Length);
end

test 'Appending Adds To The End';
begin
    WriteAll (Scratch, 'one');
    AppendAll (Scratch, ' two');
    AppendAll (Scratch, ' three');

    AssertEqual ('one two three', ReadAll (Scratch));

    // Appending to a file that is not there makes it.
    Erase (Scratch);
    AppendAll (Scratch, 'fresh');

    AssertEqual ('fresh', ReadAll (Scratch));

    Erase (Scratch);
end

test 'A File Renamed Keeps Its Contents';
begin
    WriteAll (Scratch, 'moved');
    Rename (Scratch, Scratch + '2');

    AssertTrue (not Exists (Scratch));
    AssertTrue (Exists (Scratch + '2'));
    AssertEqual ('moved', ReadAll (Scratch + '2'));

    Erase (Scratch + '2');
end

test 'A File Copied Matches Its Original';
begin
    // Bigger than the C's copy block, so the loop runs more than once.
    var B := Buffer ();

    for var I := 0; I < 20000; I := I + 1 do
        B.Append (Char (65 + I mod 26));

    WriteAll (Scratch, B.Text);
    CopyFile (Scratch, Scratch + '2');

    AssertEqual (20000, FileSize (Scratch + '2'));
    AssertEqual (ReadAll (Scratch), ReadAll (Scratch + '2'));

    // The original is untouched.
    AssertEqual (20000, FileSize (Scratch));

    Erase (Scratch);
    Erase (Scratch + '2');
end

test 'A File That Is Not Text Says So';
begin
    // A zero byte is what a text file does not hold, and what a Buffer has no
    // Text for -- so the message says which file rather than which Buffer.
    WriteAll (Scratch, 'ok');

    var Raw := Buffer (3);

    Raw[0] := 97;
    Raw[1] := 0;
    Raw[2] := 98;

    // Written through the C, since a String cannot carry a zero byte.
    AssertEqual (1, RawWrite (Scratch, 'a', 0));

    // Two reads of the same file must not interfere: a String made here holds
    // its own bytes rather than borrowing the C's.
    WriteAll (Scratch, 'first');
    WriteAll (Scratch + '2', 'second');

    var A := ReadAll (Scratch);
    var C := ReadAll (Scratch + '2');

    AssertEqual ('first', A);
    AssertEqual ('second', C);

    Erase (Scratch);
    Erase (Scratch + '2');
end

/// The growth loop, which is what makes a read to end of file work.
///
/// Note what this does and does not cover. The fault that prompted it was a
/// pipe: `stat` answers the bytes currently buffered, so a megabyte piped in
/// came back as 65536 and reported success. A pipe cannot be made inside a
/// test -- it needs a second process writing to it -- so **the version with
/// the bug would have passed both of these**, `stat` being perfectly accurate
/// for a regular file that holds still.
///
/// What they do guard is the mechanism the fix rests on: that the read grows
/// its buffer and runs to end of file rather than trusting a size. The pipe
/// itself was verified by hand, with `yes | head -c 1048576 | algc`, and the
/// reproduction is recorded in `CLAUDE.md`.
test 'ReadAll Reads Past Its Starting Buffer';
begin
    var Path := 'alg-file-grow-test.txt';

    // Past the 65536 the read starts with, so the loop has to grow at least
    // twice to hold it.
    var Chunk := '0123456789ABCDEF';          // sixteen bytes
    var Big   := Buffer ();

    for var I := 0; I < 12000; I := I + 1 do Big.Append (Chunk);

    var Text := Big.Text;

    AssertEqual (192000, Length (Text));

    WriteAll (Path, Text);

    var Back := ReadAll (Path);

    AssertEqual (192000, Length (Back));
    AssertEqual (Text, Back);

    Erase (Path);
end

/// Exactly the starting capacity, where the buffer fills on the last read and
/// the loop must ask once more to learn it is at the end.
test 'ReadAll Handles A File Exactly Its Buffer Size';
begin
    var Path := 'alg-file-exact-test.txt';
    var Big  := Buffer ();

    for var I := 0; I < 4096; I := I + 1 do Big.Append ('0123456789ABCDEF');

    var Text := Big.Text;

    AssertEqual (65536, Length (Text));

    WriteAll (Path, Text);

    AssertEqual (65536, Length (ReadAll (Path)));
    AssertEqual (Text, ReadAll (Path));

    Erase (Path);
end

/// A file open for reading, a line or a run of bytes at a time.
///
/// This is the streaming half of the unit, and the primitive the whole-file
/// routines are built on rather than a parallel way of doing the same thing.
/// Reach for it when a file will not fit in memory, when the input is a pipe
/// whose size cannot be known, or when the work is done line by line and
/// there is no reason to hold the rest.
///
/// A reader fills a window of bytes from the operating system and answers
/// lines out of it, so the cost of a line is a scan and not a system call.
///
/// # Raises
/// `InFile: cannot open '<Path>'.` when the file is absent, is a directory,
/// or cannot be opened.
///
/// # Safety
/// `Close` releases the handle and may be called more than once, so a handler
/// can release on the way out without knowing how far the program got -- the
/// bargain `Buffer.Free` and `TextFile.Close` already make [RT-023]. Every
/// other member of a closed reader raises.
///
/// # Examples
/// `InFile Reads A File Line By Line`
///
/// # Since
/// 0.1.5
class InFile;
var
    Handle : Integer;
    Window : Any;
    Have   : Integer;             // bytes in the window
    At     : Integer;             // how far through it we are
    Ended  : Boolean;             // the operating system has no more
    Closed : Boolean;

begin
    constructor Init (Path : String);
    begin
        // Asked before opening, because `fopen` SUCCEEDS on a directory --
        // measured on macOS, where this answered an empty reader rather than
        // refusing. `RawSize` carries the S_ISDIR check, which is the same
        // gate `ReadAll` uses, so the two agree about what is readable. A
        // pipe is not caught by it: stat answers 0 for one, not -1.
        if RawSize (Path) < 0 then
            raise 'InFile: cannot open ''' + Path + '''.';

        this.Handle := RawOpen (Path, ModeRead);

        if this.Handle < 0 then
            raise 'InFile: cannot open ''' + Path + '''.';

        this.Window := Buffer (WindowSize);
        this.Have   := 0;
        this.At     := 0;
        this.Ended  := False;
        this.Closed := False;
    end

    /// Refills the window when it is spent, answering what it holds.
    ///
    /// Private to the class. Does nothing while bytes remain, so a caller may
    /// ask freely.
    function Refill () : Integer;
    begin
        if this.At < this.Have then Exit this.Have - this.At;
        if this.Ended then Exit 0;

        var N := RawReadInto (this.Handle, this.Window.Address, 0, WindowSize);

        if N <= 0 then
        begin
            this.Ended := True;
            this.Have  := 0;
            this.At    := 0;

            Exit 0;
        end

        this.Have := N;
        this.At   := 0;

        Exit N;
    end

    /// Whether the file has nothing left to give.
    ///
    /// Asks the operating system when the window is spent, so this is the
    /// honest answer rather than a guess from the size.
    function AtEnd () : Boolean;
    begin
        this.Check ('AtEnd');

        Exit this.Refill () = 0;
    end

    /// The next line, without its terminator.
    ///
    /// A carriage return before the newline belongs to the newline, so a file
    /// written on Windows reads the same as one written here. A final line
    /// with no terminator is still a line; a trailing newline does not invent
    /// an empty one after it. That is the rule `ReadLines` already follows,
    /// and the two must not disagree.
    ///
    /// # Raises
    /// `ReadLine: at end of file.` past the last line, so a loop that forgets
    /// `AtEnd` fails rather than spinning on empty strings.
    function ReadLine () : String;
    begin
        this.Check ('ReadLine');

        if this.Refill () = 0 then raise 'ReadLine: at end of file.';

        var Out    := Buffer ();
        var OutLen := 0;

        while True do
        begin
            if this.Refill () = 0 then break;

            var Found := RawScan (this.Window.Address, this.At,
                                  this.Have - this.At, 10);

            var Upto := Found;

            if Found < 0 then Upto := this.Have;

            var N := Upto - this.At;

            if N > 0 then
            begin
                Out.Resize (OutLen + N);

                // Taken afresh: Resize may move the bytes.
                RawCopyBytes (Out.Address, OutLen,
                              this.Window.Address, this.At, N);

                OutLen := OutLen + N;
            end

            this.At := Upto;

            if Found >= 0 then
            begin
                this.At := this.At + 1;      // step over the newline itself

                break;
            end
        end

        Out.Resize (OutLen);

        // A carriage return belongs to the newline that followed it.
        if OutLen > 0 and Out[OutLen - 1] = 13 then
        begin
            OutLen := OutLen - 1;

            Out.Resize (OutLen);
        end

        if OutLen = 0 then Exit '';

        try
            Exit Out.Text;
        except
            raise 'ReadLine: the line is not text.';
        end
    end

    /// Up to Count bytes into a caller's buffer at Offset, answering how
    /// many came.
    ///
    /// Answers 0 at end of file rather than raising, so a loop ends on a
    /// count of zero. The buffer is the caller's; nothing here hands back a
    /// pointer.
    ///
    /// The offset is what lets a caller fill a growing buffer across several
    /// reads, which is how `ReadAll` is built on this rather than on a loop
    /// of its own.
    function ReadBytes (Into : Any, Offset : Integer,
                        Count : Integer) : Integer;
    begin
        this.Check ('ReadBytes');

        if Into = nil then raise 'ReadBytes: needs a buffer.';
        if Offset < 0 then raise 'ReadBytes: the offset cannot be negative.';
        if Count <= 0 then Exit 0;

        var Got := 0;

        while Got < Count do
        begin
            if this.Refill () = 0 then break;

            var Want := Count - Got;
            var Left := this.Have - this.At;

            if Want > Left then Want := Left;

            // Into.Address afresh each time: the caller may have resized it
            // between calls, which is exactly what ReadAll does.
            RawCopyBytes (Into.Address, Offset + Got,
                          this.Window.Address, this.At, Want);

            this.At := this.At + Want;
            Got     := Got + Want;
        end

        Exit Got;
    end

    /// Releases the handle, and does nothing when already closed.
    procedure Close ();
    begin
        if this.Closed then Exit;

        RawClose (this.Handle);

        this.Closed := True;
    end

    /// Refuses a member on a closed reader, naming it.
    ///
    /// Private to the class.
    procedure Check (Who : String);
    begin
        if this.Closed then raise Who + ': the file is closed.';
    end
end

/// A file open for writing, emptied first.
///
/// The writing half of the streaming surface. Reach for it when output is
/// produced as the program runs rather than assembled and handed over whole,
/// which is what `WriteAll` is for.
///
/// # Raises
/// `OutFile: cannot open '<Path>'.` when the file cannot be opened for
/// writing.
///
/// # Safety
/// `Close` flushes, releases the handle, and may be called more than once.
/// Bytes written may sit in a buffer until `Flush` or `Close`, so a program
/// that ends without closing may lose the tail -- which is the one real cost
/// of writing this way instead of with `WriteAll`.
///
/// # Examples
/// `OutFile Writes Lines That Read Back`
///
/// # Since
/// 0.1.5
class OutFile;
var
    Handle : Integer;
    Closed : Boolean;

begin
    constructor Init (Path : String);
    begin
        this.Handle := RawOpen (Path, ModeWrite);

        if this.Handle < 0 then
            raise 'OutFile: cannot open ''' + Path + '''.';

        this.Closed := False;
    end

    /// Writes text as it stands, adding nothing.
    ///
    /// There is deliberately no free-function alias for this. `graph` and
    /// `crt` both export a free `Write` that shadows the built-in, and a
    /// third would make a bare `Write` ambiguous in the combinations worth
    /// writing -- the same collision that keeps `Delay` out of `sound`. A
    /// method on a receiver collides with nothing.
    procedure Write (Text : String);
    begin
        this.Check ('Write');

        if RawWriteText (this.Handle, Text) < 0 then
            raise 'Write: the file is not open for writing.';
    end

    /// Writes text and a newline.
    ///
    /// Named `WriteLine` rather than `WriteLn` so that nobody reading it has
    /// to wonder which unit's `WriteLn` answered.
    procedure WriteLine (Text : String);
    begin
        this.Check ('WriteLine');

        this.Write (Text);
        this.Write (Str (#10));
    end

    /// Writes Count bytes from the start of a buffer.
    procedure WriteBytes (From : Any, Count : Integer);
    begin
        this.Check ('WriteBytes');

        if From = nil then raise 'WriteBytes: needs a buffer.';
        if Count <= 0 then Exit;

        if RawWriteBytes (this.Handle, From.Address, 0, Count) < 0 then
            raise 'WriteBytes: the file is not open for writing.';
    end

    /// Pushes what is buffered at the operating system.
    procedure Flush ();
    begin
        this.Check ('Flush');

        RawFlush (this.Handle);
    end

    /// Flushes and releases the handle, and does nothing when already closed.
    procedure Close ();
    begin
        if this.Closed then Exit;

        RawFlush (this.Handle);
        RawClose (this.Handle);

        this.Closed := True;
    end

    /// Refuses a member on a closed file, naming it.
    ///
    /// Private to the class.
    procedure Check (Who : String);
    begin
        if this.Closed then raise Who + ': the file is closed.';
    end
end

/// A file open for writing at the end, keeping what is already there.
///
/// Everything `OutFile` does, opened differently -- which is the whole of the
/// difference, so it inherits rather than restating five methods.
///
/// # Raises
/// `AppendFile: cannot open '<Path>'.` when the file cannot be opened for
/// appending.
///
/// # Safety
/// As `OutFile`.
///
/// # Examples
/// `AppendFile Adds To What Is Already There`
///
/// # Since
/// 0.1.5
class AppendFile (OutFile);
begin
    constructor Init (Path : String);
    begin
        this.Handle := RawOpen (Path, ModeAppend);

        if this.Handle < 0 then
            raise 'AppendFile: cannot open ''' + Path + '''.';

        this.Closed := False;
    end
end

/// # Examples cites this by name from `InFile`.
test 'InFile Reads A File Line By Line';
begin
    var Path := 'alg-infile-lines.txt';

    WriteAll (Path, 'alpha' + #10 + 'beta' + #10 + 'gamma' + #10);

    var F     := InFile (Path);
    var Seen  := [];

    while not F.AtEnd () do Seen.Add (F.ReadLine ());

    F.Close ();

    AssertEqual (3, Seen.Length);
    AssertEqual ('alpha', Seen[0]);
    AssertEqual ('beta',  Seen[1]);
    AssertEqual ('gamma', Seen[2]);

    Erase (Path);
end

/// A trailing newline must not invent an empty last line, and a line with no
/// terminator is still a line. The same rule `ReadLines` follows.
test 'InFile Agrees With ReadLines About Line Endings';
begin
    var Path := 'alg-infile-endings.txt';

    for var Body in ['a' + #10 + 'b' + #10, 'a' + #10 + 'b',
                     'a' + #13 + #10 + 'b', '', #10, 'only'] do
    begin
        WriteAll (Path, Body);

        var Whole := ReadLines (Path);
        var F     := InFile (Path);
        var Seen  := [];

        while not F.AtEnd () do Seen.Add (F.ReadLine ());

        F.Close ();

        AssertEqual (Whole.Length, Seen.Length);

        for var I := 0; I < Whole.Length; I := I + 1 do
            AssertEqual (Whole[I], Seen[I]);
    end

    Erase (Path);
end

/// A carriage return before the newline belongs to the newline, so a file
/// written on Windows reads the same as one written here.
test 'InFile Takes A Carriage Return As Part Of The Newline';
begin
    var Path := 'alg-infile-crlf.txt';

    WriteAll (Path, 'one' + #13 + #10 + 'two' + #13 + #10);

    var F := InFile (Path);

    AssertEqual ('one', F.ReadLine ());
    AssertEqual ('two', F.ReadLine ());
    AssertTrue (F.AtEnd ());

    F.Close ();
    Erase (Path);
end

/// Past the last line is a refusal rather than an empty string, so a loop
/// that forgets AtEnd fails instead of spinning.
test 'InFile Refuses To Read Past The End';
begin
    var Path := 'alg-infile-end.txt';

    WriteAll (Path, 'only' + #10);

    var F      := InFile (Path);
    var Raised := False;

    AssertEqual ('only', F.ReadLine ());

    try
        F.ReadLine ();
    except on E : String do
        Raised := True;
    end

    AssertTrue (Raised);

    F.Close ();
    Erase (Path);
end

/// The window is 65536 bytes, so a file past it exercises the refill and a
/// line straddling the boundary exercises assembly across two windows.
test 'InFile Reads Lines Across Its Window Boundary';
begin
    var Path := 'alg-infile-window.txt';
    var Big  := Buffer ();

    // Lines of 100 bytes, enough of them to pass 65536 several times over.
    for var I := 0; I < 3000; I := I + 1 do
    begin
        for var J := 0; J < 99; J := J + 1 do Big.Append ('x');

        Big.Append (Str (#10));
    end

    WriteAll (Path, Big.Text);

    var F     := InFile (Path);
    var Count := 0;

    while not F.AtEnd () do
    begin
        var L := F.ReadLine ();

        AssertEqual (99, Length (L));

        Count := Count + 1;
    end

    F.Close ();

    AssertEqual (3000, Count);

    Erase (Path);
end

/// Bytes rather than lines, filling a buffer the caller owns.
test 'InFile Reads Bytes Into A Callers Buffer';
begin
    var Path := 'alg-infile-bytes.bin';
    var Out  := Buffer (4);

    Out[0] := 65;  Out[1] := 66;  Out[2] := 67;  Out[3] := 68;

    var W := OutFile (Path);

    W.WriteBytes (Out, 4);
    W.Close ();

    var F   := InFile (Path);
    var Dst := Buffer (4);

    AssertEqual (4, F.ReadBytes (Dst, 0, 4));
    AssertEqual (65, Dst[0]);
    AssertEqual (68, Dst[3]);

    // Nothing left, so 0 rather than a raise.
    AssertEqual (0, F.ReadBytes (Dst, 0, 4));

    F.Close ();
    Erase (Path);
end

/// Close releases and may be called again, which is the bargain Buffer.Free
/// and TextFile.Close already make [RT-023] -- a handler can release on the
/// way out without knowing how far the program got.
test 'Closing A Reader Twice Is Allowed And Using One Is Not';
begin
    var Path := 'alg-infile-closed.txt';

    WriteAll (Path, 'x' + #10);

    var F := InFile (Path);

    F.Close ();
    F.Close ();

    var Raised := False;

    try
        F.ReadLine ();
    except on E : String do
        Raised := True;
    end

    AssertTrue (Raised);

    Erase (Path);
end

/// Opening what is not there says so rather than answering an empty reader.
test 'InFile Says So When It Cannot Open';
begin
    var Raised := False;

    try
        InFile ('alg-no-such-file-at-all.txt');
    except on E : String do
        Raised := True;
    end

    AssertTrue (Raised);
end

/// A directory is not a readable file, and must be refused rather than
/// answered as an empty reader. `fopen` succeeds on one, so this is a check
/// the unit has to make -- and `ReadAll` makes the same one, so the two agree
/// about what is readable.
test 'InFile Refuses A Directory';
begin
    var Raised := False;

    try
        InFile ('.');
    except on E : String do
        Raised := True;
    end

    AssertTrue (Raised);

    // And the whole-file route agrees.
    var AlsoRaised := False;

    try
        ReadAll ('.');
    except on E : String do
        AlsoRaised := True;
    end

    AssertTrue (AlsoRaised);
end

/// # Examples cites this by name from `OutFile`.
test 'OutFile Writes Lines That Read Back';
begin
    var Path := 'alg-outfile-lines.txt';
    var O    := OutFile (Path);

    O.WriteLine ('first');
    O.WriteLine ('second');
    O.Write ('third, with no newline');
    O.Close ();

    AssertEqual ('first' + #10 + 'second' + #10 + 'third, with no newline',
                 ReadAll (Path));

    Erase (Path);
end

/// Opening for writing empties what was there, which is Rewrite and not
/// Append.
test 'OutFile Empties The File It Opens';
begin
    var Path := 'alg-outfile-empty.txt';

    WriteAll (Path, 'old contents');

    var O := OutFile (Path);

    O.Write ('new');
    O.Close ();

    AssertEqual ('new', ReadAll (Path));

    Erase (Path);
end

/// Flush pushes what is buffered without closing, so the bytes are readable
/// while the file is still open.
test 'Flush Makes Written Bytes Readable Before Close';
begin
    var Path := 'alg-outfile-flush.txt';
    var O    := OutFile (Path);

    O.Write ('buffered');
    O.Flush ();

    AssertEqual ('buffered', ReadAll (Path));

    O.WriteLine ('');
    O.Close ();

    Erase (Path);
end

/// # Examples cites this by name from `AppendFile`.
test 'AppendFile Adds To What Is Already There';
begin
    var Path := 'alg-appendfile.txt';

    WriteAll (Path, 'kept' + #10);

    var A := AppendFile (Path);

    A.WriteLine ('added');
    A.Close ();

    AssertEqual ('kept' + #10 + 'added' + #10, ReadAll (Path));

    Erase (Path);
end

/// AppendFile inherits every method rather than restating them, so the ones
/// worth proving are the inherited ones.
test 'AppendFile Inherits The Writing Methods';
begin
    var Path := 'alg-appendfile-inherit.txt';
    var A    := AppendFile (Path);
    var B    := Buffer (2);

    B[0] := 72;  B[1] := 73;

    A.Write ('a');
    A.WriteLine ('b');
    A.WriteBytes (B, 2);
    A.Flush ();
    A.Close ();
    A.Close ();

    AssertEqual ('ab' + #10 + 'HI', ReadAll (Path));

    Erase (Path);
end

/// A closed writer refuses and names the member that was called.
test 'Closing A Writer Twice Is Allowed And Using One Is Not';
begin
    var Path := 'alg-outfile-closed.txt';
    var O    := OutFile (Path);

    O.Close ();
    O.Close ();

    var Message := '';

    try
        O.Write ('after');
    except on E : String do
        Message := E;
    end

    AssertEqual ('Write: the file is closed.', Message);

    Erase (Path);
end
