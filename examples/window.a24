// Opens the graph unit's window and leaves it up, so there is something to
// look at: close it with the close button, or press any key.
//
//     algc examples/window.a24
//
// The event loop is the demo's own, declared here the way any program may --
// the graph unit does not carry input yet, and a window with no loop closes
// the moment the program ends.

uses graph;

function SDL_PollEvent (E : Pointer) : Integer;
    external 'SDL_PollEvent' in '/opt/homebrew/lib/libSDL2.dylib';
procedure SDL_Delay (Ms : Integer);
    external 'SDL_Delay' in '/opt/homebrew/lib/libSDL2.dylib';

const EVENT_QUIT    := 256;
const EVENT_KEYDOWN := 768;

begin
    InitGraph (640, 480, 'Algol-24 graph', False);

    OutTextXY (24,  24, 'Algol-24');
    OutTextXY (24,  72, 'Merhaba  Türkçe  👋');
    OutTextXY (24, 112, 'Γεια σου  Ελληνικά  ⭐');
    OutTextXY (24, 152, '你好  中文  🎉');
    OutTextXY (24, 192, '안녕하세요  한국어  🙂');
    OutTextXY (24, 232, 'Hola  Español  🌍');

    InstallUserFont ('romfont.hex');
    OutTextXY (24, 300, 'and the same machine, one bit per pixel:');
    OutTextXY (24, 324, 'Hello from the character ROM.');
    InstallUserFont ('graphfont.hex');

    OutTextXY (24, 372, '╔═══════════╤═══[■]═╗  ░░▒▒▓▓██  ◄ ▲ ▼ ►');
    OutTextXY (24, 404, '╚═══════════╧═══════╝  the frames now connect');

    OutTextXY (24, 444, 'close the window, or press any key, to finish.');

    WriteLn ('window:  ' + Str (GetMaxX () + 1) + ' x ' + Str (GetMaxY () + 1));
    WriteLn ('desktop: ' + Str (ScreenWidth ()) + ' x ' + Str (ScreenHeight ()));
    WriteLn ('close the window, or press any key in it, to finish.');

    var Event   := Buffer (64);
    var Running := True;

    while Running do
    begin
        while SDL_PollEvent (Event.Address) <> 0 do
        begin
            var Kind := Event.GetInt (0);

            if Kind = EVENT_QUIT then Running := False;
            if Kind = EVENT_KEYDOWN then Running := False;
        end

        SDL_Delay (16);
    end

    CloseGraph ();
end
