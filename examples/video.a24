// HighVideo, LowVideo and NormVideo, demonstrated on the grid: the sixteen
// palette colors in their dim and bright rows, the odd couple Brown/Yellow,
// and an off-palette color stepped toward white and toward black.
//
//     algc examples/video.a24
//
// Close the window, or press any key in it, to finish.

uses graph;

begin
    InitGraph (1280, 800, 'HighVideo and LowVideo', False);

    WriteLn ('NormVideo: LightGray on Transparent, the startup colors.');
    WriteLn ('');

    // Every dim color, then the same colors through HighVideo.
    Write ('LowVideo   ');

    for var C in [Blue, Green, Cyan, Red, Magenta, Brown, LightGray, DarkGray] do
    begin
        TextColor (C);
        LowVideo ();
        Write ('████ ');
    end

    NormVideo ();
    WriteLn ('');
    Write ('HighVideo  ');

    for var C in [Blue, Green, Cyan, Red, Magenta, Brown, LightGray, DarkGray] do
    begin
        TextColor (C);
        HighVideo ();
        Write ('████ ');
    end

    NormVideo ();
    WriteLn ('');
    WriteLn ('');

    // The adapter's odd couple.
    Write ('Brown      ');
    TextColor (Brown);
    Write ('████  ');
    NormVideo ();
    Write ('HighVideo makes it ');
    TextColor (Brown);
    HighVideo ();
    WriteLn ('Yellow ████');
    NormVideo ();
    WriteLn ('');

    // Off the palette there is no intensity bit, so each call moves halfway.
    WriteLn ('An off-palette color, stepped by repeated calls:');
    WriteLn ('');
    Write ('darker     ');

    TextColor (8405024);           // 0x804020

    for var Step := 0; Step < 5; Step := Step + 1 do
    begin
        Write ('████');
        LowVideo ();
    end

    TextColor (8405024);
    WriteLn ('');
    Write ('brighter   ');

    for var Step := 0; Step < 5; Step := Step + 1 do
    begin
        Write ('████');
        HighVideo ();
    end

    NormVideo ();
    WriteLn ('');
    WriteLn ('');

    TextColor (LightRed + Blink);
    Write ('Blink');
    NormVideo ();
    WriteLn ('      -- TextColor (LightRed + Blink), on the language''s own clock');
    WriteLn ('');
    WriteLn ('close the window, or press any key, to finish.');

    // Wait for any key, or the close button -- ReadKey blocks, and keeps the
    // blink phase beating while it does.
    ReadKey ();

    CloseGraph ();
end
