/// Verbs over text that the core does not carry.
///
/// Every routine here is an `extension`, so each may be written either way --
/// `Trim (S)` or `S.Trim ()` -- and a chain of them reads in the order it
/// happens rather than inside out. The permission is per file: a program
/// reaches the method spelling only where its own `uses` clause names this
/// unit, which is what keeps `S.Trim ()` from meaning something different in
/// two parts of one program.
///
/// The core already answers `Length`, `Copy`, `Pos` (with a start index),
/// `Str`, `Val`, `ToUpper`, `ToLower`, indexing and `+`, and nothing here
/// re-spells one of them. A unit that restates the core is a unit that has to
/// be kept in step with it -- and this one did restate it for a while:
/// `Upper` and `Lower` carried their own ASCII loops before anyone checked
/// whether the core had them. They delegate now. Check the built-in table in
/// the specification before adding a method here.
///
/// Pure Algol-24, with no foreign code at all. That makes it the only unit
/// besides `testing` that needs nothing of a platform -- no library name in a
/// declaration, and nothing for a per-platform build to rewrite.
unit strings;

/// Whether C is one of the characters `Trim` removes.
///
/// Space, and the five control characters above it that a text file uses as
/// whitespace: tab, newline, vertical tab, form feed and carriage return.
/// Nothing else, which is the only answer that can be stated exactly -- the
/// Unicode space separators are a table, and this unit has none.
private function IsSpace (C : Char) : Boolean;
begin
    var N := Ord (C);

    Exit N = 32 or (N >= 9 and N <= 13);
end

// ------------------------------------------------------------------- trimming

/// S without the whitespace at either end.
///
/// A string of nothing but whitespace answers the empty string, which is the
/// same answer as trimming the empty string and is what makes the routine
/// total. The ends are found by index rather than by building, so a string
/// needing no trimming is copied once and never examined character by
/// character.
///
/// # Raises
/// Nothing. Every string has an answer, the empty one included.
///
/// # Examples
/// `Trim Removes Whitespace From Either End`
extension function Trim (S : String) : String;
begin
    var First := 0;
    var Last  := Length (S) - 1;

    while First <= Last and IsSpace (S[First]) do First := First + 1;
    while Last >= First and IsSpace (S[Last])  do Last  := Last - 1;

    Exit Copy (S, First, Last - First + 1);
end

// ----------------------------------------------------------------------- case

/// S with its ASCII lowercase letters raised, and every other character left
/// alone.
///
/// The core's own `ToUpper` [RT-025] does the work; this exists only to give
/// it the extension spelling, so `S.Upper ()` composes in a chain where
/// `ToUpper (S)` would not. Nothing here re-implements it -- an earlier
/// version of this unit did, which was a duplicate of the core and against
/// the rule stated above.
///
/// ASCII only, which is the core's decision and not this unit's, and the
/// right one: Unicode case mapping is a table rather than a rule and not even
/// character-to-character, `ß` uppercasing to `SS`. Accented letters, Greek,
/// Cyrillic and emoji come back exactly as they went in.
///
/// # Raises
/// Nothing.
///
/// # Examples
/// `Upper Raises The ASCII Letters And Leaves The Rest`
extension function Upper (S : String) : String;
begin
    Exit ToUpper (S);
end

/// S with its ASCII uppercase letters lowered, and every other character left
/// alone.
///
/// The core's `ToLower` [RT-025] with the extension spelling, on the same
/// terms as `Upper`.
///
/// # Raises
/// Nothing.
///
/// # Examples
/// `Lower Lowers The ASCII Letters And Leaves The Rest`
extension function Lower (S : String) : String;
begin
    Exit ToLower (S);
end

// ------------------------------------------------------------------- building

/// S written Times over, end to end.
///
/// A count of zero answers the empty string, which is what makes the routine
/// usable in a loop whose width may come to nothing. A negative count raises
/// rather than answering empty, there being no reading of it that was
/// intended.
///
/// A one-character literal is a Char and not a String, and a Char is accepted
/// here: `Repeat ('-', 40)` is the call this routine exists for, and
/// `Repeat ('ab', 3)` works the same way.
///
/// # Raises
/// `Repeat needs a count of zero or more.` for a negative count.
///
/// # Examples
/// `Repeat Writes Its Argument The Given Number Of Times`
extension function Repeat (S : String, Times : Integer) : String;
begin
    if Times < 0 then raise 'Repeat needs a count of zero or more.';

    var Out := Buffer ();

    for var I := 0; I < Times; I := I + 1 do Out.Append (S);

    Exit Out.Text;
end

// ------------------------------------------------------- splitting and joining

/// The pieces of S between occurrences of By, as a List of String.
///
/// Every piece is kept, the empty ones included: a separator at either end
/// leaves an empty piece there, and two separators together leave one between
/// them. That is what makes the routine reversible -- `Join (Split (S, By),
/// By)` is `S` for every S and every By -- and dropping the empties would be a
/// different routine wearing the same name.
///
/// A separator that does not occur answers a List of one piece, S itself, so a
/// caller need not ask first. An empty separator raises: there is no sequence
/// of pieces that would mean it.
///
/// # Raises
/// `Split needs a separator.` for an empty separator.
///
/// # Examples
/// `Split Answers The Pieces Between The Separators`
extension function Split (S : String, By : String) : List;
begin
    if Length (By) = 0 then raise 'Split needs a separator.';

    var Parts := List ();
    var From  := 0;
    var At    := Pos (S, By, 0);

    // One pass over S, because `Pos` takes a start index. An earlier version
    // re-sliced the remainder with `Copy` on every occurrence, which was
    // quadratic in the length and allocated a string per separator.
    while At >= 0 do
    begin
        Parts.Add (Copy (S, From, At - From));

        From := At + Length (By);
        At   := Pos (S, By, From);
    end

    Parts.Add (Copy (S, From, Length (S)));

    Exit Parts;
end

/// The members of L written one after another with By between them.
///
/// The receiver is a List rather than a String, this being the one routine
/// here that answers text instead of taking it. Members go through `Str`, so a
/// List of Integers joins as readily as a List of String and a class with a
/// `ToString` joins as that.
///
/// An empty List answers the empty string and a List of one answers that
/// member alone, in both cases without consulting By. An empty By is
/// legitimate and concatenates.
///
/// # Raises
/// Nothing.
///
/// # Examples
/// `Join Writes The Members With The Separator Between Them`
extension function Join (L : List, By : String) : String;
begin
    var Out := Buffer ();

    for var I := 0; I < L.Length; I := I + 1 do
    begin
        if I > 0 then Out.Append (By);

        Out.Append (Str (L[I]));
    end

    Exit Out.Text;
end

// ------------------------------------------------------------------- editing

/// S with Count characters removed, starting at index From.
///
/// Total over every index a caller might compute: a From at or past the end
/// answers S unchanged, and a Count running past the end removes what there
/// is. That totality is the reason the routine exists, because the obvious
/// composition is not total -- `Copy (S, 0, From) + Copy (S, From + Count,
/// Length (S))` raises whenever `From + Count` exceeds the length, `Copy`
/// clamping an over-long count but refusing a start past the end.
///
/// A negative From or Count raises rather than counting back from the end.
/// No routine in this library reads a negative index that way, and inventing
/// the convention here would make this the one place it held.
///
/// # Raises
/// `Delete needs a start of zero or more.` for a negative From, and
/// `Delete needs a count of zero or more.` for a negative Count.
///
/// # Examples
/// `Delete Removes The Characters At The Given Index`
extension function Delete (S : String, From : Integer, Count : Integer) : String;
begin
    if From < 0 then raise 'Delete needs a start of zero or more.';
    if Count < 0 then raise 'Delete needs a count of zero or more.';

    var Len := Length (S);

    if From >= Len then Exit S;

    var After := From + Count;

    if After > Len then After := Len;

    Exit Copy (S, 0, From) + Copy (S, After, Len - After);
end

/// S with What inserted so that it begins at index At.
///
/// The string inserted *into* comes first, where Turbo Pascal's `Insert` put
/// the inserted text first. An extension's receiver is its first parameter, so
/// this order is what makes `S.Insert (' and ', 4)` readable; an order that
/// could not be called as a method would have been the odder choice.
///
/// An At of zero prepends and an At at or past the end appends, so the routine
/// is total over every index as `Delete` is. Inserting the empty string
/// answers S unchanged.
///
/// # Raises
/// `Insert needs a position of zero or more.` for a negative At.
///
/// # Examples
/// `Insert Places Its Argument At The Given Index`
extension function Insert (S : String, What : String, At : Integer) : String;
begin
    if At < 0 then raise 'Insert needs a position of zero or more.';

    var Len   := Length (S);
    var Where := At;

    if Where > Len then Where := Len;

    Exit Copy (S, 0, Where) + What + Copy (S, Where, Len - Where);
end

/// S with every occurrence of What replaced by With.
///
/// Every occurrence rather than the first, which is the commoner need and the
/// one that cannot be had from the core in a line. Replacing only the first is
/// `Pos` followed by `Delete` and `Insert`.
///
/// The scan never re-reads what it has just written, so a replacement
/// containing the thing it replaces terminates: `Replace ('aa', 'a', 'aa')`
/// answers `aaaa` rather than running forever.
///
/// An empty What raises, for the same reason `Split`'s does -- there is no
/// sequence of replacements that would mean it. An empty With is legitimate
/// and removes every occurrence.
///
/// # Raises
/// `Replace needs something to look for.` for an empty What.
///
/// # Examples
/// `Replace Changes Every Occurrence`
extension function Replace (S : String, What : String, With : String) : String;
begin
    if Length (What) = 0 then raise 'Replace needs something to look for.';

    var Out  := Buffer ();
    var From := 0;
    var At   := Pos (S, What, 0);

    // One pass over S, on the same grounds as `Split`. Scanning the original
    // rather than the output is also what keeps the routine terminating: the
    // replacement is never looked at again, so one containing the thing it
    // replaces cannot loop.
    while At >= 0 do
    begin
        Out.Append (Copy (S, From, At - From));
        Out.Append (With);

        From := At + Length (What);
        At   := Pos (S, What, From);
    end

    Out.Append (Copy (S, From, Length (S)));

    Exit Out.Text;
end

// ---------------------------------------------------------------------- tests

test 'Trim Removes Whitespace From Either End';
begin
    AssertEqual ('abc', Trim ('   abc   '));
    AssertEqual ('abc', Trim ('abc'));
    AssertEqual ('a b', Trim ('  a b  '));
end

/// All six whitespace characters, and no seventh.
test 'Trim Removes Space And The Five Control Characters Above It';
begin
    AssertEqual (Str ('x'), Trim (' x '));
    AssertEqual (Str ('x'), Trim (#9 + 'x' + #9));
    AssertEqual (Str ('x'), Trim (#10 + 'x' + #10));
    AssertEqual (Str ('x'), Trim (#11 + 'x' + #11));
    AssertEqual (Str ('x'), Trim (#12 + 'x' + #12));
    AssertEqual (Str ('x'), Trim (#13 + 'x' + #13));

    // Not whitespace: the one below tab, and the one above space.
    AssertEqual (#8 + 'x' + #8, Trim (#8 + 'x' + #8));
    AssertEqual ('!x!', Trim ('!x!'));
end

/// A string with nothing left after trimming, which is where an index-based
/// scan would run off the end if `and` did not short-circuit.
test 'Trim Answers Empty For A String Of Only Whitespace';
begin
    AssertEqual ('', Trim ('     '));
    AssertEqual ('', Trim (''));
    AssertEqual ('', Trim (#9 + #10 + #13));
end

test 'Trim Leaves Whitespace In The Middle Alone';
begin
    AssertEqual ('a  b', Trim ('  a  b  '));
    AssertEqual ('a' + #10 + 'b', Trim (' a' + #10 + 'b '));
end

/// The method spelling, which is the permission the unit is written for and
/// is not tested by the calls above.
test 'Trim Answers The Same Either Spelling';
begin
    AssertEqual (Trim ('  x  '), '  x  '.Trim ());
    AssertEqual (Str ('x'), '  x  '.Trim ());
end

test 'Upper Raises The ASCII Letters And Leaves The Rest';
begin
    AssertEqual ('ABC', Upper ('abc'));
    AssertEqual ('ABC', Upper ('ABC'));
    AssertEqual ('A1B!C', Upper ('a1b!c'));
    AssertEqual ('', Upper (''));
end

test 'Lower Lowers The ASCII Letters And Leaves The Rest';
begin
    AssertEqual ('abc', Lower ('ABC'));
    AssertEqual ('abc', Lower ('abc'));
    AssertEqual ('a1b!c', Lower ('A1B!C'));
    AssertEqual ('', Lower (''));
end

/// The boundaries of the two ranges, which an off-by-one would cross into
/// punctuation: `@` is just below `A` and `[` just above `Z`.
test 'Upper And Lower Touch Only The Letters';
begin
    AssertEqual ('@ABCXYZ[', Upper ('@abcxyz['));
    AssertEqual ('`abcxyz{', Lower ('`ABCXYZ{'));

    AssertEqual ('0123456789', Upper ('0123456789'));
    AssertEqual ('0123456789', Lower ('0123456789'));
end

/// The documented limitation, asserted rather than merely described: a
/// non-ASCII letter comes back exactly as it went in.
test 'Upper And Lower Leave Characters Above ASCII Unchanged';
begin
    AssertEqual (Str ('é'), Upper ('é'));
    AssertEqual (Str ('É'), Lower ('É'));
    AssertEqual (Str ('ß'), Upper ('ß'));
    AssertEqual ('Ελληνικά', Upper ('Ελληνικά'));
    AssertEqual ('CAFé', Upper ('café'));
end

/// The two are the core's own routines with the extension spelling added, so
/// they must not drift from it. Asserted rather than assumed, because an
/// earlier version of this unit reimplemented them and nobody noticed.
test 'Upper And Lower Are The Core Routines With A Method Spelling';
begin
    AssertEqual (ToUpper ('mixed CASE 123'), Upper ('mixed CASE 123'));
    AssertEqual (ToLower ('MIXED case 123'), Lower ('MIXED case 123'));

    // Including above ASCII, where both leave the text alone.
    AssertEqual (ToUpper ('café Ελληνικά'), Upper ('café Ελληνικά'));
    AssertEqual (ToLower ('CAFÉ ΕΛΛΗΝΙΚΆ'), Lower ('CAFÉ ΕΛΛΗΝΙΚΆ'));
end

test 'Upper And Lower Answer The Same Either Spelling';
begin
    AssertEqual (Upper ('abc'), 'abc'.Upper ());
    AssertEqual (Lower ('ABC'), 'ABC'.Lower ());
    AssertEqual ('ABC', 'abc'.Upper ());
    AssertEqual ('abc', 'ABC'.Lower ());
end

/// The chain is what extension functions were asked for.
test 'Upper And Trim Compose In The Order They Are Written';
begin
    AssertEqual ('ABC', '  abc  '.Trim ().Upper ());
    AssertEqual ('  ABC  ', '  abc  '.Upper ());
end

test 'Repeat Writes Its Argument The Given Number Of Times';
begin
    AssertEqual ('ababab', Repeat ('ab', 3));
    AssertEqual ('ab', Repeat ('ab', 1));
    AssertEqual ('-----', Repeat ('-', 5));
end

/// The call the routine exists for: a Char where a String is declared, which
/// the language accepts.
test 'Repeat Takes A One Character Literal As Readily As A String';
begin
    AssertEqual (Repeat ('-', 4), '----');
    AssertEqual (40, Length (Repeat ('=', 40)));
end

test 'Repeat Of Zero Answers The Empty String';
begin
    AssertEqual ('', Repeat ('ab', 0));
    AssertEqual ('', Repeat ('', 9));
    AssertEqual ('', Repeat ('', 0));
end

test 'Repeat Refuses A Negative Count';
begin
    var Raised := False;

    try Repeat ('x', -1); except Raised := True; end

    AssertTrue (Raised);
end

test 'Repeat Answers The Same Either Spelling';
begin
    AssertEqual (Repeat ('ab', 2), 'ab'.Repeat (2));
    AssertEqual ('abab', 'ab'.Repeat (2));
end

test 'Split Answers The Pieces Between The Separators';
begin
    var Parts := Split ('a,b,c', ',');

    AssertEqual (3, Parts.Length);
    AssertEqual (Str ('a'), Str (Parts[0]));
    AssertEqual (Str ('b'), Str (Parts[1]));
    AssertEqual (Str ('c'), Str (Parts[2]));
end

/// A separator of more than one character, which the scan has to step over
/// whole rather than one character at a time.
test 'Split Takes A Separator Of Any Length';
begin
    var Parts := Split ('a::b::c', '::');

    AssertEqual (3, Parts.Length);
    AssertEqual (Str ('a'), Str (Parts[0]));
    AssertEqual (Str ('c'), Str (Parts[2]));
end

/// Every piece is kept, which is what makes Split and Join inverses.
test 'Split Keeps The Empty Pieces';
begin
    var Ends := Split (',a,', ',');

    AssertEqual (3, Ends.Length);
    AssertEqual ('', Str (Ends[0]));
    AssertEqual (Str ('a'), Str (Ends[1]));
    AssertEqual ('', Str (Ends[2]));

    var Together := Split ('a,,b', ',');

    AssertEqual (3, Together.Length);
    AssertEqual ('', Str (Together[1]));
end

test 'Split Answers One Piece When The Separator Is Absent';
begin
    var Whole := Split ('abc', ',');

    AssertEqual (1, Whole.Length);
    AssertEqual ('abc', Str (Whole[0]));

    var Nothing := Split ('', ',');

    AssertEqual (1, Nothing.Length);
    AssertEqual ('', Str (Nothing[0]));
end

test 'Split Refuses An Empty Separator';
begin
    var Raised := False;

    try Split ('abc', ''); except Raised := True; end

    AssertTrue (Raised);
end

test 'Split Answers The Same Either Spelling';
begin
    var Parts := 'a,b'.Split (',');

    AssertEqual (2, Parts.Length);
    AssertEqual (Str ('a'), Str (Parts[0]));
    AssertEqual (Str ('b'), Str (Parts[1]));
end

test 'Join Writes The Members With The Separator Between Them';
begin
    var L := List ();

    L.Add ('a');
    L.Add ('b');
    L.Add ('c');

    AssertEqual ('a-b-c', Join (L, '-'));
    AssertEqual ('abc', Join (L, ''));
end

/// Members go through `Str`, so the List need not hold text.
test 'Join Takes A List Of Anything';
begin
    var Numbers := List ();

    Numbers.Add (1);
    Numbers.Add (2);
    Numbers.Add (3);

    AssertEqual ('1, 2, 3', Join (Numbers, ', '));
end

test 'Join Of An Empty Or Single List Never Consults The Separator';
begin
    var Empty := List ();

    AssertEqual ('', Join (Empty, '-'));

    var One := List ();

    One.Add ('only');

    AssertEqual ('only', Join (One, '-'));
end

test 'Join Answers The Same Either Spelling';
begin
    var L := List ();

    L.Add ('a');
    L.Add ('b');

    AssertEqual (Join (L, '+'), L.Join ('+'));
    AssertEqual ('a+b', L.Join ('+'));
end

/// The property the two routines are written to have: every string survives a
/// round trip, whatever the separator does or does not do to it.
test 'Join Undoes Split For Any String And Separator';
begin
    AssertEqual ('a,b,c', 'a,b,c'.Split (',').Join (','));
    AssertEqual (',a,', ',a,'.Split (',').Join (','));
    AssertEqual ('a,,b', 'a,,b'.Split (',').Join (','));
    AssertEqual ('abc', 'abc'.Split (',').Join (','));
    AssertEqual ('', ''.Split (',').Join (','));
    AssertEqual ('a::b', 'a::b'.Split ('::').Join ('::'));
end

test 'Delete Removes The Characters At The Given Index';
begin
    AssertEqual ('abef', Delete ('abcdef', 2, 2));
    AssertEqual ('def', Delete ('abcdef', 0, 3));
    AssertEqual ('abcd', Delete ('abcdef', 4, 2));
    AssertEqual ('', Delete ('abcdef', 0, 6));
end

/// The totality the routine exists for: the composition it replaces raises on
/// each of these, Copy refusing a start past the end.
test 'Delete Is Total Over Any Index Past The End';
begin
    AssertEqual ('ab', Delete ('abcdef', 2, 99));
    AssertEqual ('abcdef', Delete ('abcdef', 6, 2));
    AssertEqual ('abcdef', Delete ('abcdef', 99, 2));
    AssertEqual ('', Delete ('', 0, 3));
    AssertEqual ('', Delete ('', 9, 3));
end

test 'Delete Of Nothing Answers Its Argument Unchanged';
begin
    AssertEqual ('abcdef', Delete ('abcdef', 2, 0));
    AssertEqual ('abcdef', Delete ('abcdef', 0, 0));
end

test 'Delete Refuses A Negative Start Or Count';
begin
    var Raised := False;

    try Delete ('abcdef', 0 - 1, 2); except Raised := True; end
    AssertTrue (Raised);

    Raised := False;
    try Delete ('abcdef', 2, 0 - 1); except Raised := True; end
    AssertTrue (Raised);
end

test 'Delete Answers The Same Either Spelling';
begin
    AssertEqual (Delete ('abcdef', 2, 2), 'abcdef'.Delete (2, 2));
    AssertEqual ('abef', 'abcdef'.Delete (2, 2));
end

test 'Insert Places Its Argument At The Given Index';
begin
    AssertEqual ('abXYcdef', Insert ('abcdef', 'XY', 2));
    AssertEqual ('XYabcdef', Insert ('abcdef', 'XY', 0));
    AssertEqual ('abcdefXY', Insert ('abcdef', 'XY', 6));
end

/// Total in the same way Delete is: a position past the end appends.
test 'Insert At A Position Past The End Appends';
begin
    AssertEqual ('abcdefXY', Insert ('abcdef', 'XY', 99));
    AssertEqual ('XY', Insert ('', 'XY', 0));
    AssertEqual ('XY', Insert ('', 'XY', 99));
end

test 'Insert Of Nothing Answers Its Argument Unchanged';
begin
    AssertEqual ('abcdef', Insert ('abcdef', '', 3));
    AssertEqual ('', Insert ('', '', 0));
end

test 'Insert Refuses A Negative Position';
begin
    var Raised := False;

    try Insert ('abcdef', 'XY', 0 - 1); except Raised := True; end

    AssertTrue (Raised);
end

test 'Insert Answers The Same Either Spelling';
begin
    AssertEqual (Insert ('abcdef', 'XY', 2), 'abcdef'.Insert ('XY', 2));
    AssertEqual ('abXYcdef', 'abcdef'.Insert ('XY', 2));
end

/// Delete and Insert are inverses at the same index.
test 'Insert Undoes Delete At The Same Index';
begin
    AssertEqual ('abcdef', 'abcdef'.Delete (2, 2).Insert ('cd', 2));
    AssertEqual ('abcdef', 'abcdef'.Insert ('XY', 2).Delete (2, 2));
end

test 'Replace Changes Every Occurrence';
begin
    AssertEqual ('a-b-c', Replace ('a,b,c', ',', '-'));
    AssertEqual ('xbxbx', Replace ('ababa', 'a', 'x'));
    AssertEqual ('a::b', Replace ('a,b', ',', '::'));
end

test 'Replace Leaves A String Without The Pattern Alone';
begin
    AssertEqual ('abcdef', Replace ('abcdef', 'zz', 'y'));
    AssertEqual ('', Replace ('', 'a', 'b'));
end

/// An empty replacement is a deletion of every occurrence.
test 'Replace With Nothing Removes Every Occurrence';
begin
    AssertEqual ('abc', Replace ('a,b,c', ',', ''));
    AssertEqual ('', Replace (',,,', ',', ''));
end

/// The scan must not re-read what it wrote, or this would not terminate.
test 'Replace Does Not Rescan Its Own Replacement';
begin
    AssertEqual ('aaaa', Replace ('aa', 'a', 'aa'));
    AssertEqual ('xaxa', Replace ('aa', 'a', 'xa'));
    AssertEqual ('aa', Replace ('a', 'a', 'aa'));
end

test 'Replace Handles Adjacent And Bracketing Occurrences';
begin
    AssertEqual ('xx', Replace (',,', ',', 'x'));
    AssertEqual ('x-x', Replace (',-,', ',', 'x'));
    AssertEqual ('-x-', Replace ('-,-', ',', 'x'));
end

/// A pattern of more than one character, which the scan steps over whole.
test 'Replace Takes A Pattern Of Any Length';
begin
    AssertEqual ('a-b-c', Replace ('a::b::c', '::', '-'));
    AssertEqual ('XY', Replace ('abcd', 'abcd', 'XY'));
end

test 'Replace Refuses An Empty Pattern';
begin
    var Raised := False;

    try Replace ('abc', '', 'x'); except Raised := True; end

    AssertTrue (Raised);
end

test 'Replace Answers The Same Either Spelling';
begin
    AssertEqual (Replace ('a,b', ',', '-'), 'a,b'.Replace (',', '-'));
    AssertEqual ('a-b', 'a,b'.Replace (',', '-'));
end

/// The chain the three were added for.
test 'Delete Insert And Replace Compose With The Rest';
begin
    AssertEqual ('A-B', '  a,b  '.Trim ().Replace (',', '-').Upper ());
    AssertEqual ('[ab]', 'ab'.Insert ('[', 0).Insert (']', 99));
end
